PREFIX tg:  <https://example.org/tourguide#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# R6: MustVisitAttraction - Attractions incontournables
# Combine type Attraction + excellentes notes + popularité

CONSTRUCT {
  ?p rdf:type tg:MustVisitAttraction .
  ?p tg:inferenceReason ?reason .
  ?p tg:inferredRating ?avgRating .
  ?p tg:inferredReviewCount ?count .
}
WHERE {
  ?p rdf:type tg:Attraction .
  
  # Statistiques depuis reviews
  {
    SELECT ?p (AVG(?rating) AS ?avgRating) (COUNT(?review) AS ?count)
    WHERE {
      ?review schema:about ?p ;
              schema:reviewRating ?rating .
    }
    GROUP BY ?p
    HAVING(AVG(?rating) >= 4.3 && COUNT(?review) >= 30)
  }
  
  BIND(CONCAT("MustVisitAttraction: avgRating=", STR(?avgRating), ", reviews=", STR(?count), " (Attraction >=4.3 & >=30 reviews)") AS ?reason)
}
