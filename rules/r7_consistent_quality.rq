PREFIX tg:  <https://example.org/tourguide#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>

# R7: ConsistentQuality - Lieux avec qualité constante
# Analyse la variance des notes (peu de notes basses)

CONSTRUCT {
  ?p rdf:type tg:ConsistentQuality .
  ?p tg:inferenceReason ?reason .
  ?p tg:inferredAvgRating ?avgRating .
  ?p tg:inferredMinRating ?minRating .
}
WHERE {
  ?p rdf:type tg:Place .
  
  # Stats avec note minimale
  {
    SELECT ?p (AVG(?rating) AS ?avgRating) (MIN(?rating) AS ?minRating) (COUNT(?review) AS ?count)
    WHERE {
      ?review schema:about ?p ;
              schema:reviewRating ?rating .
    }
    GROUP BY ?p
    HAVING(AVG(?rating) >= 4.0 && MIN(?rating) >= 3.0 && COUNT(?review) >= 10)
  }
  
  BIND(CONCAT("ConsistentQuality: avgRating=", STR(?avgRating), ", minRating=", STR(?minRating), " (avg>=4.0 & min>=3.0)") AS ?reason)
}
