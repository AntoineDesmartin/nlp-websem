@base <https://example.org/tourguide/mappings/> .
@prefix rr:  <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:  <http://semweb.mmlab.be/ns/ql#> .
@prefix tg:  <https://example.org/tourguide#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#########
# CITY  #
#########

<#CityFromAttractionJson> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "data/subset/places_paris_attraction.subset.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$[*]"
  ] ;
  rr:subjectMap [
    rr:template "https://example.org/tourguide/city/{location}" ;
    rr:class tg:City
  ] ;
  rr:predicateObjectMap [ rr:predicate tg:cityName ; rr:objectMap [ rml:reference "location" ] ] .

<#CityFromRestaurantJson> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "data/subset/places_paris_restaurant.subset.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$[*]"
  ] ;
  rr:subjectMap [
    rr:template "https://example.org/tourguide/city/{location}" ;
    rr:class tg:City
  ] ;
  rr:predicateObjectMap [ rr:predicate tg:cityName ; rr:objectMap [ rml:reference "location" ] ] .

<#CityFromPOIJson> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "data/subset/places_paris_poi.subset.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$[*]"
  ] ;
  rr:subjectMap [
    rr:template "https://example.org/tourguide/city/{location}" ;
    rr:class tg:City
  ] ;
  rr:predicateObjectMap [ rr:predicate tg:cityName ; rr:objectMap [ rml:reference "location" ] ] .

# ---------
# ATTRACTION
# ---------
<#PlacesJsonAttraction> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "data/subset/places_paris_attraction.subset.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$[*]"
  ] ;

  rr:subjectMap [
    rr:template "https://example.org/tourguide/place/{id}" ;
    rr:class tg:Place ;
    rr:class tg:Attraction
  ] ;

  rr:predicateObjectMap [ rr:predicate tg:placeId ; rr:objectMap [ rml:reference "id" ; rr:datatype xsd:integer ] ] ;
  rr:predicateObjectMap [ rr:predicate tg:name ; rr:objectMap [ rml:reference "name" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate tg:address ; rr:objectMap [ rml:reference "address" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate tg:locatedIn ; rr:objectMap [ rr:template "https://example.org/tourguide/city/{location}" ] ] ;
  rr:predicateObjectMap [ rr:predicate tg:lat ; rr:objectMap [ rml:reference "lat" ; rr:datatype xsd:decimal ] ] ;
  rr:predicateObjectMap [ rr:predicate tg:lng ; rr:objectMap [ rml:reference "lng" ; rr:datatype xsd:decimal ] ] ;
  rr:predicateObjectMap [ rr:predicate tg:numReviews ; rr:objectMap [ rml:reference "numReviews" ; rr:datatype xsd:integer ] ] ;
  rr:predicateObjectMap [ rr:predicate tg:polarity ; rr:objectMap [ rml:reference "polarity" ; rr:datatype xsd:decimal ] ] ;
  rr:predicateObjectMap [ rr:predicate tg:hasTopic ; rr:objectMap [ rr:constant tg:Culture ] ] ;
  rr:predicateObjectMap [ rr:predicate tg:website ; rr:objectMap [ rml:reference "details" ; rr:datatype xsd:anyURI ] ] ;
  rr:predicateObjectMap [ rr:predicate rdfs:seeAlso ; rr:objectMap [ rml:reference "details" ; rr:datatype xsd:anyURI ] ] ;
  rr:predicateObjectMap [ rr:predicate rdfs:seeAlso ; rr:objectMap [ rml:reference "reviews" ; rr:datatype xsd:anyURI ] ] .

# ---------
# RESTAURANT
# ---------
<#PlacesJsonRestaurant> a rr:TriplesMap ;
  rml:logicalSource [
    rml:source "data/subset/places_paris_restaurant.subset.json" ;
    rml:referenceFormulation ql:JSONPath ;
    rml:iterator "$[*]"
  ] ;

  rr:subjectMap [
    rr:template "https://example.org/tourguide/place/{id}" ;
    rr:class tg:Place ;
    rr:class tg:Restaurant
  ] ;

  rr:predicateObjectMap [ rr:predicate tg:placeId ; rr:objectMap [ rml:reference "id" ; rr:datatype xsd:integer ] ] ;
  rr:predicateObjectMap [ rr:predicate tg:name ; rr:objectMap [ rml:reference "name" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate tg:address ; rr:objectMap [ rml:reference "address" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate tg:locatedIn ; rr:objectMap [ rr:template "https://example.org/tourguide/city/{location}" ] ] ;
  rr:predicateObjectMap [ rr:predicate tg:lat ; rr:objectMap [ rml:reference "lat" ; rr:datatype xsd:decimal ] ] ;
  rr:predicateObjectMap [ rr:predicate tg:lng ; rr:objectMap [ rml:reference "lng" ; rr:datatype xsd:decimal ] ] ;
  rr:predicateObjectMap [ rr:predicate tg:numReviews ; rr:objectMap [ rml:reference "numReviews" ; rr:datatype xsd:integer ] ] ;
  rr:predicateObjectMap [ rr:predicate tg:polarity ; rr:objectMap [ rml:reference "polarity" ; rr:datatype xsd:decimal ] ] ;
  rr:predicateObjectMap [ rr:predicate tg:hasTopic ; rr:objectMap [ rr:constant tg:Food ] ] ;
  rr:predicateObjectMap [ rr:predicate tg:cuisineType ; rr:objectMap [ rml:reference "subCategory" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate tg:website ; rr:objectMap [ rml:reference "details" ; rr:datatype xsd:anyURI ] ] ;
  rr:predicateObjectMap [ rr:predicate rdfs:seeAlso ; rr:objectMap [ rml:reference "details" ; rr:datatype xsd:anyURI ] ] ;
  rr:predicateObjectMap [ rr:predicate rdfs:seeAlso ; rr:objectMap [ rml:reference "reviews" ; rr:datatype xsd:anyURI ] ] .

