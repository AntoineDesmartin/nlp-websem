PREFIX tg: <https://example.org/tourguide#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Q16: Requête fédérée - Enrichissement des lieux avec Wikidata
# Récupère les labels français depuis Wikidata pour nos lieux alignés
SELECT ?place ?name ?lat ?lng ?wd ?wdLabel ?instanceOfLabel
WHERE {
  # Nos données locales
  ?place a tg:Place ;
         tg:name ?name ;
         tg:lat ?lat ;
         tg:lng ?lng ;
         owl:sameAs ?wd .
  
  FILTER(CONTAINS(STR(?wd), "wikidata.org/entity/Q"))

  # Requête fédérée vers Wikidata
  SERVICE <https://query.wikidata.org/sparql> {
    ?wd rdfs:label ?wdLabel .
    FILTER(LANG(?wdLabel) = "fr")

    # Type/instance de l'entité
    OPTIONAL {
      ?wd <http://www.wikidata.org/prop/direct/P31> ?instanceOf .
      ?instanceOf rdfs:label ?instanceOfLabel .
      FILTER(LANG(?instanceOfLabel) = "fr")
    }
  }
}
LIMIT 15
