# Top 20 des lieux les plus mentionnés dans les reviews
# Utilise les extractions NER (schema:mentions)

PREFIX schema: <http://schema.org/>
PREFIX tg: <https://example.org/tourguide#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?placeName (COUNT(?review) as ?mentions) ?category
WHERE {
  ?review a schema:Review ;
          schema:mentions ?place .
  
  ?place tg:name ?placeName .
  
  OPTIONAL {
    ?place a ?type .
    FILTER(?type IN (tg:Restaurant, tg:Attraction, tg:POI))
    BIND(STRAFTER(STR(?type), "#") AS ?category)
  }
}
GROUP BY ?placeName ?category
ORDER BY DESC(?mentions)
LIMIT 20
