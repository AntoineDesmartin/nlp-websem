PREFIX tg: <https://example.org/tourguide#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>

SELECT ?place ?name ?sameAs
WHERE {
  ?place a tg:Place ;
         tg:name ?name ;
         owl:sameAs ?sameAs .
  FILTER(CONTAINS(STR(?sameAs), "wikidata.org") || CONTAINS(STR(?sameAs), "dbpedia.org"))
}
LIMIT 50
