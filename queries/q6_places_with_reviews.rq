PREFIX tg: <https://example.org/tourguide#>
PREFIX schema: <http://schema.org/>
PREFIX place: <http://tour-guide.org/resource/place/>

# Q6: Places avec leurs reviews - Comptage et analyse
SELECT ?placeURI ?placeName ?placeType (COUNT(?review) AS ?reviewCount)
WHERE {
  ?placeURI a tg:Place ;
            tg:name ?placeName ;
            a ?placeType .
  
  ?review a schema:Review ;
          schema:about ?placeURI .
  
  FILTER(?placeType IN (tg:Attraction, tg:Restaurant, tg:POI))
}
GROUP BY ?placeURI ?placeName ?placeType
ORDER BY DESC(?reviewCount)
LIMIT 50
