2026-01-14 11:18:11 INFO  webservice.SPARQLResult.getResultFormat:96 [] - Query: PREFIX tg:  <https://example.org/tourguide#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX dbo: <http://dbpedia.org/ontology/>
PREFIX rdfs:<http://www.w3.org/2000/01/rdf-schema#>

SELECT ?place ?name ?polarity ?abstract WHERE {
  ?place a tg:Place ;
         tg:name ?name ;
         tg:polarity ?polarity ;
         owl:sameAs ?dbp .

  FILTER(STRSTARTS(STR(?dbp), "http://dbpedia.org/resource/"))

  SERVICE <https://dbpedia.org/sparql> {
    OPTIONAL {
      ?dbp dbo:abstract ?abstract .
      FILTER(lang(?abstract)="fr" || lang(?abstract)="en")
    }
  }
}
ORDER BY DESC(?polarity)
LIMIT 10
