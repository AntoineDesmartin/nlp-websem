    schema1:reviewBody "Água com forte cheiro de cloro, mas nao é o primeiro hotel em Paris com esse problema. Muito bem localizado! Quarto e estrutura padrão Ibis, só o banheiro que é bem pequeno. Eu indico!" .

review:84818_r12 a schema1:Review ;
    schema1:about place:84818 ;
    schema1:author "Anonymous" ;
