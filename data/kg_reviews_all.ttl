review:83523_r172 a schema1:Review ;
    schema1:about place:83523 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "Take the multi pass : many museums & no line ups which can be crazy like at the Louvres...also, visit for the afternoon & finish at the rooftop to enjoy a fantastic view of Paris in the sunset. Voilà!" .

review:83523_r173 a schema1:Review ;
