review:91333_r5 a schema1:Review ;
    schema1:about place:91333 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "Nous attendions depuis 20 minutes, lorsque j'ai essayé de commander, le barman m'a dit: \"Tu louches ou quoi? tu vois pas que je parle aux filles derrière ?\". Je ne peux que déconseiller cet endroit!" .

review:91333_r6 a schema1:Review ;
