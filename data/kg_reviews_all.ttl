review:86178_r19 a schema1:Review ;
    schema1:about place:86178 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "Gran variedad de cervezas tradicionales. Estupendo ambiente. Servicio muy bueno, grandes conocedores de la cultura de la cerveza. Muy recomendable!!" .

review:86178_r2 a schema1:Review ;
    schema1:about place:86178 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "De très bonnes bières (20 à ce jour), toutes Françaises et quelques Écossaises. Les barmen,passionnés, sont toujours là pour vous conseiller et vous faire découvrir l'histoire de chacune d'elle." .

review:86178_r20 a schema1:Review ;
    schema1:about place:86178 ;
