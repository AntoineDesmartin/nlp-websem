review:91341_r11 a schema1:Review ;
    schema1:about place:91341 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "Beaucoup de monde donc très sympa le samedi soir seul bémol pas beaucoup de musique et ferme plutôt tôt. 4€ le Ricard et 9€ hard (cher car sans le goût de l'alcool)" .

review:91341_r12 a schema1:Review ;
    schema1:about place:91341 ;
