    schema1:about place:86178 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "*** : Le seul bar à bières de Paris. Laissez-vous guider par un des serveurs pour choisir parmi plusieurs dizaines de bières. Pas de terrasse mais ouvert sur l'extérieur. Musique sympa. Planches." .

review:86178_r16 a schema1:Review ;
