    schema1:about place:90192 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "Tout le charme du bar clandestin : façade opaque, portes dérobées et éclairage minimaliste. La carte des bières réservent de très bonnes surprises et les hot-dog valent à eux seuls le détour. Top !" .

review:90192_r5 a schema1:Review ;
