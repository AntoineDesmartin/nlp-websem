    schema1:about place:83523 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "Restaurant Georges is a perfect stop off after an afternoon of taking in the art at the Centre Pompidou downstairs. We love lounging on the terrace with a cocktail while we scope the city views." .

review:83523_r52 a schema1:Review ;
    schema1:about place:83523 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "Parisians love to hate the painfully modern architecture of the Centre Pompidou, so the building is worth seeing just to get a feel for the design which has sparked so much local controversy." .

review:83523_r53 a schema1:Review ;
