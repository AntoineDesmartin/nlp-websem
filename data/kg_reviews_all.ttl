review:83481_r111 a schema1:Review ;
    schema1:about place:83481 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "The Arc de Triomphe was commissioned by Napoleon in 1806, but he never got to see the finished product. It was completed 15 years after his death." .

