    schema1:author "Anonymous" ;
    schema1:reviewBody "Expo Roy Lichtenstein : Entrée possible à partir de 10h00 pour les porteurs de billets et de la carte du Musée, les samedi et dimanche. Pas mal quand on sait que l'ouverture officielle est à 11h00!" .

review:83523_r175 a schema1:Review ;
    schema1:about place:83523 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "La prima domenica del mese ingresso libero come tutti i musei a Parigi! Uno dei migliori musei di arte contemporanea al mondo! Da non perdere." .

review:83523_r176 a schema1:Review ;
    schema1:about place:83523 ;
