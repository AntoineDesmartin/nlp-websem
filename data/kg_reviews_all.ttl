    schema1:reviewBody "Invisible for non-initiated, the Moonshiner is a specialist of the whisky with 83 references,  you can drink a really good cocktail, listening jazzy music in the twilight of a decoration of 1900." .

review:91333_r1 a schema1:Review ;
    schema1:about place:91333 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "L'adresse est secrète .... le bar est dissimulé dans un endroit totalement improbable !!! (que je dévoile à qui veut ;) L'expérience étonnante. Des cocktails classiques et moins classiques." .

review:91333_r10 a schema1:Review ;
    schema1:about place:91333 ;
