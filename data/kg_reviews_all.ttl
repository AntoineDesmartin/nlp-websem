review:85310_r10 a schema1:Review ;
    schema1:about place:85310 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "Une dépose minute gratuite d’une durée de 15 minutes est à votre disposition au parking Effia Cour Muséum." .

review:85310_r11 a schema1:Review ;
    schema1:about place:85310 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "Le service \"objets trouvés\" de la gare de Paris-Austerlitz est ouvert du lundi au vendredi de 12:00 à 15:30 et de 16:00 à 19:30. Vous pouves les joindre par e-mail objetstrouves.paz@challancin.fr" .

review:85310_r12 a schema1:Review ;
    schema1:about place:85310 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "Consignes disponibles tous les jours, de 7h à 23h30. 3 tarifs sont proposés, suivant la taille du casier (5,5 / 7,5 / 9,5€ pour 24h - 5€ par 24h supplémentaires). RDV dans la cour Muséum, porte 27." .

review:85310_r13 a schema1:Review ;
    schema1:about place:85310 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "Wifi disponible dans cette gare." .

review:85310_r14 a schema1:Review ;
    schema1:about place:85310 ;
    schema1:author "Anonymous" ;
