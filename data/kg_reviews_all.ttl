    schema1:reviewBody "J'aime : le poulet & ses légumes rotis, et aussi la salade de fruits : yummy!" .

review:83256_r16 a schema1:Review ;
    schema1:about place:83256 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "Aussi magique que le nom qu'il porte le bar de cet hôtel et sa terrasse sont tout simplement majestueux les nuits d'étés" .

review:83256_r17 a schema1:Review ;
    schema1:about place:83256 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "Ils sont desagréable et se la pétent grave. Les chambres sont sweet. C'est vrai..." .

review:83256_r18 a schema1:Review ;
    schema1:about place:83256 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "Best french toasts in town... Great terrasse for brunchs. Staff is nice, prices are reasonnable" .

review:83256_r19 a schema1:Review ;
    schema1:about place:83256 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "Accueil & service à revoir... Dommage car le cadre est sympa !" .

review:83256_r2 a schema1:Review ;
    schema1:about place:83256 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "Je vais vous raconter l’histoire de ce malade qui s’est pointé un soir dans ma chambre d’hôtel. Un putain d'énergumène." .

review:83256_r20 a schema1:Review ;
    schema1:about place:83256 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "Si les serveuses etaient aussi sympa que le lieu est beau, ce serait parfait! Malheureusement, elles gachent tout!" .

review:83256_r21 a schema1:Review ;
    schema1:about place:83256 ;
