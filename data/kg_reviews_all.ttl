    schema1:author "Anonymous" ;
    schema1:reviewBody "Ambiance 1900 topissime mais cocktail vraiment pas au niveau. Prenez plutôt les whiskys. I ll be back" .

review:91333_r12 a schema1:Review ;
    schema1:about place:91333 ;
