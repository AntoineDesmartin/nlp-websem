review:83481_r106 a schema1:Review ;
    schema1:about place:83481 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "The Arc de Triomphe de l'Étoile is one of the most famous monuments in Paris. It stands in the centre of the Place Charles de Gaulle, at the western end of the Champs-Élysées" .

