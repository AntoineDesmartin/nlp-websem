review:84957_r19 a schema1:Review ;
    schema1:about place:84957 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "Une station de taxi est accessible depuis les voies M et N. Descendez les escaliers et dirigez vous vers la sortie \"rue de Bercy\" (à côté de la consigne)." .

review:84957_r2 a schema1:Review ;
    schema1:about place:84957 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "The railway station of the Sun. Paris-Marseille in 3hours, nice!!" .

review:84957_r20 a schema1:Review ;
    schema1:about place:84957 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "Consignes disponibles, ouvertes 7J / 7, de 6h15 à 22h. Trois tarifs sont proposés, suivant la taille du casier (5,5 / 7,5 / 9,5€ pour 24h - 5€ par 24h supplémentaires). RDV Hall 3, sous la voie N." .

review:84957_r21 a schema1:Review ;
    schema1:about place:84957 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "Un objet trouvé, un objet perdu ? Notre service \"objets trouvés\", situé dans le Hall 3, sortie rue de Bercy dans l'espace \"consignes\" est également disponible par e-mail pgl.acds@itiremia.fr" .

review:84957_r22 a schema1:Review ;
