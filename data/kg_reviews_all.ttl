review:84071_r0 a schema1:Review ;
    schema1:about place:84071 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "Once the most fashionable church in 19th-century Paris, the Neo-Gothic Basilique Ste-Clotilde is best known for its imposing twin spires." .

review:84071_r1 a schema1:Review ;
    schema1:about place:84071 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "Construction of the church was first mooted by the Paris City Council in February 16, 1827. It was designed by architect F. C. Gau of Cologne in a neo-Gothic style. Work began in 1846, opened in 1857" .

