review:83256_r55 a schema1:Review ;
    schema1:about place:83256 ;
    schema1:author "Anonymous" ;
    schema1:reviewBody "C'est bon et on s'y sent bien. Surtout dans les arbres dehors. Prevoyez d'y aller en debut de mois car l'addition monte vite. 😉 Par contre c'est assez bruyant et les serveuses sont un peu speed." .

review:83256_r56 a schema1:Review ;
    schema1:about place:83256 ;
