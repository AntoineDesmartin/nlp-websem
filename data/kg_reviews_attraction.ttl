review:83465_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Place Vendôme is a lovely, petite counterpoint to the spacious shopping boulevards around the Champs-Élysées. We dig the combination of atmospheric surrounds and a great range of designer boutiques." ;
    schema:about place:83465 .

review:83465_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Une des places de Paris les plus célèbres et considérée comme l'une des plus luxueuses du monde. La plupart des façades est classée monument historique. En son centre, se trouve la colonne Vendôme." ;
    schema:about place:83465 .

review:83465_r9 a schema:Review ;
