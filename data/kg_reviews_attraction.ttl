review:83615_r15 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Aqui se encontram o \"Thermes de Cluny\", as ruínas dos banhos galo-romanos, e as cabeças dos reis de Judas, da igreja Notre Dame de Paris, decapitadas durante a Revolução Francesa." ;
