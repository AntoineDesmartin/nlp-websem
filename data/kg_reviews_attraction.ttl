review:83973_r14 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le pire coin de Paris.. Une rue improbable, un accueil déplorable, un service absent.. Entre la misère du bon goût  et le repère de pseudo-bobo ... A éviter" ;
    schema:about place:83973 .

review:83973_r15 a schema:Review ;
    schema:author "Anonymous" ;
