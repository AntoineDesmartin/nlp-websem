review:83256_r29 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "hamburger tres moyen mais superbe sandwich au homard! Aussi les macaronis n cheese meilleurs qu'aux US. Fondant chocolat fleur de sel curieux mais fait bien mal!" ;
