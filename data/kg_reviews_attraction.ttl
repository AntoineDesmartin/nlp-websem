review:91211_r27 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "HighlightSee Paris in all its glory, on the observation deck of a world famous French landmark. Several flights of stairs and lifts give you access up to the third level. Your first stop is the ba" ;
    schema:about place:91211 .

review:91211_r28 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The Eiffel Tower is open every day all year long :- from 9:30am to 11:00pm, January 1 to June 17 and August 29 to December 31.- from 9:00am to midnight, June 18 to August 28." ;
    schema:about place:91211 .

