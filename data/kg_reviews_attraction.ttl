review:83358_r20 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le rdv incontournable des adeptes de vins et des visiteurs du marché d'Aligre. Vin tiré directement du tonneau le tout accompagné de charcuterie ou d'huîtres. Bouteilles remplies à la barrique !" ;
    schema:about place:83358 .

review:83358_r21 a schema:Review ;
