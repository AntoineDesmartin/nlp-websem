    schema:reviewBody "Best show ever!" ;
    schema:about place:83735 .

review:83735_r21 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un concert génial de Steven Wilson. Le son de la salle était formidable. Dommage que nos places ne nous permettaient pas de voir toute la scène (vidéos et musiciens)." ;
    schema:about place:83735 .

review:83735_r22 a schema:Review ;
    schema:author "Anonymous" ;
