review:89181_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le cirque Gruss n'est ici que pendant la saison d'hiver, en gros des vacances de Toussaint à celles de Février et passe la saison d'été dans son domaine de Piolenc. Tout check en été est de la triche" ;
    schema:about place:89181 .

review:89181_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Agréablement surpris par le spectacle. Les chevaux y apportent la magie. Un show très professionnel : lumières, chorégraphie, vrais musiciens, une chanteuse. A voir même sans avoir une culture cirque" ;
    schema:about place:89181 .

review:89181_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "magique le spectacle" ;
    schema:about place:89181 .

review:89181_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Les chevaux, l'éléphant acrobate, l'orchestre et la chanteuse, les artistes...  Un vrai beau moment de magie !" ;
    schema:about place:89181 .

review:89181_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Vous pouvez grignoter avant le spectacle de 20h00 en arrivant vers 19h00/19h30 assis à une table haute : hot dogs et crèpes à l'entrée + pleins de sucreries (à éviter bien sûr !)." ;
    schema:about place:89181 .

