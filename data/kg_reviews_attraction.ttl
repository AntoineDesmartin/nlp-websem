review:84196_r23 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Nouvelle place à découvrir" ;
    schema:about place:84196 .

review:84196_r24 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Nuit Blanche: La sculpture de brume de Fujiko Nakaya se déploie telle une aurore voilée sur la place. De 19h à 7h du matin" ;
    schema:about place:84196 .

review:84196_r25 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "La brume nocturne de la #Nuitblanche 2013" ;
    schema:about place:84196 .

review:84196_r26 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Entièrement rénovée en 2013 qui lui a rendu son éclat, la place actuelle de 3,4 ha date du Second Empire. En son centre trône la statue allégorique de la République : Marianne." ;
    schema:about place:84196 .

review:84196_r27 a schema:Review ;
