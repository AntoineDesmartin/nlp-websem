review:91211_r781 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Book tickets online via the tour Eiffel website to avoid serpentine queues, but you will miss out on climbing the first 2 levels using stairs which is an experience in itself." ;
