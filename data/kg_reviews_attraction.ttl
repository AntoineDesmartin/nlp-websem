review:83256_r51 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "C'est la terrasse branchée du quartier ! L'endroit est tellement agréable qu'on oublie rapidement les serveurs un peu pète-sec" ;
    schema:about place:83256 .

review:83256_r52 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "They have a beautiful outdoor courtyard but be sure to reserve ahead." ;
