review:86178_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Endroit pas encore totalement ouvert mais gros potentiel pour les amateurs de bière." ;
    schema:about place:86178 .

review:86178_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Des bières de qualité à des prix tout à fait raisonnables! Un must." ;
    schema:about place:86178 .

review:86178_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "De très bonnes bières (20 à ce jour), toutes Françaises et quelques Écossaises. Les barmen,passionnés, sont toujours là pour vous conseiller et vous faire découvrir l'histoire de chacune d'elle." ;
    schema:about place:86178 .

review:86178_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Très bel endroit, très bonnes bières! Super bar pour une soirée entre bons amis!" ;
    schema:about place:86178 .

review:86178_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The place for beer enthusiasts in Paris. One of the best beer bars I've ever been to. Great atmosphere and music. Owners, working at the bar, are friendly and opened for beer discussion." ;
    schema:about place:86178 .

review:86178_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "More than 100 bottles and 20 beers on tap (priced 3,5-6€ for 1/2 pint). Tap beers are rotating. Try excellent french craft beers like Dalva or Silvanecte. They open at 5pm and close at 2am." ;
    schema:about place:86178 .

review:86178_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Go for the \"Hardcore IPA\" on tap." ;
    schema:about place:86178 .

review:86178_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Super bar, surtout pour les passionnés de bière. Ambiance sympa également. Je le recommande vivement !!" ;
    schema:about place:86178 .

review:86178_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Big, cozy and with a good soundtrack, you can find 20 rotating beers on tap from all around the world. The french beer Agent Provocateur is outstanding. Nice, and English-speaking, staff." ;
    schema:about place:86178 .

review:86178_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "This is Paris’ only craft beer bar – of its selections: cult-status I.P.A.’s, Trappiste brews and a smoked lager that tastes strangely like bacon. For more, follow us on 4sq or at www.renhotels.com." ;
    schema:about place:86178 .

review:86178_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The beer is gooood! One of the owners also has a beer establishment on rue Quincampoix." ;
    schema:about place:86178 .

review:86178_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Awesome place if you're looking for an original beer rather than the standard Heineken, 1664 or so!" ;
    schema:about place:86178 .

review:86178_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "O melhor que as vinte torneiras o barman fala português..." ;
    schema:about place:86178 .

review:86178_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "BREWDOG! What else can I say?" ;
    schema:about place:86178 .

review:86178_r14 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "La miel biologique Dupont is excellent! And you can buy a 75cl bottle for 12€ instead of 5€ each 25cl draught ;)" ;
    schema:about place:86178 .

review:86178_r15 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "*** : Le seul bar à bières de Paris. Laissez-vous guider par un des serveurs pour choisir parmi plusieurs dizaines de bières. Pas de terrasse mais ouvert sur l'extérieur. Musique sympa. Planches." ;
    schema:about place:86178 .

review:86178_r16 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "La corvée d'Oscar sent bon mais n'est pas terrible en bouche" ;
    schema:about place:86178 .

review:86178_r17 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Très bonne sélection de bière ! Ambiance sympa, à tester :-P" ;
    schema:about place:86178 .

review:86178_r18 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Service très agréable, endroit sympathique et chaleureux. Les bières sont délicieuses." ;
    schema:about place:86178 .

review:86178_r19 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Gran variedad de cervezas tradicionales. Estupendo ambiente. Servicio muy bueno, grandes conocedores de la cultura de la cerveza. Muy recomendable!!" ;
    schema:about place:86178 .

review:86178_r20 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Súper bon bières! Service très sympa :)" ;
    schema:about place:86178 .

