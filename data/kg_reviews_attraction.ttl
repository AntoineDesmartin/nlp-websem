review:90453_r14 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un endroit atypique a la superbe déco. Une ambiance cosy et intimiste et des cocktails décapants. A retenir pour un \"date\" ou une soirée posée entre amis." ;
