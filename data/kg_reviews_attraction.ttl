review:89938_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Supers barmans, ambiance chaleureuse. Dites leur ce que vous aimez :alcool, fruits... et ils vous créeront sur demande le cocktail que vous aimez. Sexy garçons en caleçons, un sans fautes!" ;
    schema:about place:89938 .

review:89938_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "BarChick went for a Surprise Me which means the bartender whips you up a surprise concoction on the spot. BarChick likes surprises. http://barchick.com/find-a-bar/paris/le-calbar" ;
    schema:about place:89938 .

review:89938_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Concept déjanté, accueil chaleureux, vous y trouverez une succulente carte à cocktail et une intéressante sélection de spiritueux… bonne dégustation." ;
    schema:about place:89938 .

review:89938_r9 a schema:Review ;
