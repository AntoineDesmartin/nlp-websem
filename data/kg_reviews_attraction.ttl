review:83619_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "I never knew there would be a place where people have rebuilt gates and other statues. There are a lot of funny things to see, as well." ;
    schema:about place:83619 .

review:83619_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The view at the Eiffeltower from the café is worth coming here again!" ;
    schema:about place:83619 .

