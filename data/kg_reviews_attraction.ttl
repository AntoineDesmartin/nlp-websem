review:85345_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "O temps, suspend ton vol ! Un endroit caché et calme pour s'attendrir. A hidden gem far from Paris's hectic pace. Lovely with the Colonnes de Buren." ;
    schema:about place:85345 .

review:85345_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Parterre de fleurs et enivrement..." ;
    schema:about place:85345 .

review:85345_r3 a schema:Review ;
