review:84427_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Autant de feuilles de salades dans les plats... J'ai l'impression qu'ils nous prennent pour des lapins" ;
    schema:about place:84427 .

review:84427_r2 a schema:Review ;
    schema:author "Anonymous" ;
