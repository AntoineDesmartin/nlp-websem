review:84235_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "60 rue de Bassano 75008 Paris - free entrance from Monday to Saturday (12am to 7pm) and on Sundays (11am to 7pm)" ;
    schema:about place:84235 .

review:84235_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Super Expo L'Inde dans tous les sens" ;
    schema:about place:84235 .

review:84235_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Dernières semaines de l'exposition Ailleurs. Les héritiers de Paul Gauguin en art contemporain. L'art expéditionnaire ou la quête de l'extrême à la rencontre du lointain et de l'Autre" ;
    schema:about place:84235 .

review:84235_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Nouvelle expo: Transfigurations, Mythologies Indiennes (24/06-23/10/11)" ;
    schema:about place:84235 .

review:84235_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The views are amazing and it's open to the public. Sneak in a grilled cheese sandwich for added effect of rebellion." ;
    schema:about place:84235 .

review:84235_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Derniers jours de l'expo Trans-Figurations sur l'art contemporain indonésien. A ne pas rater!!! En plus, c'est entrée libre!" ;
    schema:about place:84235 .

review:84235_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Anicroches - Variations, Choral and Fugue - Until February 19th 2012" ;
    schema:about place:84235 .

review:84235_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un lieu surprenant avec toujours de bonnes expos. N'oubliez pas de prendre un exemplaire du catalogue de l'expo, c'est gratuit." ;
    schema:about place:84235 .

review:84235_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Deliciosa experiência!" ;
    schema:about place:84235 .

review:84235_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "\"Turbulence\" jusqu'au 09/2012. Très intéressante à la fois artistique et scientifique.N'hésitez pas à demander des informations complémentaires,le personnel se donnera un plaisir de vous répondre." ;
    schema:about place:84235 .

review:84235_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "'Turbulences', brings together 11 artists, exploring the art of playing with order and disorder, far from the threatening commotion of total chaos." ;
    schema:about place:84235 .

review:84235_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "À visiter, ne serait-ce que pour l'expérience de l'ascenseur ... N'hésitez pas à poser des questions / demander une visite guidée : le personnel est très agréable et passionné." ;
    schema:about place:84235 .

review:84235_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The elevator is already an experience by itself, complete darkness for 25 seconds. The space offers amazing & provocative artworks and a view of the Champs Elysees is a +." ;
    schema:about place:84235 .

