review:89528_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Бесплатный доступ в альпийский сад в рабочие дни. В целом хороший парк, из плюсов - много цветов, из минусов - пыльно и нельзя сидеть на траве." ;
