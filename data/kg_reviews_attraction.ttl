review:85628_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "This is an intimate, cosy square where you can spend hours and hours at a cafe table. The somewhat touristy Rue Mouffetard, a historical part of the Quartier Latin begins and goes South from here." ;
    schema:about place:85628 .

review:85628_r7 a schema:Review ;
