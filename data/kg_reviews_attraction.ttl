review:85291_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Alors attention a ne pas trop chanter \"joyeux anniversaire\" dans le bar, on récolte une réprimande du barman. Et attention les fêtards ils ne servent plus de verres a partir de 0h45 (fermeture a 2h)" ;
    schema:about place:85291 .

review:85291_r8 a schema:Review ;
