review:83256_r45 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un endroit destiné aux amoureux en manque d’intimité ou à ceux qui sont à la recherche de sensations fortes ! C’est aussi une parfaite thérapie pour les couples en période difficile…" ;
    schema:about place:83256 .

