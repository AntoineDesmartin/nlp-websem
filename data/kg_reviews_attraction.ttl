review:83523_r115 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "il faut y aller" ;
    schema:about place:83523 .

review:83523_r116 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un musée moder avec des oeuvres très intéressantes. La partie design industriel pourrait être complété." ;
    schema:about place:83523 .

review:83523_r117 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "建于1989年的蓬皮杜现代艺术中心,已成为巴黎第二受欢迎的博物 馆,也是全球游客最多的十大博物馆之一;而这个“奇怪的庞然大 物”本身就是一个后现代建筑艺术品,你可以从颜色去区别她的水 电排气电梯系统:蓝色是空调排气系统,黄色是电力系统,绿色是 水管,红色则是电梯;顶层的咖啡也是个休闲的好地方。" ;
    schema:about place:83523 .

review:83523_r118 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "If there is a big line....ask if there is VIP access for French people. Worked for me!" ;
    schema:about place:83523 .

review:83523_r119 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Pour éviter de faire la queue à l'entrée du musée, accédez par l'ascenseur extérieur pour aller au restaurant et redescendez" ;
    schema:about place:83523 .

review:83523_r120 a schema:Review ;
    schema:author "Anonymous" ;
