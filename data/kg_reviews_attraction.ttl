review:84761_r44 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Want to see an exhibition or go to a gig ? Want to brunch, drink or dance ? All of this is possible in this alternative art centre located by Canal St Martin !" ;
    schema:about place:84761 .

review:84761_r45 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Salle de concert, studio de danse, lieu d'exposition, bar, resto au bord du canal... Un lieu culturel incontournable !" ;
    schema:about place:84761 .

review:84761_r46 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "They always serve coffee." ;
    schema:about place:84761 .

review:84761_r47 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Bar testé par l'Apéro du Jeudi. L'été prenez une pinte à emporter pr vs mettre au bord du canal st" ;
    schema:about place:84761 .

review:84761_r48 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Stade \"grosse tete\" sur la pente descendante des cool places. Attente interminable de jour. Videurs zélés de nuit. Remarques quand on est en short. Pire que boites du cac40 avec les cartes d'identité." ;
    schema:about place:84761 .

review:84761_r49 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Au stade \"grosse tete\" sur la pente descendante des cool places. Attente interminable de jour. Videurs zélés anti-short de nuit. Pire que les boites du cac40 avec les cartes d'identité." ;
    schema:about place:84761 .

review:84761_r50 a schema:Review ;
    schema:author "Anonymous" ;
