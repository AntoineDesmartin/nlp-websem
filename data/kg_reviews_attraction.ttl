review:85291_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Très certainement le seul bar sympa sur la place de Clichy. Caché en tout debut de la rue Biot; clientèle d'habitués; vin chaud et petits prix." ;
