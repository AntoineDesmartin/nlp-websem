review:86576_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un fantastique ballet de voitures qui émerveillera petits et grands. Une église époustouflante de beauté architecturale. Un patrimoine sans équivalent. Cet endroit est féerique." ;
    schema:about place:86576 .

