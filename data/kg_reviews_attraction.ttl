review:86609_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Venez vous y promener le soir en semaine, evitez le week-end en journee, flanez, admirez le bati, les squares, respirez, laissez les cris de mouettes vous emmener, enjoy" ;
    schema:about place:86609 .

review:86609_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Quartier ouvert le dimanche!" ;
    schema:about place:86609 .

review:86609_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "马亥区真是个好地方，除了博物馆和名人故居云集，还有很多1900s的古董、艺术品商店和卖小玩意的地方，价格比起左岸要平易近人许多，应是巴黎最佳购物地。我在Forney艺术图书馆附近的一个穹顶花园般的购物广场 St Paul 买了几顶精美绝伦的欧式帽子，即便戴去参加皇家赛马日也毫不失礼。附近还有便宜到笑的vintage店，以及以色列小吃 (因为附近还有一个历史悠久的犹太人区）。" ;
    schema:about place:86609 .

review:86609_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Mais n'y venez surtout pas le dimanche, venez y en semaine, idealement en fin de journee, flanez, admirez le bati, ecoutez les mouettes, finissez sur l'Ile St Louis a deux pas...et envolez-vous :-)" ;
    schema:about place:86609 .

review:86609_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Walk down Rue de Temple in 5 inch heels singing Ale Ale Alejandro!" ;
    schema:about place:86609 .

review:86609_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un des meilleur quartier de Paris, pour éviter le plateau télé du dimanche, et déjeuner un bon brunch entre amis :)" ;
    schema:about place:86609 .

review:86609_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "C'est incroyable! My favorite!" ;
    schema:about place:86609 .

review:86609_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "eat falafel!" ;
    schema:about place:86609 .

review:86609_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Cozy attic in a XVII century building in the heart of Paris" ;
    schema:about place:86609 .

review:86609_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The book, Walking Paris by Giles Desmons has a great walking tour that takes you to several historic buildings and museums." ;
    schema:about place:86609 .

review:86609_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le plus beau quartier de Paris. Dans les restos et les parcs, attention aux roms qui viennent vous aborder avec un papier, ils veulent votre téléphone, idéalement posé sur la table ou sur l'herbe." ;
    schema:about place:86609 .

review:86609_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Place des Vogues..." ;
    schema:about place:86609 .

review:86609_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "the gay scene in Paris...visit bars, restaurants or even sex shops!! lots of cute guys around" ;
    schema:about place:86609 .

review:86609_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "We love the higgledy-piggledy medieval streets and the artsy-boho vibes. It’s the perfect spot for an afternoon of shopping and museum hopping or a laidback evening on the town." ;
    schema:about place:86609 .

review:86609_r14 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "This neighborhood was once a favorite urban spot for French nobility. Now it's a shopper's paradise and home to some of Paris's best falafel, found at L'As du Falafel." ;
    schema:about place:86609 .

review:86609_r15 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Jewish & Gay district in the center of Paris. Very trendy by night with some chill-out bars. to find your cheap here in the Marais ;) http://awe.sm/5dpMb" ;
    schema:about place:86609 .

review:86609_r16 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "One of Paris best places, you have to wander in the streets, get lost a little bit and discover the vintage shops and the very trendy bars, perfect to chill-out !" ;
    schema:about place:86609 .

review:86609_r17 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Go to Kata shoe store 68 rue de rivoli for cute cheap shoes-- under 20 euro!!" ;
    schema:about place:86609 .

review:86609_r18 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le meilleur falafel de Paris!" ;
    schema:about place:86609 .

review:86609_r19 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le meilleur quartier de Paris." ;
    schema:about place:86609 .

review:86609_r20 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Trendy neighborhood in the center of Paris. Lots of shops and restaurants. Great for gift shopping and people watching! Beautiful at night with the lights in drizzling rain." ;
    schema:about place:86609 .

review:86609_r21 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Lots of really cool street art at every corner! look up and around" ;
    schema:about place:86609 .

review:86609_r22 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Mon quartier préféré de Paris. Évidemment. Que dire de plus ? <3" ;
    schema:about place:86609 .

review:86609_r23 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "J'aime le Marais!" ;
    schema:about place:86609 .

review:86609_r24 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Very interesting medieval architecture." ;
    schema:about place:86609 .

review:86609_r25 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "great district for art galleries on the internal streets surrounding the Picasso museum. Trendy bars, cafes on the the external streets and suddenly you are confronted by a medieval church somewhere." ;
    schema:about place:86609 .

review:86609_r26 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The most artistic place to stay in paris! Nous aimons \"le marais\"" ;
    schema:about place:86609 .

review:86609_r27 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "meilleur quartier de Paris pour toujours." ;
    schema:about place:86609 .

review:86609_r28 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "И это одно из редких мест, где прохожие вежливо и приветливо отвечают на вопросы, заданные на английском.На  улицах Фран Буржуа и Вйёй дю Тампль. магазины A.P.C., Surface to Air, Red Wings" ;
    schema:about place:86609 .

review:86609_r29 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Shop and wander." ;
    schema:about place:86609 .

review:86609_r30 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Great Quartier" ;
    schema:about place:86609 .

review:86609_r31 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Great neighborhood- lots of restaurants and nice small streets" ;
    schema:about place:86609 .

review:86609_r32 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Excelente programa para o domingo em Paris! É um bairro judeu e gay, cheio de museus, galerias, bares e gente bonita e atípicamente simpáticas nas ruas. Uma verdadeira miscelânea temporal e cultural!" ;
    schema:about place:86609 .

