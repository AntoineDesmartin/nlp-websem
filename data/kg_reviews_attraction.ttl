review:83384_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "One of the best vodka martinis in Paris. Even James Bond likes the place: it gets a namecheck in the book For Your Eyes Only." ;
    schema:about place:83384 .

review:83384_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Best cocktails in town + awesome selection of whiskies. A place for Islay lovers..." ;
    schema:about place:83384 .

