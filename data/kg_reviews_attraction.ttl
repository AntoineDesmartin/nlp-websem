review:83707_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Wow. Amazing show" ;
    schema:about place:83707 .

review:83707_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "You French are a funny lot. Lido; a pastiche of cabaret, lip-sync, mime & softcore porn! Loved it though." ;
    schema:about place:83707 .

review:83707_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "spectacle étonnant  !!" ;
    schema:about place:83707 .

review:83707_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Очень даже красиво. Сцена оборудована на все 100%. В перерывах классные циркачи и клоуны. Нам понравилось. Стоит еще посетить Crazy Horse. Вход 100 евро. В подарок - шампанское." ;
    schema:about place:83707 .

review:83707_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le Lido!!! Juste au cœur des Champs Elysées, c'est un des institution de Paris!!" ;
    schema:about place:83707 .

review:83707_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Check out the mime and ice skaters" ;
    schema:about place:83707 .

review:83707_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Juste incontournable ! Un spectacle magnifique ! Et qui n'est pas réservé qu'aux touristes. Parisiens allez y !" ;
    schema:about place:83707 .

review:83707_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Simply amazing!" ;
    schema:about place:83707 .

review:83707_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Beautiful costumes, excellent dancers, high standard performances and an excellent dinner with champagne..." ;
    schema:about place:83707 .

review:83707_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Pour une soirée inoubliable à Paris !" ;
    schema:about place:83707 .

review:83707_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Muhtesem bir show, inanilmaz sahne showlari ve muhtesem kostumler..." ;
    schema:about place:83707 .

review:83707_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "What an amazing show. Forget what is impossible in a theatre. Fantastic decors, costumes and performance.  Oh yes, the girls looked great too!" ;
    schema:about place:83707 .

review:83707_r14 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Wow what a great dinner and show. It was my birthday present and all was well organized. While dancing on the dancefloor, the waiter came with the birthdaycake including birthdaysong by the band." ;
    schema:about place:83707 .

review:83707_r15 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "si llegó a París, a debe ver este lugar, dónde está la danza, los espectáculos y la comida deliciosa servida con champán." ;
    schema:about place:83707 .

