review:85846_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Frankreichs berühmtester Fluss entspringt auf dem Plateau von Langres, fließt an Paris vorbei und mündet bei Honfleur in den Atlantischen Ozean." ;
