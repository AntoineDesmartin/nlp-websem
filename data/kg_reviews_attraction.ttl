review:83966_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Nice pub. You can eat and watch sport games." ;
    schema:about place:83966 .

review:83966_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Oh my goodness they serve Guinness in a Kronenbourg glass !! Shocking !" ;
    schema:about place:83966 .

review:83966_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Service au bar obligatoire et user de patience envers le personnel de service" ;
