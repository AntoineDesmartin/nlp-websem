    schema:author "Anonymous" ;
    schema:reviewBody "livres, ciné, bouffe .." ;
    schema:about place:84720 .

review:84720_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Réserver vos billets sur internet et faite la queue 20 minutes aux caisses pour les résultats récupérer parce que c impossible sur les caisses automatiques..." ;
    schema:about place:84720 .

review:84720_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Prix élevé du ticket cinéma. Salle néanmoins confortable, d'ailleurs le prix permet un visionnage du film à l'affiche." ;
    schema:about place:84720 .

review:84720_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Salle 1 et 2, très grandes et très confortables." ;
    schema:about place:84720 .

review:84720_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Les cinémas MK2 sont plutôt destinés aux bobos, donc c'est pas mal pour regarder un film tranquille ; celui-ci bénéficie d'un cadre très sympa (à prendre : le bateau qui relie les deux cinémas)" ;
    schema:about place:84720 .

review:84720_r8 a schema:Review ;
