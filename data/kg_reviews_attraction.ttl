review:84500_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Avant chaque représentation, une soixantaine de places à 5€ sont vendues. RDV 1h30 avant le spectacle devant l'entrée principale !" ;
    schema:about place:84500 .

review:84500_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Tous les jours, avant chaque représentation, venez chercher les dernières places disponibles à prix cassés au 130 rue de Lyon !" ;
    schema:about place:84500 .

review:84500_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "N'oubliez pas de retirer de l'argent avant de venir si vous avez faim ou soif, les bars n'acceptent pas les cartes et impossible de sortir pendant les entractes !" ;
    schema:about place:84500 .

review:84500_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Go see an opera at this modern opera house! If you don’t want to pay the full price you can get standing room tickets which are considerably cheaper!" ;
    schema:about place:84500 .

review:84500_r6 a schema:Review ;
