review:90612_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Si tu aimes les défis prends ta valise qui pèse 20kg et arpente les escaliers jusqu'au dernier étage. Si tu as faim passe ton chemin, un frigo qui souffre lui même de malnutrition. Son canapé ❤" ;
    schema:about place:90612 .

review:90612_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "C'est vrai que les escaliers sont difficiles a monter mais après tu t'y habitue je trouve :) et le canapé de Warren est génial." ;
    schema:about place:90612 .

