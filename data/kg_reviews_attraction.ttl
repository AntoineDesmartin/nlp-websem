review:83443_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "I'm there at least once a week! Live bands, from rock/punk to hiphop/rap, upcoming bands are always welcome! Very crowded, bar tenders rarely in a good mood, raise up your elbows, push and shove!!" ;
    schema:about place:83443 .

review:83443_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Live music, free admission and awesomeness" ;
    schema:about place:83443 .

review:83443_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Rock Atmosphere. Very good HH. But crowded the w-e." ;
    schema:about place:83443 .

review:83443_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Welling Walrus" ;
    schema:about place:83443 .

review:83443_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Stand by the taps to get the fastest service (still slow)!!" ;
    schema:about place:83443 .

review:83443_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un bar super cool, les boissons plutôt abordable ! The place to be !" ;
    schema:about place:83443 .

review:83443_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Espère que la 15ème #NiP s'est bien passée !" ;
    schema:about place:83443 .

review:83443_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "one of my favorite rock music venue: great gigs and cheap drinks!" ;
    schema:about place:83443 .

review:83443_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Toujours de bons artistes à écouter" ;
    schema:about place:83443 .

review:83443_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "‎The Yolks en concert le 10 octobre pour une ‘release party’ de leur nouvel EP, « Bossy Lady »." ;
    schema:about place:83443 .

review:83443_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "This is a place that knows how to party and celebrate music in all its variety.The team at this red hot bar-cum-concert venue in the 11th has been offering everything from folk to electro." ;
    schema:about place:83443 .

review:83443_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Ambiance roots, jogging et baskets acceptées. Pinte 6€ et Mojito 7€50. Régulièrement des concerts au sous sol..." ;
    schema:about place:83443 .

review:83443_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Трэшовое место, иногда играют интересные молодые музыканты. Разношерстная публика. Короче, на любителя" ;
    schema:about place:83443 .

review:83443_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Free live music, entrée gratuite. Not so expensive drinks. Ambiance décontractée et personnes ouvertes à la discussion. Bref, une référence du quartier oberkampf" ;
    schema:about place:83443 .

review:83443_r14 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Excellent bar. inspired bands, great drinks, free admission. Public very polite and willing to meet new bands." ;
    schema:about place:83443 .

