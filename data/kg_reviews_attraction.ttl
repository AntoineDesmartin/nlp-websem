review:91211_r802 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Try to get your tickets to the top of the tower in advance, waiting time even for tickets bought online is about 20 min. I guess regular tickets can reach up to 4 hours to get access to the tower." ;
    schema:about place:91211 .

review:91211_r803 a schema:Review ;
