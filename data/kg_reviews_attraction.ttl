review:90668_r63 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "V Paříži najdeme jedny z nejzajímavějších míst v Evropě. Kromě klasických památek je zajímavým tipem plavba po Seině (např. od Notre Dame), kostel St. Séverin nebo Latinská čtvrť (ochutnejte fondue)." ;
    schema:about place:90668 .

