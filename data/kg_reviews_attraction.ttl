review:89938_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Number one in my cocktail bar list in Paris! Amazing service, exquisite Cocktails! Ask for a Surprise cocktail with St-Germain liquor (my pic) and ENJOY! Real love for this place  :)" ;
