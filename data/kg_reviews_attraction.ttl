review:85345_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le plus beau jardin de Paris! Véritable havre de paix!" ;
    schema:about place:85345 .

review:85345_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un véritable délice parisien ! J'aime observer les vieilles dames parisiennes qui s'y promènent bras dessus bras dessous." ;
