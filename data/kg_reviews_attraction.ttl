review:89931_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "LE lieu auto proclamé \"bar geek de Paris\". Au-delà de la déco qui comprend de nombreux clins d'oeil, c'est surtout la population qui confirme cette réputation : c'est \"crowded\" sur Foursquare ;-)" ;
    schema:about place:89931 .

review:89931_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Je recommande grandement et chaudement ce bat. Bonne découverte. Geek ou pas geek, les serveurs et serveuses sont cool et il y a pleins de jeux différents." ;
    schema:about place:89931 .

review:89931_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Bruyant, cher et très jeune. Sinon c'est original..." ;
    schema:about place:89931 .

review:89931_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "42, what else ?" ;
    schema:about place:89931 .

review:89931_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Fermé le lundi !" ;
    schema:about place:89931 .

review:89931_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le Bar Le Plus Cher Avant La Fin Du Monde, mais l'équipe est hyper sympa, à l'image de la déco et du thème." ;
    schema:about place:89931 .

review:89931_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The place to geek !" ;
    schema:about place:89931 .

review:89931_r14 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Malgré l'absence de mikado : un concept bar assez original à tester entre amis... (et sans mauvais joueurs) mention spéciale aux serveurs qui jouent un nouveau rôle tous les samedis. À vos costumes !!" ;
    schema:about place:89931 .

review:89931_r15 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "D'habitude aller dans un bar c'est pas mon truc, mais le DBALFDM , c'est complètement différent." ;
    schema:about place:89931 .

review:89931_r16 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un bar où tu peux jouer à des jeux simples ou de rôle parmi tant d'autres! Petite + pour les hommes avec le jeu dans les toilettes : qui shootera le plus de pingouins?!" ;
    schema:about place:89931 .

review:89931_r17 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Dommage pour le surplus de populasse !!" ;
    schema:about place:89931 .

review:89931_r18 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "super cadre, super personnel, avec l'amusant compteur indiquant le temps qu'il nous reste à vivre... Un bar incontournable!" ;
    schema:about place:89931 .

review:89931_r19 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "J'ai venu. J'ai vu. J'ai kiffu. <3" ;
    schema:about place:89931 .

review:89931_r20 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Ambiance et carte très originales. Staff adorable. Pour les geeks comme pour les simples curieux." ;
    schema:about place:89931 .

review:89931_r21 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Ambiance très Doctor Who, il ne manque plus que David Tennant!! Conso pas chères et accueil super sympa!!" ;
    schema:about place:89931 .

review:89931_r22 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le 42 se boit tout seul et est bon, le Captain's Order n'est pas aussi alcoolisé qu'il n'y paraît et le Pan Galaric Gargle Blaster est vraiment spé, à boire à plusieurs." ;
    schema:about place:89931 .

review:89931_r23 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Um bar geek em Paris, 400m2 divididos em 3 andares, inspirado no universo geek, de Matrix a Julio Verne, passando por Star Trek,  V de Vingança e World Of Warcraft." ;
    schema:about place:89931 .

review:89931_r24 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Um bar geek em Paris, 400m2 divididos em 3 andares, inspirado no universo geek, de Matrix a Julio Verne, passando por Star Trek,  V de Vingança e World Of Warcraft." ;
    schema:about place:89931 .

review:89931_r25 a schema:Review ;
