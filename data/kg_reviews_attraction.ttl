review:86365_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Très bon menu à 10€ avec pièce du boucher, boisson plus salade de bienvenue . Excellent rapport qualité prix" ;
    schema:about place:86365 .

review:86365_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Ne pas se fier au nom! La musique ressemble plus à David Guetta qu'à Mettalica... Et impossible de s'entendre parler! Mais prix abordables et service aimable." ;
    schema:about place:86365 .

review:86365_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Bar super sympa pour se détendre après une journée de boulot. Les tarifs sont très attractifs (3,50€ la pinte). Un peu bruillant mais possibilité de sortir avec sa pinte pour prendre l'air!" ;
    schema:about place:86365 .

review:86365_r3 a schema:Review ;
