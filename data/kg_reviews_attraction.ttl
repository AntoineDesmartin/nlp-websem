review:83601_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "A ne pas manquer : leurs cycles de conférences de très bonne qualité !" ;
    schema:about place:83601 .

review:83601_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "best buddha's" ;
    schema:about place:83601 .

review:83601_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "吉美亚洲艺术博物馆，是西方亚洲藏品最丰富的博物馆之一。属于在巴黎不得不去的博物馆--不仅仅是因为馆藏，这家博物馆的空间设计非常实用且富美感，藏品的排列组合、安置搭配极具匠心，其陈列的方式本身就是造诣高妙的艺术。另外，在这儿能看到一些风格罕见的中国瓷陶器，令人耳目一新，心醉神迷。" ;
    schema:about place:83601 .

review:83601_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "De Laque et d'Or - Manuscrits de la Birmanie - Until January 23rd" ;
    schema:about place:83601 .

review:83601_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Make sure to access the Panthen Bouddhique to get to the most delicate Japanese Garden ever. The \"planks walk\" ouver the water is a great shot to get !" ;
    schema:about place:83601 .

review:83601_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "One of the best museums in Paris - from Afghanistan to Japan - a great collection of Asian arts.." ;
    schema:about place:83601 .

review:83601_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Les estampes d'Hokusai présentées au public jusqu'au 10 décembre au Musée Guimet à Paris dont la célèbre \"Sous la vague\"" ;
    schema:about place:83601 .

