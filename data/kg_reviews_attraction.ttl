    schema:about place:85349 .

review:85349_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Partagez une coupe de bubbly avec Paris à vos pieds ! Share a Glass of Champagne while starring a Paris's Lights !" ;
    schema:about place:85349 .

review:85349_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Nice view, nice drinklist. But personal unwelcome. Superbe vu, très belle carte, mais personnel pas a la hauteur." ;
