    schema:about place:86365 .

review:86365_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Pinte à 3,5€ à toute heure ! All night long, pint at only €3,5!" ;
    schema:about place:86365 .

review:86365_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Excellent endroit pour se retrouver entre amis. Prix très compétitifs (pint de blonde à 3,5euros)." ;
    schema:about place:86365 .

review:86365_r6 a schema:Review ;
