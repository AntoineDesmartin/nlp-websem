review:85273_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The passerelle Léopold-Sédar-Senghor, formerly known as passerelle Solférino (or pont de Solférino), is a footbridge over the River Seine in the VIIe arrondissement of Paris." ;
    schema:about place:85273 .

review:85273_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Notice all the locks attached to the railing. Couples do this ritual to symbolize their forever lasting love. Their key is then thrown in the seine river." ;
    schema:about place:85273 .

review:85273_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Come with your best gal, buy a lock from one of the guys selling them, write your names on it, lock it to the bridge, and chuck the keys in the river." ;
    schema:about place:85273 .

review:85273_r3 a schema:Review ;
