review:85345_r25 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Además de las flores y los árboles, encontras marcas de renombre como Marc Jacobs!! Y Maison MMargiela en la calle lateral !!" ;
    schema:about place:85345 .

review:85345_r26 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Luxe, calme et volupté. Le petit Louis XIV failli s'y noyer, Camille Desmoulins y harangua la foule, sous ses arcades régnait la prostitution. Un somptueux écrin de nature aujourd'hui bien paisible." ;
    schema:about place:85345 .

review:85345_r27 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "My favourite park in town." ;
    schema:about place:85345 .

review:85345_r28 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Absolutely perfect place to relax and have a nice walk. One of the most beautiful and cozy in the city. Plus they have cool shops around here. Acne, Stella McCartney, Pierre Hardy.. ;)" ;
    schema:about place:85345 .

