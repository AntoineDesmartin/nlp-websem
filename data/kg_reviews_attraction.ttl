review:83321_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "lounge , nice , dream ;)" ;
    schema:about place:83321 .

review:83321_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un des bars d'hôtel que je préfère à Paris, cadre magnifique, la terrasse avec le mur de verdure vaut le détour" ;
    schema:about place:83321 .

review:83321_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Formule brunch à 59€... un peu chéro dans la mesure où vers 15h on commence à vous mettre dehors.. Puis pas de réassort de macarons c'est couillon.. perso je préfère celui du Murano pour 20€ de moins" ;
    schema:about place:83321 .

review:83321_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Je recommande le filet de boeuf (la sauce est délicieuse) accompagné d'un Bordeaux XX (St Emilion)" ;
    schema:about place:83321 .

review:83321_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "L'un des plus beaux décors de Paris. Étonnement, on y mange pas si mal que ça !" ;
    schema:about place:83321 .

review:83321_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Je conseil la daurade Roti!! Miam miam" ;
    schema:about place:83321 .

review:83321_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Hors de prix, mauvais service, sombre, très déçu par la nourriture : Cuisson désastreuse, arrive froid a table, bref, a éviter absolument !!!" ;
    schema:about place:83321 .

review:83321_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Mauvais service, viande pas cuite, et prix beaucoup trop cher par rapport a la qualité!!!" ;
    schema:about place:83321 .

review:83321_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Seu pátio interno tem um jardim vertical muito bonito e agradável, onde se pode almoçar e jantar nos dias mais quentes." ;
    schema:about place:83321 .

review:83321_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "fin de reunion" ;
    schema:about place:83321 .

review:83321_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Don't eat here.. I got violently ill after eating there last night.." ;
    schema:about place:83321 .

review:83321_r14 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "the most romantic place EVER!!!!" ;
    schema:about place:83321 .

review:83321_r15 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Les Tatakis de Saumon avec leur sauce au sésame sont a tester !" ;
    schema:about place:83321 .

review:83321_r16 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Superbe endroit ! ;)" ;
    schema:about place:83321 .

review:83321_r17 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Amazing atmosphere, desin and music. Also Mojito was nice. Price x cocktail 18€" ;
    schema:about place:83321 .

review:83321_r18 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Plats prétentieux mais pas à la hauteur. Service prétentieux mais de niveau amateur. Le cadre est magnifique mais cela ne suffit pas pour justifier les prix. Je n'y retournerai plus." ;
    schema:about place:83321 .

review:83321_r19 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le service le plus inexistant dans un hotel de luxe parisien. Venez patients" ;
    schema:about place:83321 .

review:83321_r20 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Cadre sympathique, cosy et relativement lounge; service à désirer (à moins de sortir l'Amex); les tatakis au saumon ont sauvé la soirée..." ;
    schema:about place:83321 .

review:83321_r21 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Service à chier... À oublier !" ;
    schema:about place:83321 .

review:83321_r22 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "One of my favorite places in Paris. So loungy, a bit exclusive, amazing design. Sipping a wonderfull drink or eating refined food there is a pure pleasure ! Expensive, but it's worth the price !" ;
    schema:about place:83321 .

review:83321_r23 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "This is one of the prettiest places I've ever been. Go here and impress your company, order a bottle of wine and live the luxury Paris live to the max!" ;
    schema:about place:83321 .

review:83321_r24 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Private and strategically located in the capital’s Golden Triangle, Pershing Hall is a small, luxurious boutique hotel that loves to be different." ;
    schema:about place:83321 .

review:83321_r25 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Pershing Hall Bar & Lounge is a great spot for stylish early evening drinks. The area near the hanging gardens is definitely the coolest, so we do what we can to score a view of the greenery." ;
    schema:about place:83321 .

review:83321_r26 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "No possibility to smoke inside" ;
    schema:about place:83321 .

review:83321_r27 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "VSOP Cucumber : A must !" ;
    schema:about place:83321 .

review:83321_r28 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un Sancerre blanc fort sympathique, un bien joli lieu et des serveuses dont on se demande quand même si elles sont toujours mannequins... Juste pour le fun! #LaProchaineFoisJePoseLaQuestion :))" ;
    schema:about place:83321 .

review:83321_r29 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Sexy waitresses" ;
    schema:about place:83321 .

review:83321_r30 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Amazing place to have dinner in Paris! I love it!!!!!" ;
    schema:about place:83321 .

review:83321_r31 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Cadre très agréable  Excellent tartare de saumon en entrée... Mais service trop long !" ;
    schema:about place:83321 .

