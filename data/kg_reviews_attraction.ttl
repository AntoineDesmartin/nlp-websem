review:86895_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The perfect mix of bohemian and upscale–a great area for low-key rambling, window-shopping, and café hopping.  Check out Sartre’s favorite hangout, Café de Flore, at 172 Boulevard St-Germain." ;
    schema:about place:86895 .

review:86895_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Рай для поклонниц французской моды. На бульваре Сен Жермен я облюбовала бутик Gerard Darel, а хозяйка при встрече каждый раз приветствует меня Bonjoir mon cher, miss beautiful legs))))" ;
    schema:about place:86895 .

review:86895_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Nice bars & places to eat...lively nightlife!!" ;
    schema:about place:86895 .

review:86895_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Try the Church to make it look a little less like a tourist trap and more like the little town it used to be ! Stay away from the obvious and go for the small details !" ;
    schema:about place:86895 .

review:86895_r6 a schema:Review ;
