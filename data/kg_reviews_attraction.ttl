    schema:about place:85349 .

review:85349_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Montez au 33ème étage et admirer une superbe vue de Paris... À partager à deux :-)" ;
    schema:about place:85349 .

review:85349_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le  Bar Panoramique se refait une beauté - réouverture  fin  2011 pour des moments inoubliables !" ;
    schema:about place:85349 .

review:85349_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The Panoramic Bar is undergoing a facelift! The transformation has begun! Re-opening at the end of 2011" ;
    schema:about place:85349 .

review:85349_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "What could be more romantic than sipping a “Tropical Kiss” watching the twinkling Eiffel Tower? For a fun evening, come on Friday or Saturday & enjoy the live band. Excellent choice of sweet & savoury" ;
    schema:about place:85349 .

review:85349_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Обалденный вид!!" ;
    schema:about place:85349 .

review:85349_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Belle vue de Paris by night! Avec un verre d'Havana à 27€ quand même! :-)" ;
    schema:about place:85349 .

review:85349_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Au 34e étage du Concorde Lafayette. Bar cosy, vu imprenable sur Paris" ;
    schema:about place:85349 .

review:85349_r14 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "We are very glad to announce you the opening of our new bar \"LA VUE\": This cocktail bar is an impressive open air theatre looking out onto the world's most incredible stage: the city of Paris." ;
    schema:about place:85349 .

review:85349_r15 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le meilleur bar de Paris demandé Stephen , le chef barman de vous faire un cocktail surprise ! Pour suive la programmation musicale Facebook.com/bar.lavue" ;
    schema:about place:85349 .

review:85349_r16 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Comptez 30€ le cocktail et 20€ le verre de vin... La vue vaut-elle une addition salée? À méditer... Surtout lorsque l'on doit aller au RDC pour fumer!" ;
    schema:about place:85349 .

review:85349_r17 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Special Valentine's day: Romance to share:A cocktail with hints of Cuban rum syrup, a pink champagne Taitinger house and a sphere of sweet hearts.55€ for 2!!!" ;
    schema:about place:85349 .

review:85349_r18 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "le 3 AVRIL 2012! 29€ les deux cocktails pour une soirée special Printemps:toutes les infos: http://www.facebook.com/events/369415183091698/" ;
    schema:about place:85349 .

review:85349_r19 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Did you know that La Vue, the venue where we organized 'In The Air' party last February, is now the trendy place to be? Enjoy a drink here to share one of the most beautiful views of Paris!" ;
    schema:about place:85349 .

review:85349_r20 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le Bar La Vue c'est...le meilleur Mojito de Paris" ;
    schema:about place:85349 .

review:85349_r21 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "A precious moment \" father and son \" ...Sunday evening, June 17th, the cocktail \" Le Mondain \" is offered at 14€ instead of 27€ for all the fathers accompanied by their son.Happy Father's Day!" ;
    schema:about place:85349 .

review:85349_r22 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Join us to celebrate July the 14th and enjoy front row seats to admire the fireworks show ! Lets meet at 9 pm for an unforgettable evening! Discover our special offer at : http://alturl.com/xx8tb" ;
    schema:about place:85349 .

review:85349_r23 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Nice view....but 27 Euro for a cocktail and 15 Euro for a beer is over the top....." ;
    schema:about place:85349 .

review:85349_r24 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Beautiful place to see an amazing view of Paris .... Very romantic and drinks are excellent." ;
    schema:about place:85349 .

review:85349_r25 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Paris at sunset, just an amazing view ! We look forward to welcome you this evening :)" ;
    schema:about place:85349 .

review:85349_r26 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Une vue panoramique imprenable sur tout Paris. Par contre ce sont des voleurs au niveau du prix, 27 € pour un mojito et 18 € pour un redbull .." ;
    schema:about place:85349 .

review:85349_r27 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Did you try our homemade icecream desserts? Each Sunday in September buy a cocktail, get the dessert for free!" ;
    schema:about place:85349 .

review:85349_r28 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "VERY SPECIAL OFFER : enjoy a -50% reduction on your drinks until Octobre 24th 2012 ! ! Have a pleasant evening ;)" ;
    schema:about place:85349 .

review:85349_r29 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Discover our new menu \"World Food Collection\" DeLiCiOuS" ;
    schema:about place:85349 .

review:85349_r30 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Book your Friday afternoon November 9th to cheer on our athletes ! Non-stop 48h on static bikes ! A world record may happen this weekend at our hotel !" ;
    schema:about place:85349 .

review:85349_r31 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Amazing view overpriced drinks cozy atmosphere." ;
    schema:about place:85349 .

review:85349_r32 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Vue unique, prix en conséquences" ;
    schema:about place:85349 .

review:85349_r33 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le Bar la Vue fait partie du TOP 10 des endroits les plus beaux pour fêter le nouvel an!!" ;
    schema:about place:85349 .

review:85349_r34 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Best view of the Arc de Triomphe & Eiffel tower. Taking photos? Use the flash, slow sync on 1st curtain. And be very still for about a second. Beautiful shots! Beers are 15eur, reasonable cocktails" ;
    schema:about place:85349 .

review:85349_r35 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Les rentrées, les soldes, les fêtes…. Le Bar La Vue pense à vous et soigne votre carte bleue avec une offre exceptionnelle -50% - A imprimer http://bit.ly/promotionBar" ;
    schema:about place:85349 .

review:85349_r36 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Envie de vertige et de sensations… ? Nous vous invitons à effectuer la visite virtuelle de notre Bar La Vue, en un clic simple : http://bit.ly/Visitevirtuelle" ;
    schema:about place:85349 .

review:85349_r37 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Une photo avec votre Valentin et la ville lumière en fond? Rendez-vous le #14 février avec notre photographe." ;
    schema:about place:85349 .

review:85349_r38 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Et pour vous... le meilleur endroit pour passer la Saint Valentin c'est où?" ;
    schema:about place:85349 .

review:85349_r39 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "1664 ve gramingen güzel bir bira farklı tatlar alexandre iyi bir garson bahşiş çerin mutlaka 270 metreden şiddetle bakmak muhteşem ;)))" ;
    schema:about place:85349 .

review:85349_r40 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le plus belle endroit pour fêter la #St Valentin c’est à 140 mètres d’altitude :  cocktails en couleurs, gourmandises, et surtout deux chanteurs d’exception!" ;
    schema:about place:85349 .

review:85349_r41 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Special Offer of -50%* To benefit from it...Nothing easier! Print this card and present it to your waiter ;) http://bit.ly/promotionBarand don't forget to become a Facebook Fan for it to work!!!!" ;
    schema:about place:85349 .

review:85349_r42 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Picture of the day :D from @Lilie__k" ;
    schema:about place:85349 .

review:85349_r43 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Good Morning Paris! Have an amazing day ;)" ;
    schema:about place:85349 .

review:85349_r44 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Très belle vue et excellents cocktails" ;
    schema:about place:85349 .

review:85349_r45 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Déclaration d’amour dans les cieux : cocktails en couleurs, pâtisseries divines et une surprise à remporter chez soi. 85euros pour 2 http://bit.ly/événementStValentin    Très bonne saint valentin" ;
    schema:about place:85349 .

review:85349_r46 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "L’équipe du bar vous accueille à partir de 17H00 pour célébrer la Saint Valentin Offre exceptionnelle de 85€ pour deux" ;
    schema:about place:85349 .

review:85349_r47 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Vos photos de la Saint Valentin sont disponibles sur facebook! : https://www.facebook.com/bar.lavue" ;
    schema:about place:85349 .

review:85349_r48 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Notre chef barman Johan Costet vous accueille tous les jours à partir de 17H00 et vous garantit des émotions de saveurs et de douceurs" ;
    schema:about place:85349 .

review:85349_r49 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Pour les amoureux de Paris, une vue superbe, de jour comme de nuit. A noter : les tarifs des consommations sont élevés." ;
    schema:about place:85349 .

review:85349_r50 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le chef vous propose une déclinaison de macarons fruits rouges & caramel beurre salé... à consommer sans modération ! Retrouvez la carte: http://bit.ly/CarteBarLaVue" ;
    schema:about place:85349 .

review:85349_r51 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "La journée de la Femme: Vous êtes plutôt Cake Pops ou choux à la crème? Répondez à notre sondage ! sur http://www.facebook.com/bar.lavue" ;
    schema:about place:85349 .

review:85349_r52 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Chanson du groupe Aline venu réaliser la promotion de ce titre au Bar La Vue http://bit.ly/ElleMoubliera" ;
    schema:about place:85349 .

review:85349_r53 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Aujourd’hui le soleil se couche à 18h44, venez en profitez autour d’un délicieux cocktail, seul ou accompagné, et envolez-vous devant un théâtre à ciel ouvert" ;
    schema:about place:85349 .

review:85349_r54 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Laissez-vous porter par les accords Vodka citron, sirop de Sauternes et jus de raisin, du haut de l’Olympe parisien" ;
    schema:about place:85349 .

review:85349_r55 a schema:Review ;
