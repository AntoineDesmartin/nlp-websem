review:84427_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Par exemple : essaye la glace à la vanille au sel de mer. On ne trouve pas de meilleur dessert en ville !" ;
    schema:about place:84427 .

review:84427_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "L'anti-dépresseur des veilles de reprise. Un accueil chaleureux par Hakim et son équipe, des assiettes bien remplies de bons produits, un tarif défiant toute concurrence. Ma cantine." ;
    schema:about place:84427 .

review:84427_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Very good and typical french food, good service, polite and careful with you and the atmosphere shloud be a reason good enough for you to go" ;
    schema:about place:84427 .

review:84427_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "A big terrace at the front, a cheap and tasty menu, live bands downstairs in the cellar... The place is the best way to experience the atmosphere of the district of Belleville/Ménilmontant !" ;
    schema:about place:84427 .

review:84427_r8 a schema:Review ;
