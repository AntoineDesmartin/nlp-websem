    schema:author "Anonymous" ;
    schema:reviewBody "Skip the Mojitos. worst in Paris! super nice place with great concerts tho ;)" ;
    schema:about place:83383 .

review:83383_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Great music!! Almost every night" ;
    schema:about place:83383 .

review:83383_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le son de samedi était complètement fou. Merci." ;
    schema:about place:83383 .

review:83383_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Je suis allé deux fois. Deux fois les groupes des gosses bourrés qui font chier..." ;
    schema:about place:83383 .

review:83383_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le blue margarita de la jeune barman avant les wc sont excellents ;)" ;
    schema:about place:83383 .

review:83383_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "C'est sympa le printemps" ;
    schema:about place:83383 .

review:83383_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Music is just awesome! Enjoy u'r night in this place!!!" ;
    schema:about place:83383 .

review:83383_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "nice spot during summer" ;
    schema:about place:83383 .

review:83383_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Si t'aimes bien t'asseoir par terre et boire de la bierre degueu à 5€ dans des gobelets en plastique... Fonce c'est un endroit pour toi, petit scarabée ;)" ;
    schema:about place:83383 .

review:83383_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Pinte pression degueu à 7 euros : pfiou." ;
    schema:about place:83383 .

review:83383_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Cet établissement est signataire de la charte Fêtez Clairs: tu peux y trouver des préservatifs, des éthylotests, des bouchons d'oreilles et des documents de prévention http://www.fetez-clairs.org" ;
    schema:about place:83383 .

review:83383_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "A boat to party on in style without ever leaving the port, a must on the capital’s nightlife circuit. Recently renovated restaurant, concert hall, dance club in an irreverent décor." ;
    schema:about place:83383 .

review:83383_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Dupstep a gogo tous les mercredis soir!!!!!" ;
    schema:about place:83383 .

review:83383_r14 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "One of my favorite places. A romantic \"bateau\" sur Seine. Quite cheap. Live music." ;
    schema:about place:83383 .

review:83383_r15 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Great place for enjoy electro music" ;
    schema:about place:83383 .

review:83383_r16 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Pieza clave de el final de una noche increíble en Paris." ;
    schema:about place:83383 .

review:83383_r17 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "www.batofar.orgEm frente ao Quai François Mauriac75013 Metro BNF ou Quai de la gareDe 2° a 6° das 12 as 2 da manhãDe sabado das 18 as 2 da manhãe de domingo, Brunch das 11:30 as15horas .Doceparis" ;
    schema:about place:83383 .

review:83383_r18 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "CP : Cette année, la Plage du Batofar a été totalement repensée par l’architecte Sophie Nicolas. La terrasse est en bambou. Les transats tellement confortables. La carte de la Plage \"tapas y planchas\"" ;
    schema:about place:83383 .

review:83383_r19 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "de bons moments passés ici" ;
    schema:about place:83383 .

review:83383_r20 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "videur est sympa, le lieu agréable MAIS la fille de l'accueil est exécrable - n'oubliez pas de lui demander le tarif étidiant - et la soirée manquait totalement d'ambiance. Vraiment pas terrible!!" ;
    schema:about place:83383 .

review:83383_r21 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Très sympa. Happy hour 17-19h. Pinte à 5€" ;
    schema:about place:83383 .

review:83383_r22 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "if you enjoy dubstep and partying on a boat with a beautiful view it's the perfect place to be! especially when you go smoke your cig on the top of the boat sur la seine de Paris!" ;
    schema:about place:83383 .

review:83383_r23 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Paris / Re-listen your favourite Clubnights from “Le Batofar” at http://www.play.fm/club/batofar" ;
    schema:about place:83383 .

review:83383_r24 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Shows burlesques, charmeurs de serpents, body-painting... pour une soirée Halloween totalement freak !" ;
    schema:about place:83383 .

review:83383_r25 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Du bon son + un lieu d'attraction = beau résultat" ;
    schema:about place:83383 .

review:83383_r26 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Ok l entrée à 14€ me calme direct!!next!" ;
    schema:about place:83383 .

review:83383_r27 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Detroit Techno Militia first performed here 24 April 2013." ;
    schema:about place:83383 .

review:83383_r28 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Rillette maison de saumon en robe de tagliatelles iodée" ;
    schema:about place:83383 .

review:83383_r29 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Great venue, beautiful location at night, beer's a bit on the expensive side though..." ;
    schema:about place:83383 .

review:83383_r30 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Installe toi là où tu veux et lis pas mes conseils tu perds ton temps" ;
    schema:about place:83383 .

review:83383_r31 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "How do you get the deezer badge?" ;
    schema:about place:83383 .

review:83383_r32 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Parce que la vie, c’est aussi prendre l’apéro sous le soleil et écouter de la bonne musique bien calé dans un transat, la plage du Batofar ouvre ses portes de mai à septembre." ;
    schema:about place:83383 .

review:83383_r33 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "En ce moment la plage...Serveuse super sympa !... Et, Ahhhh  \"Michey l' Ange\" au bar à ne pas louper (#sisi c' est son vrai prénom !...)." ;
    schema:about place:83383 .

review:83383_r34 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "CHEVAL LE GROUPE" ;
    schema:about place:83383 .

review:83383_r35 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "C'est certainement l'endroit qui est le dernier jour de Paris et que vous voulez avoir du plaisir" ;
    schema:about place:83383 .

review:83383_r36 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un conseil ? Investir dans un groupe électrogène pour les prochaines coupures d'électricité :p" ;
    schema:about place:83383 .

