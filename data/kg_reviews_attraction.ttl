review:83926_r26 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Well-made cocktails in Paris tend to be the exclusive domain of ritzy hotel bars, so it’s a treat to be able to sip these inventive concoctions in a chill, trendy setting. Start with Experience #1." ;
    schema:about place:83926 .

