    schema:about place:86357 .

review:86357_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Tout le week-end, animations sur le Parvis de Notre Dame pour célébrer les Rameaux !" ;
    schema:about place:86357 .

review:86357_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Par exemple : essaye la glace à la vanille au sel de mer. On ne trouve pas de meilleur dessert en ville !" ;
    schema:about place:86357 .

review:86357_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Near the beautiful cathedral, you can find our Hotel, located 1 bis rue de Vaugirard. Be sure that the Hotel Best Western Trianon Rive Gauche would be glad to welcome you !" ;
    schema:about place:86357 .

review:86357_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Plus agréable en hiver qu'en été :)" ;
    schema:about place:86357 .

review:86357_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Passe 22h, les badauds sont ivres" ;
    schema:about place:86357 .

review:86357_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Visiter l' Hôtel Dieu de Paris, le plus ancien hôpital de la capital. Visite guidée possible" ;
    schema:about place:86357 .

review:86357_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The most Famous Church on the world:).Awesome" ;
    schema:about place:86357 .

review:86357_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Hermosa en los días de sol. No perderse atravesar el puente que lleva a Notre-Dame, si se tiene la suerte de encontrar a los músicos callejeros sobre el Sena el paisaje es de postal." ;
    schema:about place:86357 .

review:86357_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Лестница перед собором.)" ;
    schema:about place:86357 .

review:86357_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Good luck getting a good shot of the front of the Cathedral.  There's a giant ramp/stair structure in the middle of the square for the 850th anniversary." ;
    schema:about place:86357 .

review:86357_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Sous le parvis de la Cathédrale Notre-Dame se trouvent des vestiges de l'époque gallo-romaine, dans une très grande crypte." ;
    schema:about place:86357 .

review:86357_r14 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le point zéro des routes de France est situé à une cinquantaine de mètres devant l'entrée de Notre-Dame dans les pavés du parvis de la cathédrale." ;
    schema:about place:86357 .

review:86357_r15 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Il y a un pavé de bronze au centre du grand refuge du Parvis : c'est le point de départ du kilométrage de toutes les routes de France. Il fut placé en 1924." ;
    schema:about place:86357 .

review:86357_r16 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Don't miss this and don't ignore it.." ;
    schema:about place:86357 .

review:86357_r17 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Recalling back huncback&notre dam's story :)" ;
    schema:about place:86357 .

review:86357_r18 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Be sure to see Notre Dame in 360 .  Every angle is different.  View from Jardins is to die for.  Don't miss Ile de St. Louis afterward for boutiques and Berthillon ice cream." ;
    schema:about place:86357 .

review:86357_r19 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Try either French or Italian restaurants in the side streets...don't miss" ;
    schema:about place:86357 .

review:86357_r20 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The most famous church in the world" ;
    schema:about place:86357 .

