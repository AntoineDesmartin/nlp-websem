review:83384_r50 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The cocktails are overpriced but very well made. As the bar that invented many famous drinks, it's a must visit. Great decor and surprisingly few American tourists." ;
    schema:about place:83384 .

review:83384_r51 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "** : Une fréquentation résolument internationale pour ce bar ! Salle au sous-sol avec parfois de la musique. Ici fut créé le Bloody Mary (13€). Perrier 20cl : 5€. Sympa en sortie de bureau." ;
    schema:about place:83384 .

review:83384_r52 a schema:Review ;
