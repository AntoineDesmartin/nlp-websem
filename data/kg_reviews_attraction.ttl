review:91211_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The first 200 people to make a reservation and purchase etickets can bypass the huge line to get to the elevator." ;
    schema:about place:91211 .

review:91211_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Dont go without E-tix otherwise you'll hc to wait for hrs" ;
    schema:about place:91211 .

review:91211_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The Eiffel Tower (French: Tour Eiffel) is a 19th century iron lattice tower located on the Champ de Mars in Paris that has become both a global icon of France and one of the most recognizable structur" ;
    schema:about place:91211 .

