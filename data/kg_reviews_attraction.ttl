review:84196_r17 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "L’aménagement de la nouvelle Place de la République semble tomber à pic ! Près du café Monde et Média, le sol est équipé d’un brumisateur et de jets d’eau, déclenchées quand il y’en a besoin." ;
    schema:about place:84196 .

review:84196_r18 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "La \"brume\" de la pataugeoire est active toutes les 30 secondes" ;
    schema:about place:84196 .

review:84196_r19 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le resto sur la place est un peu cher, pas très bon, et le service est lent." ;
    schema:about place:84196 .

review:84196_r20 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Attention en plein soleil le lion brûlé les mains !" ;
    schema:about place:84196 .

review:84196_r21 a schema:Review ;
    schema:author "Anonymous" ;
