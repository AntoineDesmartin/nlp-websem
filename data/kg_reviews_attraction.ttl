    schema:reviewBody "Pour résumer : \"Prix sur demande\" :D" ;
    schema:about place:83465 .

review:83465_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "This square smells luxury. Boucheron, Van Cleef and Arpels, Maubousin, Chanel, Chaumet, Dior, the Ritz,... But window-shopping is free ;)" ;
    schema:about place:83465 .

