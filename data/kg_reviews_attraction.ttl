review:85417_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Malheureusement devenu un nid à touriste sans âme ni conscience... Barrière, caméra de surveillance (dans le réverbère !) et bruit, sans intérêt ; ou alors quand c'est vide." ;
    schema:about place:85417 .

