review:91121_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Arrivez tôt! Ou réservez pour dîner sinon pas de place passé 19:30" ;
    schema:about place:91121 .

review:91121_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The New place to be !!" ;
    schema:about place:91121 .

review:91121_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "**** : Un des seul rooftop de la capitale! L'ouverture de l'ascenseur sur le toit est extra. Demi 5€, bouteille de rosé 27€. Restaurant menu unique 42€. Arrivez très tôt ou réserver. Incontournable!" ;
    schema:about place:91121 .

review:91121_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "D'un côté une belle vue et une superbe terrasse de l'autre un Resto en rodage qui n'assume pas ses carences. Un service faiblard qui oublie que la base et qui ne sait pas s'excuser de ses erreurs." ;
    schema:about place:91121 .

review:91121_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Des meufs avec des grosses lunettes, des mecs avec des casquettes et des barbes. Heureusement pas moyen de monter leur fixie au 7e étage." ;
    schema:about place:91121 .

review:91121_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Tres stylé! Vue magnifique" ;
    schema:about place:91121 .

review:91121_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Vue magnifique..." ;
    schema:about place:91121 .

review:91121_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Enfin un vrai rooftop à Paris. Super tacos !" ;
    schema:about place:91121 .

review:91121_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Trop cool hipster endroit avec la vue sur Paris!! Chill out time :)" ;
    schema:about place:91121 .

review:91121_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Pour y aller sans attendre, réserver au restaurant : juste en dessous de la terrasse, un menu unique, savoureux, et un service impec. Profitez ensuite de la vue pour un dernier verre. On a aimé !" ;
    schema:about place:91121 .

review:91121_r14 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Superbe rooftop avec une vue magnifique sur les toits de Paris et la butte Montmartre !" ;
    schema:about place:91121 .

review:91121_r15 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Super vue et une bonne ambiance" ;
    schema:about place:91121 .

review:91121_r16 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Je pense que le paysagiste de la terrasse a demissioné ;)" ;
    schema:about place:91121 .

review:91121_r17 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Stop on arrête tout: j'ai lu bcp de choses négatives sur ce lieu, j'ai même failli annuler la résa et en fait c'était parfait.Accueil adorable dès la porte d'entrée, service top & vue imprenable donc." ;
    schema:about place:91121 .

review:91121_r18 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "C'est le rooftop à la mode en ce moment. Les conso sont un peu chères mais la vue vaut le détour." ;
    schema:about place:91121 .

review:91121_r19 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Soirée Elle Man. Inès est la tout va bien !!!" ;
    schema:about place:91121 .

