review:83794_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Riende furieux. Musique en sourdine. Accueil au bar plus que froid. Pas du tout ouverts...peut-être une mauvais soir. Mais, pas envie de tenter à nouveau l'expérience" ;
