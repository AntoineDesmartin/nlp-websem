    schema:reviewBody "Service is very slow" ;
    schema:about place:83966 .

review:83966_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "La salle en haut est plus calme surtout en journée avec des canapés et des fauteuil. La terrasse est toujours prise d'assaut. Diner servis pas très tard (apres 22h pas possible !)" ;
    schema:about place:83966 .

review:83966_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Ben O'Sullivans gider bir turist tavsiye etmiyorum, ben restoran içinde otururken yanımdaki sandalyede bir Canon EOS 1100D çaldı. Müşterileri için tehlikeli bir yer" ;
    schema:about place:83966 .

review:83966_r6 a schema:Review ;
