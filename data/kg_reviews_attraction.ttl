    schema:about place:85846 .

review:85846_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Les traditionnels bouquinistes des quais de la Seine ne connaissent pas la crise avec leurs 900 « boîtes » et 300 000 livres réparties sur plus de 3 kilomètres. Ils font partie du paysage parisien" ;
    schema:about place:85846 .

review:85846_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "- petite ballade à faire par tout les temps a Paris les quai de Seine avec ces nombreux bouquinistes , ces magnifiques ponts et on peut apercevoir et y faire un tour en bateau mouches .!" ;
    schema:about place:85846 .

