    schema:about place:85628 .

review:85628_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Late night hangout for the college crowd. The Wall is the most popular bar. Lots of restaurants but most are so-so. Homeless people sleep here during the day" ;
    schema:about place:85628 .

review:85628_r9 a schema:Review ;
    schema:author "Anonymous" ;
