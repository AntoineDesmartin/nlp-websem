    schema:about place:83489 .

review:83489_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "La place dauphine est un spot de pétanque idéal pour de grosses parties entre amis ! Vous aurez toujours de la place pour jouer, et des bancs sont à disposition pour prendre l’apéro." ;
    schema:about place:83489 .

