    schema:reviewBody "bâtiment incroyable" ;
    schema:about place:83523 .

review:83523_r76 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Jet lag or not jet lag you can do it." ;
    schema:about place:83523 .

review:83523_r77 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le salon rétro avec des chaines pires qu'arte est à faire !" ;
