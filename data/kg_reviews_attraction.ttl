review:83523_r203 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Culturez-vous!" ;
    schema:about place:83523 .

review:83523_r204 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Always changing and always the same, the Pompidou has a great permanent collection and temporary exhibits. Don't get put off by queues, walk straight up if you're not interested in a specific show." ;
    schema:about place:83523 .

review:83523_r205 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Go on 6th floor to enjoy picturesque city view" ;
    schema:about place:83523 .

review:83523_r206 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Prendre l'escalator pour aller tout en haut voir cette belle vue !" ;
