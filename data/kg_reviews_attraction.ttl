review:83707_r20 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Lido - худшее, что мне пришлось видеть. Впервые в жизни я просто встала и вышла, не дождавшись конца. Скукота смертельная. Идите в Мулен Руж! Вот там безумная энергетика и шоу." ;
    schema:about place:83707 .

