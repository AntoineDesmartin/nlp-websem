review:84733_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Complètement taré le serveur véner qui balance une assiette à côté des clients. Pas accueillant, c'est le moins qu'on puisse dire." ;
    schema:about place:84733 .

review:84733_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le tartare et l'entrecôte : toujours à la carte, toujours divins !" ;
    schema:about place:84733 .

review:84733_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Bonne ambiance! C'est toujours agréable d'y prendre un verre." ;
    schema:about place:84733 .

review:84733_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Saumon tika, magret de canard au miel et gingembre, tiramisu et crème brûlée, tout est délicieux et à un prix très correct, très bonne adresse!" ;
    schema:about place:84733 .

review:84733_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Assiette genereuse, Très bon rapport qualité prix. Service et conseil efficace. Une vraie bonne adresse. Bruyant comme il faut!" ;
    schema:about place:84733 .

review:84733_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Mon bar préféré dans le 19ème bon pas cher serveurs pour la plupart très sympas et ambiance quartier fêtard au bord du canal... Je recommande la côte de bœuf" ;
    schema:about place:84733 .

review:84733_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Vin du mois: Petit Roubier - cabernet Sauvignon - bio. Et le verre: 3,10 euros, une merveille!!" ;
    schema:about place:84733 .

review:84733_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Bonne cantine. Très bonne entrecôte sauce bleu" ;
    schema:about place:84733 .

review:84733_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Great food, awesome bartenders, good music & a fun, local, dive-bar vibe. Came here every night of our trip & will be coming back next time we're in town!" ;
    schema:about place:84733 .

review:84733_r10 a schema:Review ;
    schema:author "Anonymous" ;
