    schema:about place:84397 .

review:84397_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Des rhum arrangé super bon !" ;
    schema:about place:84397 .

review:84397_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le merle moqueur c'est ça... Une bonne ambiance de la musique rétro qui fait chanter tout le monde et ce depuis plus de quinze ans que j'y vais." ;
