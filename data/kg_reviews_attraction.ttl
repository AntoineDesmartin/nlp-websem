review:90689_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un nouveau bar vin qui cache un bar à cocktail. J'attaque avec un Old Fashion. On verra." ;
    schema:about place:90689 .

review:90689_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Great new wine/cocktails/ whisky bar!" ;
    schema:about place:90689 .

review:90689_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Margarita 10€ = 5 gros glaçons carré dans un verre a whisky, que reste-t-il comme place pour le cocktail ? Hein ! Et ne comptez pas sur des olives ou le sourire de la serveuse. Pas validé !" ;
    schema:about place:90689 .

review:90689_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "** : Bar à vin sympa en afterwork dans un quartier plutôt connu pour ses nuits agitées. Deuxième salle avec musique et fumoir. Vin au verre à partir de 5€." ;
    schema:about place:90689 .

review:90689_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Cocktail: awful. Barman: awful. People: awful. Only go here if you feel you did something bad in a past life and need to punish yourself." ;
    schema:about place:90689 .

review:90689_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Sympa, ambiance à la cool, malgré des barman un peu relouds ..." ;
    schema:about place:90689 .

review:90689_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un bar à vin chic qui planque un bar à cocktail canaille, qui mène à un salon de tatouage pas sage. Piste de danse transparente au-dessus de la cave et fumoir caché derrière un miroir (tlj 18h - 2h)" ;
    schema:about place:90689 .

review:90689_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un lieu pour se montrer et etre vu... Trop de bobos et de hipsters au mètre carré!" ;
    schema:about place:90689 .

review:90689_r8 a schema:Review ;
