review:83446_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Drink a beer with a friend. Meet randmoly some old friends" ;
    schema:about place:83446 .

review:83446_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Have a go at the Mojitos while sitting on the terasse and enjoying the hood's life and colorful inhabitants." ;
    schema:about place:83446 .

review:83446_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Cheap beer, great ambiance, and dont forget to treat the peanut vendor!" ;
    schema:about place:83446 .

review:83446_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un thé a la menthe lapres midi ou une biere le soir avec coucher de soleil ... Pas Cher du tout!!!!" ;
    schema:about place:83446 .

review:83446_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Pas cher, ensoleillé en fin de journée et toujours des chaises en rab ! Garçons sympas en plus !" ;
    schema:about place:83446 .

review:83446_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Lumières rouges, zinc, graph et tags... La plateforme de Belleville - on boit, on se voit, on se montre - bobo ? Enfin, comme peut l'être péniblement Belleville. Tant mieux alors!" ;
    schema:about place:83446 .

review:83446_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Cheap beers. And you may run into The Yosh Nerims." ;
    schema:about place:83446 .

review:83446_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Come early if you wish a sit outside..." ;
    schema:about place:83446 .

review:83446_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Cool bar, cheap beer, urban vibe where arty meets street with neon lights to boot!  Its all about the terrace babe morning, noon and night !" ;
    schema:about place:83446 .

review:83446_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Well, what can I say. It's my second home." ;
    schema:about place:83446 .

review:83446_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Une des pintes moins chères de Paris.. 4€" ;
    schema:about place:83446 .

review:83446_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Place to be for a laid-back evening in a shady, tagged up alley. Cheap drinks, lucky if they play your kinda music." ;
    schema:about place:83446 .

review:83446_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un demi en terrasse avec un paquet de cacahuète acheté au vieux marchand ambulant, what else?" ;
    schema:about place:83446 .

review:83446_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Térasse sympas l'été, quartier vivant et bière pas chère. Bien bondé le soir" ;
    schema:about place:83446 .

review:83446_r14 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "“Paris”, de Cedric Klapisch: El profesor Verneuil (Fabrice Luchini) persigue a suamante y la descubre mientras besa a su novio real. El la llama por teléfono mientras la espía y ella lo despacha." ;
    schema:about place:83446 .

review:83446_r15 a schema:Review ;
    schema:author "Anonymous" ;
