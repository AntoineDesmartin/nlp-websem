review:83523_r105 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "L'affluence au Centre Pompidou varie beaucoup en fonction des expositions en cours Evitez donc si possible les mois de juin, septembre et février (Période de changements d'expositions)." ;
