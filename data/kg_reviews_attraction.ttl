review:83489_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "A quiet, secluded square in the middle of the city centre; nice restaurants and cafes, pétanque players, a gem." ;
    schema:about place:83489 .

review:83489_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Plusieurs cafés autour tres agreables , mais le mieux etant d apporter son apero son jeu de petanque et passer la soiree en petit groupe aves des amis !" ;
    schema:about place:83489 .

review:83489_r5 a schema:Review ;
