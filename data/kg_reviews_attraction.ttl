review:83482_r16 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Lieu unique à Paris où vous pourrez déguster de délicieux couscous/tajines. L'été il est très agréable de prendre le thé sur le patio & profiter ensuite d'1 visite guidée de la mosquée (3€ l'entrée)" ;
    schema:about place:83482 .

review:83482_r17 a schema:Review ;
