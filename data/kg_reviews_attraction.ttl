review:83793_r61 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Si vous souhaitez fumer vous pouvez oublier ce lieu! Videurs à l entrée, videurs à la sorties, videurs pour fumer, videurs pour manger .... Fumer tue certes mais qd même ... Laissez moi sortir !!!!!" ;
    schema:about place:83793 .

review:83793_r62 a schema:Review ;
    schema:author "Anonymous" ;
