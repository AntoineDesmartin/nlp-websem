review:89931_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Pas encore tout à fait fini, le DBALFDM est le bar geek ultime, je l'aime d'amour." ;
    schema:about place:89931 .

review:89931_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Sympa, mais trop de monde ce soir la. Victime de son succès. À refaire plus tard. On s'est finalement rabattu sur Victoria Cross à côté, moins hype mais serveuse sympa ;-)" ;
    schema:about place:89931 .

