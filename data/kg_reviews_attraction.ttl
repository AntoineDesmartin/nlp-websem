review:83384_r28 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Old school American bar, they make a good manhattan. Apparently the real thing to do is late night in the downstairs piano bar. (3 of 4 petals via Fondu)" ;
    schema:about place:83384 .

