review:83358_r22 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Bartender was really friendly & understood a little English. We had the cheese and cold cuts platter with a glass of wine. Sheer rustic, Parisian charm. A quintessential Parisian experience." ;
    schema:about place:83358 .

review:83358_r23 a schema:Review ;
