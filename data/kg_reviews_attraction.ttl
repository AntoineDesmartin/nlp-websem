review:83523_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Museum SO nice !" ;
    schema:about place:83523 .

review:83523_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Très bonne exposition permanente ! à voir voir et à revoir." ;
    schema:about place:83523 .

review:83523_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Bought a wooferang !" ;
    schema:about place:83523 .

review:83523_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "View from the top floor is great and is open late. Free the first Sunday of every month!" ;
    schema:about place:83523 .

review:83523_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "GO there before 4pm" ;
    schema:about place:83523 .

review:83523_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Sympa sauf là galerie 2 sur Lucien freud c est vulgaire" ;
    schema:about place:83523 .

review:83523_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Visit the museum in the morning so it's less crowded. However u have to visit the 6em floor in the evening. The sunset is just beautiful." ;
    schema:about place:83523 .

review:83523_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "1er espace exclusivement dédié aux adolescents d'une grande institution culturelle. Rencontres d'artistes, workshops, expériences inédites autour d'œuvres interactives, soirées et week-end festifs..." ;
    schema:about place:83523 .

review:83523_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Buy your tickets at the machines, right next to ticketcounter: no line there, nice :)" ;
    schema:about place:83523 .

review:83523_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "L'entrée pour la bibliothèque est située à l'autre côté du bâtiment." ;
    schema:about place:83523 .

review:83523_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Maybe the best architecture downtown" ;
    schema:about place:83523 .

review:83523_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "RDV en haut lieu de l’art contempo parisien. Un tuyau ? il porte le nom d’un président de la république française." ;
    schema:about place:83523 .

review:83523_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Inauguré en 1977, le centre Pompidou accueillait en 2006 6,6 millions de visiteurs par an[1], ce qui en fait la troisième institution la plus visitée en France" ;
    schema:about place:83523 .

review:83523_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Love the museum architecture, they always have great exhibitions, the restaurant on top have superb view" ;
    schema:about place:83523 .

review:83523_r14 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The cinematheque has tributes to great directors and thematic festivals. Recent retrospectives have included homages to Jean-Luc Godard, and Canadian film director Guy Maddin. Click for more." ;
    schema:about place:83523 .

review:83523_r15 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Bien vu la billetterie automatique - cher le billet" ;
    schema:about place:83523 .

review:83523_r16 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Accueil glacial et snob. Photos interdites, enfants pas les bienvenus salles banales . Allez faire  un tour a la Tate ou au MOMA pour découvrir ce que peut être un musée d'art contemporain" ;
    schema:about place:83523 .

review:83523_r17 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The Restaurant at the top of Centre Pompidou is a rip-off, and has no good food to offer. Better get something outside, but don't forget to take the \"Paris from above impressions\" with you." ;
    schema:about place:83523 .

review:83523_r18 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Restaurant / cafe panoramique au dernier étage a ne pas louper !" ;
    schema:about place:83523 .

review:83523_r19 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Rue des Archives, à côté du Centre, l'atelier de Renzo Piano" ;
    schema:about place:83523 .

review:83523_r20 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "On apprécie l architecture atypique." ;
    schema:about place:83523 .

review:83523_r21 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le laisser passer vaut le coup !" ;
    schema:about place:83523 .

review:83523_r22 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Une pensée pour Pompidou, qui n'a pas invente la fête de la musique mais donne envie d'aimer la France et même la politique (presque)" ;
    schema:about place:83523 .

review:83523_r23 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Venir tôt pour avoir de la place. Et sinon...Chuuuuuuuuuuuuut !!!" ;
    schema:about place:83523 .

review:83523_r24 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Nice museum :)" ;
    schema:about place:83523 .

review:83523_r25 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Des expos temporaires incontournables !" ;
    schema:about place:83523 .

review:83523_r26 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "TRAVEL FACT: The Centre Pompidou features the leading collection in modern and contemporary art in Europe." ;
    schema:about place:83523 .

review:83523_r27 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Love this place" ;
    schema:about place:83523 .

review:83523_r28 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "A surprisingly good modern and contemporary art museum. Interesting exterior architecture, fantastic permanent contemporary art collection." ;
    schema:about place:83523 .

review:83523_r29 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "L'un des musées incontournables de la capitale, avec un notoriété internationale du à son architecture gigantesque et extravagante en plein centre de Paris, sans compter les différentes collections." ;
    schema:about place:83523 .

review:83523_r30 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "VERY GOOD art collection." ;
    schema:about place:83523 .

review:83523_r31 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Fermé le mardi." ;
    schema:about place:83523 .

review:83523_r32 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "As well as the exhibitions and cinema, you can also enjoy stunning panoramic views of the city from the top floor here." ;
    schema:about place:83523 .

review:83523_r33 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "view from the top of the museum is one of my favorite! there is also a nice restaurant there. if you enjoy modern art and architecture (you do, right?), then you'll love this place." ;
    schema:about place:83523 .

review:83523_r34 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "L'un des musée d'art contemporain les plus connus de la capitale, il fait beaucoup parler de lui autant pour son architecture extérieure originale que pour ses expositions décalées." ;
    schema:about place:83523 .

review:83523_r35 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "the best of the best in modern french art" ;
    schema:about place:83523 .

review:83523_r36 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Premier espace d'exposition dédié aux adolescents, le Studio 13/16 accueille des jeunes artistes qui présentent leurs oeuvres ou animent des ateliers autour de thématiques trimestrielleS." ;
    schema:about place:83523 .

review:83523_r37 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Retrouvez ici le Musée national d'art moderne et contemporain, l'Ircam, la Bibliothèque Publique d'Information, la Bibliothèque Kandinsky, deux salles de cinéma et deux salles de spectacle." ;
    schema:about place:83523 .

review:83523_r38 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "\"Paris - Delhi - Bombay\" (noch bis 19. 9. 2011) ist eine fantastische Ausstellung." ;
    schema:about place:83523 .

review:83523_r39 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "On ne s'y ennuie jamais ! Un incontournable de l'Art et du Design à visiter et revisiter." ;
    schema:about place:83523 .

review:83523_r40 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The temporary exhibition about India is amaazing" ;
    schema:about place:83523 .

review:83523_r41 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un grand terrain de jeux où l'on peut passer d'exquises heures entre modernisme et post-modernisme." ;
    schema:about place:83523 .

review:83523_r42 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "At the shop of the museum you will find a great variety of notebooks!" ;
    schema:about place:83523 .

review:83523_r43 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Don't forget to get an ice cream in amorino!;) right in front!" ;
    schema:about place:83523 .

review:83523_r44 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The line is a bit long but moves fast.  Current exhibitions have a 30 minute wait time" ;
    schema:about place:83523 .

review:83523_r45 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "La boutique de livre est une vrai mine d'or !" ;
    schema:about place:83523 .

review:83523_r46 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "In a very unique building, this modern art museum has some of the world’s best works, but visitors often miss the panoramic view from the balconies." ;
    schema:about place:83523 .

review:83523_r47 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Sube a tomar algo al George, vale la pena" ;
    schema:about place:83523 .

review:83523_r48 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "This huge, unique complex in Beaubourg is home to the Musée National d'Art Moderne. What makes this place unique is the unconventional funct" ;
    schema:about place:83523 .

review:83523_r49 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The temple of modernity, this building designed by Renzo Piano and Richard Rogers is one of the hottest cultural spots in Europe. Place Georges Pompidou +info: www.mylifeisgorgeous.com" ;
    schema:about place:83523 .

review:83523_r50 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "toujours quelque chose d'intéressant à voir !" ;
    schema:about place:83523 .

review:83523_r51 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Restaurant Georges is a perfect stop off after an afternoon of taking in the art at the Centre Pompidou downstairs. We love lounging on the terrace with a cocktail while we scope the city views." ;
    schema:about place:83523 .

review:83523_r52 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Parisians love to hate the painfully modern architecture of the Centre Pompidou, so the building is worth seeing just to get a feel for the design which has sparked so much local controversy." ;
    schema:about place:83523 .

review:83523_r53 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Best museum in Paris, especially if you appreciate modern art" ;
    schema:about place:83523 .

review:83523_r54 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Check out the panoramic view of the city from the top floor." ;
    schema:about place:83523 .

review:83523_r55 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le plus cool, plus intéressant musée d'art contemporain!" ;
    schema:about place:83523 .

review:83523_r56 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "si tu aimes l'art contemporain... Sinon il y a le Georges, resto chic avec vue imprenable tout en haut du centre Pompidou mais attention à la note... très salée et le service pas terrible" ;
    schema:about place:83523 .

review:83523_r57 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "One of the most colorful and experimental museum facades in the world. Check out Atelier Brancusi, a recreation of Constantin Brancusi's studio, a sculptor most interested in form and flight." ;
    schema:about place:83523 .

review:83523_r58 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "There usually is a free public wifi for 60 minutes. Just login to the open AP and enter any address in your browser for registration screen." ;
    schema:about place:83523 .

review:83523_r59 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Simplesmente lindo por dentro e por fora!" ;
    schema:about place:83523 .

review:83523_r60 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Visit their library, bookshop, movie theater and a panoramic terrace. The library boasts a collection of 450,000 books, 2,600 magazines and a large number of new media items. Cool!" ;
    schema:about place:83523 .

review:83523_r61 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "A great spot to fill you w/ the passionate work of modern artists." ;
    schema:about place:83523 .

review:83523_r62 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Favorite single spot in Paris... Chill vibes aplenty :) Forget the so-called posh restaurant on top, it's not in line with the spirit of place" ;
    schema:about place:83523 .

review:83523_r63 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The exhibition \"Dance your life\" in Gallery 1has blown my mind! ) if you get the chance to see it, don't turn it down! The exhibition will be on till 2 April!" ;
    schema:about place:83523 .

review:83523_r64 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Buy something at Souvenirs Store." ;
    schema:about place:83523 .

review:83523_r65 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "watch out for static (electricity) when using the escalators!  and watch out for the stops!" ;
    schema:about place:83523 .

review:83523_r66 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Par exemple : essaye la glace à la vanille au sel de mer. On ne trouve pas de meilleur dessert en ville !" ;
    schema:about place:83523 .

review:83523_r67 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Musée simplement génial on attends peu et il y a des œuvres superbes. Les expos ont toujours un point de vue et une mise en scène différente de ce que l'on a l'habitude de voir." ;
    schema:about place:83523 .

review:83523_r68 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "grat place! contemporany art, library and coffee :)" ;
    schema:about place:83523 .

review:83523_r69 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Give yourself plenty of time to explore the fantastic collection of modern art. Don't miss the installations!" ;
    schema:about place:83523 .

review:83523_r70 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Modern age architectural designs! Nice view as well" ;
    schema:about place:83523 .

review:83523_r71 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Beber algo en la cafetería. Es un poco caro pero las vistas merecen la pena." ;
    schema:about place:83523 .

review:83523_r72 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Prenez la carte a l anneee 20 euros seulement si moins de 26 ans/ acces illimite a tout / mieux que free / Bim boom !" ;
    schema:about place:83523 .

review:83523_r73 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "closed on tuesday... good to know when it's tuesday lol" ;
    schema:about place:83523 .

review:83523_r74 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Pass auf ! so eine lange Linie für Ticket :-(" ;
