    schema:about place:83482 .

review:83482_r19 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Génial pour savourer un thé et un narguilé. Attention tout de même à l'endroit où l'on s'assoit en térasse. Il y a beaucoup d'oiseaux et donc... dangereux !" ;
    schema:about place:83482 .

review:83482_r20 a schema:Review ;
    schema:author "Anonymous" ;
