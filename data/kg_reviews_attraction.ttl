review:83735_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le son n'est pas suffisamment fort et le sol de la fosse est mouvant ! Ça n'a pas empêcher de profiter comme il fallait de Nicolas Jaar et Acid Pauli ! Belle salle - bel univers !" ;
    schema:about place:83735 .

review:83735_r13 a schema:Review ;
