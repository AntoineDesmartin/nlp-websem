review:85345_r20 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "La lumière" ;
    schema:about place:85345 .

review:85345_r21 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un havre de paix en plein cœur de la ville. Les petits cafés sous les arcades sont chers mais plein de charme." ;
    schema:about place:85345 .

review:85345_r22 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "A l’abri du tumulte de la ville, le somptueux Jardin du Palais Royal et ses nombreuses allées ombragées offrent aux joueurs plus sages un terrain de jeu frais et serein." ;
    schema:about place:85345 .

review:85345_r23 a schema:Review ;
    schema:author "Anonymous" ;
