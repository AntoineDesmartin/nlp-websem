review:89236_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "This former pick-up bar has been transformed into a mini-museum of the Soviet era, complete w/ constructivist look,ancient walls covered in tatty newspapers of the time and a mix of vintage furniture…" ;
    schema:about place:89236 .

review:89236_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Good Caipiroska (and quite cheap during Happy Hour), good rock n' roll, funny interior design and comfy sofas!" ;
