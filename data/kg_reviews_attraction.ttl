review:83372_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Service désagréable. Endroit cher. Ambiance bof." ;
    schema:about place:83372 .

review:83372_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un endroit atypique à Paris. Bonne musique avec chanteuse live le soir au resto. À faire !" ;
    schema:about place:83372 .

review:83372_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le Ice Bar est sympa, mais c'est un peu l'usine." ;
    schema:about place:83372 .

review:83372_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "J'y suis allé. Vrt bien. J'ai fait un article sur mon blog : http://www.parisdc.fr. Enjoy." ;
    schema:about place:83372 .

review:83372_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Beaucoup trop cher pour un diner de tapas de cocktail branché qu'ils appellent Finger Food ! Service inexistant, musique nulle." ;
    schema:about place:83372 .

review:83372_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Brunch décontracté parmi les meilleurs de Paris. Les enfants sont les bienvenus." ;
    schema:about place:83372 .

review:83372_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "L'un des meilleurs brunchs de Paris (qualité, variété, cadre et accueil agréables), un vrai coup de cœur." ;
    schema:about place:83372 .

review:83372_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "They could tell the staff to be more welcoming... Big rooms but very average service" ;
    schema:about place:83372 .

review:83372_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "incredible." ;
    schema:about place:83372 .

review:83372_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le. Quartier dénote avec l ambiance du lieu" ;
    schema:about place:83372 .

review:83372_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Très chouette accueil lors d'une privatisation" ;
    schema:about place:83372 .

review:83372_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "A faire au moins une fois entre amis : doudoune, fun & -15 !" ;
    schema:about place:83372 .

review:83372_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Sympa pour l'ambiance igloo en plein Paris mais quartier d'apparence pas très \"safe\"" ;
    schema:about place:83372 .

review:83372_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un diner amusant dans une ambiance lounge réussie, surtout après avoir bu les cocktails du ice bar. Trois soirées, toutes inoubliables." ;
    schema:about place:83372 .

review:83372_r14 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Try their \"Menu de degustation\" then chilled out in the ICE BAR!" ;
    schema:about place:83372 .

review:83372_r15 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Atypique ! A faire entre amis très bons cocktails" ;
    schema:about place:83372 .

review:83372_r16 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "- Éclairage et musique / + concept et verre de glace. En 30min c'est quand même assez expéditif ! A faire ... Mais pas à refaire!" ;
    schema:about place:83372 .

review:83372_r17 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Great place to stay in Paris." ;
    schema:about place:83372 .

review:83372_r18 a schema:Review ;
