review:84133_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Au programme ce soir pour la Fête de la Musique: 36h de concerts gratuits dans un cadre exceptionnel. En prime, chaque artiste interprétera l’œuvre liturgique de son choix." ;
    schema:about place:84133 .

review:84133_r11 a schema:Review ;
