review:84814_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Best bar around (Farrrrr)" ;
    schema:about place:84814 .

review:84814_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "De loin le bar le plus sympathique de tout le quartier...Clientèle jeune et pas prétentieuse !" ;
    schema:about place:84814 .

review:84814_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Animé du soir au matin, charcuterie et fromage, vin français, rouges et blancs, wifi, artistes et compagnie. Toute la simplicité des batignolles !" ;
    schema:about place:84814 .

review:84814_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Joli cocktail pour la perte du AAA !" ;
    schema:about place:84814 .

review:84814_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "La planche est fantastique, Les prix aussi.." ;
    schema:about place:84814 .

review:84814_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Les Caves Populaires, c’est un véritable coup de coeur, une adresse typiquement Parisienne à ne pas rater, pour une pause tranquille le midi ou au contraire un bain de foule bobo le soir." ;
    schema:about place:84814 .

review:84814_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "A must-see, typically Parisian. Great to chill in the afternoon or to hangout with your so bourgeois friends at night. Simple and efficient." ;
    schema:about place:84814 .

review:84814_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le plus grand des serveurs est bien cute !" ;
    schema:about place:84814 .

review:84814_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Très sympa, pas cher mais tout petit" ;
    schema:about place:84814 .

review:84814_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le café est à 1€ en salle et au comptoir" ;
    schema:about place:84814 .

review:84814_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Skvělé místo kousek od Montmartru, takřka kultovní, doporučené místními. Plné mladých lidí. Neformální." ;
    schema:about place:84814 .

review:84814_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le café servit en verre sur une planche en bois avec du Wifi correct, toujours appréciable !" ;
    schema:about place:84814 .

review:84814_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Des prix bas et de la bonne qualité! Génial" ;
    schema:about place:84814 .

review:84814_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Super bar (à vins), pas cher, bon et blindé. Les planches sont à améliorer mais avec un rapport qualité/prix comme ça, ça passe. Pensez à venir tôt, c'est vide impossible de s'assoir." ;
    schema:about place:84814 .

