review:86105_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Built in 1928, it used to be called \"center court\", but the name changed to \"court Philippe Chatrier\" in 2011 in commemoration of the former president of the FFT. Its has a capacity of 15 000 seats." ;
    schema:about place:86105 .

review:86105_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "La Fédération Française de Tennis organise le tournoi de Roland Garros depuis 1920. Roland Garros est le 2e Grand Chelem de l'année. Le seul sur terre-battue" ;
    schema:about place:86105 .

review:86105_r9 a schema:Review ;
