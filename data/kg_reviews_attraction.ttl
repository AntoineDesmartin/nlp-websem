review:84071_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Once the most fashionable church in 19th-century Paris, the Neo-Gothic Basilique Ste-Clotilde is best known for its imposing twin spires." ;
    schema:about place:84071 .

review:84071_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Construction of the church was first mooted by the Paris City Council in February 16, 1827. It was designed by architect F. C. Gau of Cologne in a neo-Gothic style. Work began in 1846, opened in 1857" ;
    schema:about place:84071 .

review:84071_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Come for the epic organ music. Composer Camille Saint-Saens played the organ here." ;
    schema:about place:84071 .

review:84071_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Enjoy The lushious park just behind The church." ;
    schema:about place:84071 .

review:84071_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Pour son square, son coeur, ses hauteurs, et le souvenir de Philippe Noiret, un immense acteur au grand coeur, dont la cérémonie d'enterrement a eu lieu dans ces murs... en décembre 2006" ;
    schema:about place:84071 .

review:84071_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "é muito linda;;;" ;
    schema:about place:84071 .

