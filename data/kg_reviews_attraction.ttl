review:83523_r107 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The Pompidou Center hosts the largest museum for modern art in all of Europe. Try the entrance located at the back for a quicker entrance into the National Museum of Modern Art!" ;
    schema:about place:83523 .

review:83523_r108 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Modern mimarinin güzel bir örneği. Sürekli koleksiyonu harika. Süeli sergileri de takiop etmeli. Biz Edward Munch sergisine denk gelmiştik, müthiş bir deneyimdi." ;
    schema:about place:83523 .

review:83523_r109 a schema:Review ;
