review:83615_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Good if you have some time to kill. I like the tapestries & especially seeing the original statues from the front of Notre Dame.  Nice park to get out of the noisy streets and have a break." ;
    schema:about place:83615 .

review:83615_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Exposition sur l'art du moyen-âge slovaque. À perdre la tête !" ;
