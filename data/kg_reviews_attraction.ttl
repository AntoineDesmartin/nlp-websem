    schema:about place:83735 .

review:83735_r23 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "La salle est intimiste juste comme il faut et la voix de Ryan Tedder est incroyable. Excellent concert de OneRepublic." ;
    schema:about place:83735 .

review:83735_r24 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Authentic parisian concert hall...not tiny but small enough to make a concert feel intimate. Beers are overpriced but that should come as no surprise" ;
    schema:about place:83735 .

review:83735_r25 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Love to hear music here" ;
    schema:about place:83735 .

review:83735_r26 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Avec Orange RockCorps, 4 heures de ton temps à 1 association = 1 place pour le  concert exclusif de Jessie J, Oxmo Puccino & Dj Cut Killer le 11 juillet  au Trianon, Paris !" ;
    schema:about place:83735 .

review:83735_r27 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Nice hall. Good view from almost everywhere. You can stand or watch from the balcony (sold seperately). Acoustic is OK. Could be better. One of the top 3 in Paris." ;
    schema:about place:83735 .

review:83735_r28 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "If you don't have ticket, don't worry. Come a little earlier and you can find one from the blackmarket ;) Be prepared to pay double the face value and always do bargain!" ;
