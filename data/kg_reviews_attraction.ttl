review:83650_r29 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Les plats sont correctes mais sans plus, et assez chers. La chef de salle qui se balade avec ton talkie-walkies pour rendre compte de l'avancée de votre repas ... Allez juste a coté chez Bruno!" ;
    schema:about place:83650 .

review:83650_r30 a schema:Review ;
