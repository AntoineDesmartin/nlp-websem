review:83384_r19 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "While can’t say whether or not Harry’s has the best martini in Europe (we haven’t finished trying them all yet!), it’s definitely one of the finalists." ;
    schema:about place:83384 .

review:83384_r20 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "It may be a New York bar upstairs, but the basement is full-on piano bar" ;
    schema:about place:83384 .

review:83384_r21 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The pennant for \"John Hopkins\" and is wrong. It's \"Johns Hopkins\" don't know why but that bothers me." ;
    schema:about place:83384 .

review:83384_r22 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Good cocktails, perfect service, reasonable prices, nice atmosphere... What else?" ;
    schema:about place:83384 .

review:83384_r23 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le seul bloody mary potable de paname" ;
    schema:about place:83384 .

review:83384_r24 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Try the cocktails and hot dogs" ;
    schema:about place:83384 .

review:83384_r25 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Excellents cocktails! Ambiance typique! Plus intime et jazzy en bas!" ;
