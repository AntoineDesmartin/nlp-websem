review:86576_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Une horreur cet endroit puant de pots d'echappement, bruyant de moteurs, dangereux de roues, encombré de voitures.... Que font les gendarmes ? Elles sont toutes garées n'importe comment !" ;
