review:84393_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Happy hours pour les étudiants jusqu'à la fermeture les lundis et mardis. Excellente musique pop/rock la plupart du temps. Excellente carte d'alcools divers et variés." ;
    schema:about place:84393 .

review:84393_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Awesome bar, dedicated to making foreigners feel welcome. Themed nights and free drinks are always packed full of fun people. Talk to the bartenders, they are interesting people." ;
