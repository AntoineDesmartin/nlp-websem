review:83523_r193 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "L'expo Lichtenstein est aussi belle qu'inspirante! Bien curatée d'ailleurs : verbatims de l'artiste et décryptage des experts.Bon merchandising, comme toujours : adulte ou enfant nous sommes servis !" ;
    schema:about place:83523 .

review:83523_r194 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Assolutamente imperdibile se vi si trova a Parigi: collezione permanente praticamente completa del panorama artistico dal 1904 al alla fine degli anni '60, e le esposizioni temporanee sono curate!" ;
    schema:about place:83523 .

review:83523_r195 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Que cela soit de l'intérieur ou de l'extérieur, le lieu est magnifique ! Les expos sont toujours intéressantes malgré une foule de plus en plus importante !" ;
    schema:about place:83523 .

review:83523_r196 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Fantastico" ;
    schema:about place:83523 .

review:83523_r197 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Waste of time..." ;
    schema:about place:83523 .

review:83523_r198 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Certainement une des plus intéressantes collections d'art moderne de France. De très belles expos temporaires de \"têtes d'affiche\" du XXe siecle" ;
    schema:about place:83523 .

review:83523_r199 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Bellissima la mostra di Roy Lichtenstein. Eccezionali la vista di Parigi e lo splendido ristorante panoramico!!" ;
    schema:about place:83523 .

review:83523_r200 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Fantastic exhibition of Roy Lichtenstein." ;
