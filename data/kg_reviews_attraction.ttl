review:83401_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Club de salsa" ;
    schema:about place:83401 .

review:83401_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "A éviter : 2 services, un à 20h, l'autre à 22h. Mais comme ceux de 20h ne partent pas on y mange à minuit avec une attente incroyable. La bouffe est semblable à celle d'une cantine..." ;
    schema:about place:83401 .

review:83401_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Mojito et danse salsa ! Muy caliente ! More men than women last time I was there. Be warned !" ;
    schema:about place:83401 .

review:83401_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Mui frio, on s'est retrouvé sous l'airco. Ambiance sympa, salsa time. Service dinatoire rustique." ;
    schema:about place:83401 .

review:83401_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Bonne ambiance ! =)" ;
    schema:about place:83401 .

review:83401_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "A prendre au bar : Le ti'punch qui est en fait un Gro'Punch ^^" ;
    schema:about place:83401 .

review:83401_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "assez sympa pour la danse et l'ambiance mais si vous n'êtes pas des habitués vous vous faites déloger illico presto. trop de monde, s'abstenir" ;
    schema:about place:83401 .

review:83401_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Ambiance sympa. Pour les non-habitués, ne regardez pas les autres danser, c'est décourageant." ;
    schema:about place:83401 .

review:83401_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Bonne ambiance et bon esprit pour cette première fois en tout cas. Énormément de monde aux cours par contre mais sympas pour soirée." ;
    schema:about place:83401 .

review:83401_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Arrivée vers 19h30 pour le cours débutant. Heureusement les filles comme les mecs sont vraiment très débutant. Le cours dure une heure. Ensuite à 20h30 cours niveau deux un peu plus avance" ;
    schema:about place:83401 .

review:83401_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Entrée à 10 € (1 boisson comprise, option pour 2 boissons) et vestiaire 2 €.  Si vous payez en liquide il faut demander au caissier sur la droite du bar.  Possibilité de dîner sur place." ;
    schema:about place:83401 .

review:83401_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Souvent plus de babas que de mecs car les mecs n'osent pas danser. Il suffit de 2 cours débutants pour commencer à se débrouiller. Ne pas hésiter à inviter les filles..." ;
    schema:about place:83401 .

review:83401_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Lieux ideal pour debuter en salsa a paris" ;
    schema:about place:83401 .

review:83401_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Cours de Bachata débutant de 18h30 à 19h30 ensuite cours de kizomba débutant suivi d'intermédiaire de 19h30 à 21h30 ; Pour terminer , soirée jusqu'à 2h ." ;
    schema:about place:83401 .

review:83401_r14 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Super cours de Salsa ! Et pourtant j'étais hyper débutante." ;
    schema:about place:83401 .

review:83401_r15 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Ne sait pas ce qui est le pire entre le service déplorable, les cheveux dans la carafe d'eau, les mojitos sans saveur, les insectes dans la salade et le prix excessif..." ;
    schema:about place:83401 .

review:83401_r16 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Very nice if you like salsa, you can follow lessons" ;
    schema:about place:83401 .

