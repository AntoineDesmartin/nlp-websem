review:85417_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "“I wouldn't mind dying in a plane crash. It'd be a good way to go. I don't want to die in my sleep, or of old age, or OD. I want to feel what it's like. I want to taste it, hear it, smell it..." ;
    schema:about place:85417 .

review:85417_r9 a schema:Review ;
