review:90262_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Nouveau spot à Paris, chill au possible, ambiance au top !" ;
    schema:about place:90262 .

review:90262_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Nouveau lieu super sympa pour sortir prendre un verre avec ses potes sans se prendre la tête !" ;
    schema:about place:90262 .

review:90262_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Best terrace in Paris. Arrive early to get a deckchair and enjoy the sun!" ;
    schema:about place:90262 .

review:90262_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Une très belle terrasse qui surplombe la voisine du Wanderlust. Idéal pour prendre un verre. Le must reste le transat au soleil." ;
    schema:about place:90262 .

review:90262_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Endroit très cool. Je recommande !" ;
    schema:about place:90262 .

review:90262_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "LA terrasse parfaite!" ;
    schema:about place:90262 .

review:90262_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Great outdoor terrace in Paris! Especially in the summer! It's terrific!! Love this place! Summer terrace of 2013!" ;
    schema:about place:90262 .

review:90262_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Terrasse plus qu'agréable un soir d'été!" ;
    schema:about place:90262 .

review:90262_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Pas du tout surfait, bouteille pas du tout trop chère (et de qualité), vraiment, un coucher de soleil à 20h30 \"au juste prix\". Changez rien, vous êtes énormes ...." ;
    schema:about place:90262 .

review:90262_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Ne pas passer à coté des burger potatoes" ;
    schema:about place:90262 .

review:90262_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The place to be cet été. Une immense terrasse et des conso un peu chères." ;
    schema:about place:90262 .

review:90262_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Terrasse sans fin, chill au top, bonne ambiance, consos à prix raisonnable, goooooo !" ;
    schema:about place:90262 .

review:90262_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Gens quali, Terasse au top, ambiance chill & international. Seal of quality. La bouteille de blanc est a 30€, pinte 8€ et un conseil, venez avant 20h pour pas faire la queue." ;
    schema:about place:90262 .

review:90262_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Arrive early to get a seat! The caipirinas are yummy! 👌" ;
    schema:about place:90262 .

review:90262_r14 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Awesome bar above the Seine!" ;
    schema:about place:90262 .

review:90262_r15 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "On dirait Beziers !" ;
    schema:about place:90262 .

review:90262_r16 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "On y boit des coups après le boulot pour y admirer le coucher de soleil, ou on profite d’une journée ensoleillée. De nombreuses soirées sont organisées les mercredis et jeudis tout au long de l’été." ;
    schema:about place:90262 .

review:90262_r17 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Prend une bouteille de rosé. Cale toi dans un transat et écoute le son de dingue. On est top sur le rooftop" ;
    schema:about place:90262 .

review:90262_r18 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "A mi me encanta ese lugar la música esta cabrona hay footballito muy divertido y las viejas esta de no mames! Muy recomendable" ;
    schema:about place:90262 .

review:90262_r19 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Cocktail moyen à 12 euros, 5 le demi, pas de pinte, serveur qui se la pète, fermeture de la terrasse/ transat à  20h, ensuite parquage et file d attente." ;
    schema:about place:90262 .

review:90262_r20 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Paysage et terrasse (avant 20h)  sympas, mais serveur condescendant et finalement pas très compétent (cocktail très moyen). Ok, mais ça se la pète." ;
    schema:about place:90262 .

review:90262_r21 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Cet endroit sent le vomi." ;
    schema:about place:90262 .

review:90262_r22 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Arriver tôt pour avoir sa table. Sinon le son est top, les burgers sont bons et l'ambiance bon enfant !" ;
    schema:about place:90262 .

review:90262_r23 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Fabuleux roof top! Camion de Burgers (8€) très bon, et le rosé se boit comme du petit lait!" ;
    schema:about place:90262 .

review:90262_r24 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "*** : Juste au-dessus du Wanderlust, une immense terrasse sur le toit la cité de la mode. Bonne ambiance pas trop jeune. Musique moyenne. Stand burgers. Pinte 8€, Rosé bt 30€ un peu cher. Arriver tôt!" ;
    schema:about place:90262 .

review:90262_r25 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Bouffe pas trop mal, mais service bof." ;
    schema:about place:90262 .

review:90262_r26 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Super cool bar!! Great music and awesome people! Definitely recommended!" ;
    schema:about place:90262 .

review:90262_r27 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Il paraît que c'est le lieu qu'il faut découvrir. Une très belle vue et des conso un peu chères" ;
    schema:about place:90262 .

review:90262_r28 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "This shee cray!" ;
    schema:about place:90262 .

review:90262_r29 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Pas de vin après 23h? I'm not Rotschild bitch!" ;
    schema:about place:90262 .

review:90262_r30 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Great terassa ! Lot of people during summer time ! Good music. Not expensive at all ! Everyone from everywhere in paris comes there." ;
    schema:about place:90262 .

review:90262_r31 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Belle terrasse de jour comme de nuit, bon dj´s, boissons de base, mais bonne ambiance... Venir tôt pour choper une table, en revanche, good luck pour le transat !" ;
    schema:about place:90262 .

review:90262_r32 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The place ou ne pas être. A moins de vouloir craquer son PEL en vêtements maquillage et boissons. Good luck!!" ;
    schema:about place:90262 .

review:90262_r33 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Burger is good worth waiting 10€/20 min waiting" ;
    schema:about place:90262 .

review:90262_r34 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Les consos sont chères, le soundsystem pas terrible, et l'entrée parfois trop aléatoire. L'équipe a un l'air un peu désorganisée. Mais beau lieu." ;
    schema:about place:90262 .

review:90262_r35 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "This rooftop bar by the team behind Le Baron is the perfect summer spot in Paris. The restaurant is open all-year round but next door Wanderlust offers a cheaper and better alternative." ;
    schema:about place:90262 .

review:90262_r36 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Très très bon lieu, mais un peu chère. L'ambiance c'est super et la musique aussi!" ;
    schema:about place:90262 .

