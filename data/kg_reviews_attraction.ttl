review:83926_r38 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "First come first served (unlike most speakeasy's). Speak English. Dress lightly; it's hot in this small room. Open until 5AM. Drinks are 12 euros. Traditional drinks like Manhattan are well executed." ;
    schema:about place:83926 .

review:83926_r39 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Les meilleurs cocktails de Paris (avec le Park Hyatt Vendome ;)). Le meilleur endroit pour décompresser après une journée de boulot bien stressante :D" ;
    schema:about place:83926 .

review:83926_r40 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Highly recomended. Secret and supercool spot. Drinks are insane" ;
    schema:about place:83926 .

review:83926_r41 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Seriously incredible!!! Any speakeasy aficionados will LOVE this place!!!" ;
    schema:about place:83926 .

review:83926_r42 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Great crowd and mix of people from Paris and out of town at this cozy cocktail spot. Make friends with cute bartenders and try the Experience #1.  Or a couple of them." ;
    schema:about place:83926 .

review:83926_r43 a schema:Review ;
