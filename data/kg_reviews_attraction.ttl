    schema:author "Anonymous" ;
    schema:reviewBody "Go to Ourcq Bar in the spring and play pétanque besides the canal. You can take your drink with you." ;
    schema:about place:84846 .

review:84846_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Jouer aux dés avec du saucisson offert par la maison." ;
    schema:about place:84846 .

review:84846_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Emrunter un transat pour profiter du soleil au bord du bassin de la Villette." ;
    schema:about place:84846 .

review:84846_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "L'un des meilleurs spots de l'été pour jouer à la pétanque au bord du canal !" ;
    schema:about place:84846 .

review:84846_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Jeux de société à disposition !" ;
    schema:about place:84846 .

review:84846_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "mon after .... du dimanche après-midi :-) ambiance familiale et décontractée .." ;
    schema:about place:84846 .

review:84846_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Mojitos et autres cocktails à 4 euros !" ;
    schema:about place:84846 .

review:84846_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Prêt de boules de pétanque, verres éco, saucisson au comptoir, jeux de société, et même des Anglais qui proposent du Pimm's le samedi ! J'adore." ;
    schema:about place:84846 .

review:84846_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Super ambiance avec des barmans très accueillants et des consos cheap!!! J adore ce bar!" ;
    schema:about place:84846 .

review:84846_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "good spot, surtout l'été pour boire son verre au bord du canal. Barmans sympas. Et prix corrects. Quelques tapas offerts sur le bar : une générosité rare à Paris !" ;
    schema:about place:84846 .

review:84846_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Top pour un dimanche soir. Bon son avec Dj le week-end. Mojito 5€, verre de rosé 3€..." ;
    schema:about place:84846 .

review:84846_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Parfait lors des beaux jours pour prendre un verre et on peut aussi y emprunter un jeu de pétanque, un transat." ;
    schema:about place:84846 .

review:84846_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Pétanque, jeux de société, saucisson en LS. Bons djs set et clientèle très sympa. L'un de mes endroits préférés." ;
    schema:about place:84846 .

review:84846_r14 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Excellent :D" ;
    schema:about place:84846 .

review:84846_r15 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Testé par l'Apéro du Jeudi : Demandez les boules de pétanques au bar pr jouer sur les quais! Petit pichet de blanc très sympa." ;
    schema:about place:84846 .

review:84846_r16 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Ne pas venir lorsque Paris Plage est là : barricade en face du canal, pas de place pour jouer ni pour transater..." ;
    schema:about place:84846 .

review:84846_r17 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Boules de pétanque, jeux, terrasse, un très bon spot pour l'été! Un bar ou il fait bon vivre." ;
    schema:about place:84846 .

review:84846_r18 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Ambiance sympathique au bord du canal. On peut prendre des verres \"à emporter\" !" ;
    schema:about place:84846 .

review:84846_r19 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Cocktails à 5 euros, qui dit mieux? #bardedjeunes" ;
    schema:about place:84846 .

