review:83973_r18 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Cocktails dingues (pour 11 à 12 euros) et DJ sets les week-ends.A noter : depuis la rentrée, buvez madison n'est plus à la direction artistique" ;
