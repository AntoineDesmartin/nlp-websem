review:89236_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Soviet place to visit in Paris. Ici vous vous retrouvez en Russie, la grande la belle la communiste. Enfin pas trop, car les cocktails tu les payes 8€. Bondé de monde le samedi. Babyfoot au sous sol." ;
    schema:about place:89236 .

review:89236_r4 a schema:Review ;
