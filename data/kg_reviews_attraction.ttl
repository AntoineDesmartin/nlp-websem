review:86181_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "2nd biggest court in the Roland Garros stadium with 10 000 seats. Built in 1994 & Named after the legendary French female player Suzanne Lenglen" ;
    schema:about place:86181 .

review:86181_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Bienvenue sur le court Suzanne Lenglen. RDV le 27 mai pour le début du tournoi jusqu'au 8 juin pour la demi-finale Dames 2012! Partagez toutes vos passions sur la page Orange Fan!" ;
    schema:about place:86181 .

review:86181_r5 a schema:Review ;
    schema:author "Anonymous" ;
