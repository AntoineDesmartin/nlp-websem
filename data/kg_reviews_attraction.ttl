review:83358_r16 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Fixez-vous sur un vin et choisissez une planche parmi les grands classiques du genre (fromage, charcut’ ou mixte) et vous voilà parrés pour passer un début de soirée très agréable." ;
    schema:about place:83358 .

review:83358_r17 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Chose a wine and a \"planche\" of delicatessen/cheese and you'll be all set for a great evening. Beware, bar closes at 10pm." ;
