review:85920_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Bassin de 50 mètres découvert a partir de juin, attention beaucoup de monde quand il fait beau" ;
    schema:about place:85920 .

review:85920_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Au premier rayon, les mamies et les kékés sortent leurs nichons. Peu de pudeur en dehors du bassin..." ;
    schema:about place:85920 .

review:85920_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Piscine de 50m intéressante pour faire des longueurs sans être trop gêné dans la ligne d'eau. (Si les gens respectent les lignes par niveau)" ;
    schema:about place:85920 .

review:85920_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Bassin de 50m fermé du 4 au 17 mars 2013." ;
    schema:about place:85920 .

review:85920_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Pts positifs : casiers ne nécessitant pas de pièce, personnel sympa, eau pas trop chlorée. Pts négatifs : anarchie ds l'organisation des lignes, beaucoup d'enfants jouant directement ds le gd bassin" ;
    schema:about place:85920 .

review:85920_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Rooftop is now open!" ;
    schema:about place:85920 .

review:85920_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le bonnet de bain est obligatoire même si on ne mouille pas sa tête... je n'y retournerai pas." ;
    schema:about place:85920 .

review:85920_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "1 seul mot:dégueulasse!Les vestiaires,l'eau,tout! Des tampons et serviettes igieniques qui traînaient sur le sol! Et la femme de ménage qui inonde le sol avec de l'eau en guise de ménage! Plus jamais!" ;
    schema:about place:85920 .

review:85920_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un beau solarium et une piscine assez grande. D'autre part, avec les beaux jours beaucoup de monde" ;
    schema:about place:85920 .

review:85920_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "J'ai adore cette piscine pour les cours du Lundi soir" ;
    schema:about place:85920 .

review:85920_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Ambiance pop l'été, j'adore. Entrée chère (5.90 EUR) en saison haute mais le bassin est bien staffé et régulé." ;
    schema:about place:85920 .

review:85920_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le meilleur endroit de Paris pour aller nager en nocturne, à ciel ouvert. Tous les jours pdt l'été jusqu'à 21h!" ;
    schema:about place:85920 .

review:85920_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Ouverte le 15 août de 08h à 19h" ;
    schema:about place:85920 .

review:85920_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "À retester en été. Peut-être. En attendant, les vestiaires étaient sales et glauques. La dame à l'entrée, pas franchement accueillante." ;
    schema:about place:85920 .

review:85920_r14 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Ouverte le 1er novembre de 8h à 19h !" ;
    schema:about place:85920 .

review:85920_r15 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Ouverte le 11 novembre de 8h à 19h !" ;
    schema:about place:85920 .

