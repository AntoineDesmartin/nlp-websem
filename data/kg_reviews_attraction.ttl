review:83461_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Stendhal (30e division), les frères Concourt (13e), Berlioz (20e), Edgar Degas (4e)" ;
    schema:about place:83461 .

review:83461_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Some of what you can see at the Montmartre Cemetery" ;
    schema:about place:83461 .

review:83461_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Vous pouvez vous recueillir sur les tombes de ceux qui ont marqué la France et la culture : Goncourt, Renan, Stendhal, Zola, Degas, Berlioz, Berger, Charcot, Guitry, Dalida et bien d’autres encore." ;
    schema:about place:83461 .

