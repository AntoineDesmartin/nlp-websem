review:85345_r18 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Uno de mis sitios favoritos en Paris. Tranquilo y familiar. Piedes leer tranquilamente mientras los niños corretean." ;
    schema:about place:85345 .

review:85345_r19 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Very delicate, quiet and full of flowers. Ideal to write letters and to be out of time..." ;
