    schema:author "Anonymous" ;
    schema:reviewBody "Ça yes les travaux sont fini!!!" ;
    schema:about place:84196 .

review:84196_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Les nouveaux aménagements de la place de la République en images !" ;
    schema:about place:84196 .

review:84196_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Vivement l'ouverture du resto-bar et de sa terrasse !" ;
    schema:about place:84196 .

review:84196_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Après un an et demi de travaux, la place de la République rénovée, embellie, a été dévoilée le 16 juin. Une R de jeux pour les enfants, un café en plein air, un miroir d'eau, et des chaises à dispo..." ;
    schema:about place:84196 .

review:84196_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Venez découvrir la renovation. Une réussite" ;
    schema:about place:84196 .

