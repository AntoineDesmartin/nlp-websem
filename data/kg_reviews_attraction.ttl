review:83748_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "C'est ici que depuis 2009, des milliers de bénévoles ont assisté aux concerts de David Guetta, Sexion d'assaut, Busta Rhymes, NERD et plein d'autres... en échange de quelques heures de leur temps !" ;
