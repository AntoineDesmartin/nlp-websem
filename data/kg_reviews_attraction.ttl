review:90453_r15 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "*** : Passez la porte et découvrez un endroit magnifiquement décoré et cosy. La carte présente une quinzaine de cocktails comme l'excellent Pear-sing (env 14€). Pour RdV galant ou posé entre amis." ;
    schema:about place:90453 .

review:90453_r16 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "BarChick fell in love with this place. Pull up a pew at the bar or grab a spot on the mezzanine and watch the action from above http://barchick.com/find-a-bar/paris/little-red-door" ;
    schema:about place:90453 .

review:90453_r17 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "L'eau d'antan: one of the best cocktail of my life. You definitely have to try it!" ;
