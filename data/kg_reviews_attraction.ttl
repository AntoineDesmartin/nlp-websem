review:91875_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Ouverture du bar à 19h, beaucoup d'attente. Cocktails entre 5 et 7 euros, peu de place a l'intérieur." ;
    schema:about place:91875 .

review:91875_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Beaucoup de queue un peu déçue que ce soit si petit. Mais des cocktails entre 5 et 7 € nous font oublier ces détails !" ;
    schema:about place:91875 .

review:91875_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Les cocktails sont bons mais impossible de s'asseoir confortablement pour les déguster ou d'en reprendre un 2ème à cause de la queue. Petit bonus : Pouvoir repartir avec une photo Polaroïd." ;
    schema:about place:91875 .
