review:83321_r57 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Excellent food and fun atmosphere. Beef tartar appetizer and black cod main dish was incredible! Highly recommend it. Wine is very pricey though..." ;
