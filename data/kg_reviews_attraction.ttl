review:83256_r33 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "It’s one of our favorite alfresco drink spots in the summer months (and even into the winter, thanks to patio heaters)." ;
    schema:about place:83256 .

review:83256_r34 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Bon Brunch, saucisse aux herbes mémorable, un peu blindé et bruyant, véranda dans la verdure, décor sympa, service souriant. Un endroit qui donne envie de revenir !" ;
    schema:about place:83256 .

review:83256_r35 a schema:Review ;
