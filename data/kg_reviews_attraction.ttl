review:87286_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Niki de Saint-Phalle donnera son nom à l’archipel de cinq îles artificielles au niveau du Port du Gros Caillou, et bientôt la promenade  André Gorz sur les berges, le musée d’Orsay et le Quai Branly." ;
    schema:about place:87286 .

review:87286_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "On est bien" ;
    schema:about place:87286 .

review:87286_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Enfin un vrai coin convivial et authentique à Paris!" ;
    schema:about place:87286 .

review:87286_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Terrasses bondées, arriver tot" ;
    schema:about place:87286 .

review:87286_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Très agréable surprise parisienne." ;
    schema:about place:87286 .

review:87286_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Il y a des tables avec plateaux de jeu intégrés, il suffit d emprunter les pièces dans une guérite à côté! Il y a aussi un grand mur d ardoise avec des craies et des ateliers tout l été! Sympa!" ;
    schema:about place:87286 .

review:87286_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Bcp de terrasses et une promenade sympa!" ;
    schema:about place:87286 .

review:87286_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Pasar la noche frente al rio con tu novia y un picnic. La gente viene bien vestida y pasan los barcos con turistas." ;
    schema:about place:87286 .

review:87286_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Mientras tanto tu novia te prepara un canape de salmon o caviar (previamente comprados en Carrefour market) y toman un vino rose frio a la vista de la tour de Eiffel y el punte de la Concorde!" ;
    schema:about place:87286 .

review:87286_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Des activités, des terrasses et une promenade ... Idéal pour profiter de l'été à Paris" ;
    schema:about place:87286 .

review:87286_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Très agréable. De nombreuses activités et les jardins flottants sont top!" ;
    schema:about place:87286 .

review:87286_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Nice pedestrian area along the river with some great cafes. Perfect place to get out of the sun and down a bottle of rosé" ;
    schema:about place:87286 .

review:87286_r12 a schema:Review ;
