    schema:reviewBody "Avant il y avait un serveur hyper sympa qui s'appelait Frederic... Mais la aujourd'hui, franchement détestable!" ;
    schema:about place:84781 .

review:84781_r23 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Avant il y avait un serveur hyper sympa qui s'appelait Frederic... Mais la aujourd'hui, franchement détestable!" ;
    schema:about place:84781 .

review:84781_r24 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Superb. If you need anything, ask for Louis." ;
    schema:about place:84781 .

review:84781_r25 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Résolution pour 2012 : n'allez plus n'importe où ... venez chez nous ! Resolution for 2012: Don't go anywhere ... come home !" ;
    schema:about place:84781 .

review:84781_r26 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Est-ce votre jour de chance? Grâce à Voyager Pratique, tentez de gagner votre séjour au Terrass Hôtel ! Is it your lucky day ? Thanks to Voyager Pratique, try to win your stay at the Terrass Hotel !" ;
    schema:about place:84781 .

review:84781_r27 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Très bon brunch dans un cadre relaxant. Très bon produits pour le buffet. Penser à réserver. Situé au pied de la butte Montmartre" ;
    schema:about place:84781 .

review:84781_r28 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "La plus belle vue, ambiance, cadre, quartier... One of my favorite place in Paris" ;
    schema:about place:84781 .

review:84781_r29 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The kind of brunch where you have to take a main course. Only that it is excellent !" ;
    schema:about place:84781 .

review:84781_r30 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Très très bon, la terrasse au 7 eme est paisible le brunch du dimanche reposant et les chambres très pratiques, ne pas se refuser la suite..." ;
    schema:about place:84781 .

review:84781_r31 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Il faut monter au moins une fois là-haut pour admirer la superbe vue sur la capitale. Installez-vous dans un transat...bullez ! A tester un jour sans vent." ;
    schema:about place:84781 .

review:84781_r32 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "book a room facing the city for best views and visit the Mountmontre cemetery below for beautiful mausoleums and sculptures of people who came and lived before tv and internet and smart phones." ;
    schema:about place:84781 .

review:84781_r33 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "If you need help.. Lisa is the right person .. thank you Lisa :)" ;
    schema:about place:84781 .

