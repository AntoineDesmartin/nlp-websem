    schema:author "Anonymous" ;
    schema:reviewBody "Les Termes de Cluny" ;
    schema:about place:83615 .

review:83615_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "It's in this national museum where you'll get to learn about the country's history during the Middle ages. Most notable features include the breathtaking tapestries of The Lady and the Unicorn." ;
    schema:about place:83615 .

review:83615_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Art et histoire du Moyen Âge français et parisien + Thermes gallo-romains et collections Antiquité + Orient médiéval Domaines : sculpture, vitrail, orfèvrerie, enluminures, peintures, etc." ;
    schema:about place:83615 .

review:83615_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Dimanche au musée !" ;
    schema:about place:83615 .

review:83615_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "This 17th century mansion in the Marais which is one of the largest worldwide contains most of the collections of Paris-based Pablo Picasso (1881-1973)" ;
    schema:about place:83615 .

review:83615_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "A Museum about French Middle Age and the Cluny abbey ; the building is also built on top of Gallo-Roman thermal baths, of which you can see remains and the still up frigidarium." ;
    schema:about place:83615 .

