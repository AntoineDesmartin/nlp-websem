    schema:reviewBody "Sympathique endroit pour pique-niquer, mais bruyant à cause des gamins...." ;
    schema:about place:83503 .

review:83503_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "A voir absolument!" ;
    schema:about place:83503 .

review:83503_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un cadre historique pour pique-niquer, faire une partie de pétanque ou juste se poser entre amis." ;
    schema:about place:83503 .

review:83503_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "A Gallo-Roman amphitheater from the 1st century AD, it could seat more than 15,000 people, and was used as a theater, circus (wild animals and gladiatorial contests) and sporting arena." ;
    schema:about place:83503 .

review:83503_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Idéalement placé dans le 5e arrondissement de Paris, proche des métros place Monge et Cardinal Lemoine..." ;
    schema:about place:83503 .

review:83503_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "This  amphitheater, which could hold 15,000 people, is where ancient sports were played, circuses were held, and gladiator fights took place. A great place to learn more about the city's history." ;
    schema:about place:83503 .

review:83503_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un lieu atypique en plein Paris ! A voir !" ;
    schema:about place:83503 .

review:83503_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Concours de pétanque aux beaux jours de Mai-Juin, et toujours aussi agréable en journée pour l'insonorisation.Eviter les recoins la nuit cependant..." ;
    schema:about place:83503 .

review:83503_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Accédez depuis le Square des Arènes à un hotspot Wifi Orange et surfez en toute liberté sur votre mobile ou votre tablette ! Téléchargez l'appli Wifi Orange !" ;
    schema:about place:83503 .

review:83503_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Arena romana em Paris" ;
    schema:about place:83503 .

review:83503_r14 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Joli endroit  mais dommage qu'il y ait autant d'enfant ..." ;
    schema:about place:83503 .

review:83503_r15 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Ici, c'est une zone Paris Wifi. Votre ordi sur les genoux au milieu des vestiges romains, c’est tout le charme des Arènes de Lutèce qui s'offrent à vous." ;
    schema:about place:83503 .

review:83503_r16 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "First time!" ;
    schema:about place:83503 .

review:83503_r17 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Faites un retour en arrière là où les gladiateurs s’affrontaient à l’époque gallo-romaine ! Il s’avère que cet amphithéâtre offre aujourd’hui un terrain de jeu parfait pour les boulistes en herbe !" ;
    schema:about place:83503 .

review:83503_r18 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Excellent spot pour la pétanque niché au cœur du 5eme arrondissement.Attention le gardien chasse les visiteurs a 21h15 l'été et ça ne traîne pas !" ;
    schema:about place:83503 .

review:83503_r19 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un partie de pétanques, que c'est bon !" ;
    schema:about place:83503 .

review:83503_r20 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "A genuine Roman arena, right in the middle of Paris. Sit down, unpack your lunch and watch the men playing boules in the arena. Marvel at how calm and quiet it is here." ;
    schema:about place:83503 .

