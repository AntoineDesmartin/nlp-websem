review:83926_r19 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Classé 7ème meilleur bar au monde d'après le NY Times, ECC reste un lieu incontournable de la capitale pour tout amateur de cocktails qui se respecte. Adresse fortement recommandée :)" ;
