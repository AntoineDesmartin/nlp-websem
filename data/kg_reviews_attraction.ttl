review:91211_r775 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "A few tips for visiting the Eiffel Tower: Bring cash, be aware that there's swimming at the overlook spot above it, and, if you want to get to the top, be prepared to walk or pay to use the tram." ;
    schema:about place:91211 .

