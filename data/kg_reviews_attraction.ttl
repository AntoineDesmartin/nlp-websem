    schema:author "Anonymous" ;
    schema:reviewBody "Carlsberg Éléphant is The best beer in the world!" ;
    schema:about place:83384 .

review:83384_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "For lunch try The Club Sandwich ranked amongst the best ten in town!" ;
    schema:about place:83384 .

review:83384_r12 a schema:Review ;
    schema:author "Anonymous" ;
