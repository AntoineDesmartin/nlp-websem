review:85349_r63 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le célèbre maitre Gims attend son cocktail au Bar La Vue du Hyatt Regency Paris Etoile avant de rejoindre Vanessa Caffin pour son interview." ;
    schema:about place:85349 .

review:85349_r64 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Bar La Vue, montez au 34eme Ciel….notre équipe vous accueille tous les jours à partir de 17H00…  The Bar La Vue, climb 34th floors to Heaven .... our team welcomes you every day at 5:00 p.m. ..." ;
    schema:about place:85349 .

review:85349_r65 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Les équipes de 1day1film immortalise votre séjour et vous offre le plus beau des cadeaux : un souvenir.http://www.youtube.com/watch?v=6ZbDfvCKXec" ;
    schema:about place:85349 .

review:85349_r66 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Maitre Gims n’enlève jamais ses lunettes noires de soleil…Pour son interview au Bar La Vue il décide pourtant de se mettre à nu  http://bit.ly/InterviewMaitreGims" ;
    schema:about place:85349 .

review:85349_r67 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Enfin un soleil éclatant...en direct du Bar La Vue Profitez-en pour siroter un cocktail rafraichissant du haut de Paris" ;
    schema:about place:85349 .

review:85349_r68 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Des événements plein la vue... Pour toute demande de privatisations, contactez : parhr-rfp@hyatt.com" ;
    schema:about place:85349 .

review:85349_r69 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "A bright sunshine, caring bartenders, refreshing cocktails: such good pretexts to discover the Bar’s new menu !" ;
    schema:about place:85349 .

review:85349_r70 a schema:Review ;
    schema:author "Anonymous" ;
