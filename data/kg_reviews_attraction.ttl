    schema:about place:83650 .

review:83650_r28 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le service est un peu long. Il faut faire signe aux serveurs pour qu'ils s'occupent de vous. Prix un peu élevés.  Thé à 4, 50 € par exemple." ;
