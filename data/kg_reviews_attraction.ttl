review:89887_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Terrasse très agréable, bon son, serveurs très attentifs et surprise : no alcool ! Vous pouvez egalement fumer le narguilé. Cet hiver ouverture d'un espace restaurant avec concerts.. Can't wait !" ;
    schema:about place:89887 .

review:89887_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Première saison, pas encore de licence IV (pas d'alcool). Grande terrasse top. Étonnant que ce ne soit pas + beautiful people, peut-être trop grand (plus beauf actuellement). Gros potentiel qd même." ;
    schema:about place:89887 .

review:89887_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Service toujours aussi peu efficace 2 bruschettas pour 8 et donc on peut boire. Pas moi Coca 0 ! L'endroit est si beau quel dommage ! Le coucher de soleil +++++" ;
    schema:about place:89887 .

review:89887_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "If you like to wait 75minutes for a really bad sandwich, then you'll love this place." ;
    schema:about place:89887 .

review:89887_r4 a schema:Review ;
