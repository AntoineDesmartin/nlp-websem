review:84761_r31 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Voir des concerts de musique plus ou moins bruyante, bouger ses cheveux, finir sa bière assis sur le quai, parler à des inconnus, éviter les flaques de pisse et les camions de pompiers. Gagner." ;
    schema:about place:84761 .

review:84761_r32 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Starting in early spring, Point Ephémère’s crowds spill out onto the Quai, sitting along the canal sipping beers and chattering away until the early hours in the morning." ;
    schema:about place:84761 .

review:84761_r33 a schema:Review ;
