review:85295_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le Baron is a private nightclub and has since become one of the most popular clubs in Paris. You can expect a select scene and possible celebrity-sightings inside this intimate hot spot." ;
    schema:about place:85295 .

review:85295_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un cocktail Le Baron à la main, le TDA crew derrière les platines !" ;
    schema:about place:85295 .

review:85295_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Absolutely no coherence to the DJ's set. Hip hop to honky tonk to alt rock. It's a jarring ride on a small dance floor" ;
    schema:about place:85295 .

review:85295_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "la coupe de champagne est hors de prix et les cocktails sont fous, club de darons mais la déco par l'artiste André est folle" ;
    schema:about place:85295 .

review:85295_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le club ultra select créé par André est souvent classé comme l'un des lieux les plus branché de la capitale. Il est vrai que les soirées organisées par La Clique y sont folles." ;
    schema:about place:85295 .

review:85295_r14 a schema:Review ;
