review:85349_r79 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The view is incredible as are the prices." ;
    schema:about place:85349 .

review:85349_r80 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Must-go-to bar in Paris. Best view of the town at day or at night. At night, wait for the Eiffel Tower to twinkle every hour on the hour." ;
    schema:about place:85349 .

review:85349_r81 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The view is perfect. Especially after midnight w/ the different colors of the Eiffel Tower. Music's great, cocktail awesome, perfect ambiance for a chill friday night." ;
    schema:about place:85349 .

