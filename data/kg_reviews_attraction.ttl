review:90612_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Si vous aimez l'exercice intensif, cet immeuble est fait pour vous. Pour les plus audacieux, prendre l'appartement au dernier étage." ;
