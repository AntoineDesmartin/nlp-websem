review:85349_r75 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le 21 Juin, ça swing au Bar La Vue ! Les amoureux de Paris et ses oiseaux de nuit vivront ce soir la musique aux accents de Jazz." ;
    schema:about place:85349 .

review:85349_r76 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Vous avez aimé Norbert dans Top Chef? Vous allez l'adoré dans Pitch Elevator! Toujours égal à lui-même il ira même jusqu'à faire des révélations choc http://bit.ly/InterviewNorbert" ;
    schema:about place:85349 .

review:85349_r77 a schema:Review ;
    schema:author "Anonymous" ;
