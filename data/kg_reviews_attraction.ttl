review:83256_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "don't forget to book an after diner room at the hotel" ;
    schema:about place:83256 .

review:83256_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Yeah" ;
    schema:about place:83256 .

review:83256_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Je vais vous raconter l’histoire de ce malade qui s’est pointé un soir dans ma chambre d’hôtel. Un putain d'énergumène." ;
    schema:about place:83256 .

review:83256_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "This place RAWKS! Be sure to request the courtyard when making a dinner reso." ;
    schema:about place:83256 .

review:83256_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "love this small hotel, only thing is the rooms don't have phones. each room is designed uniquely by local designers. great bistro in the hotel" ;
    schema:about place:83256 .

review:83256_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "PARIS. Sit outside for a fun and lovely late night dinner." ;
    schema:about place:83256 .

review:83256_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Personnel pourri !" ;
    schema:about place:83256 .

review:83256_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Bel endroit, mais bruyant sur la terrasse. A préférer pour les soirées entre amis plutôt que les dîners intimistes." ;
    schema:about place:83256 .

review:83256_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Room 301 is fab! Very atmospheric lighting and LOTS of black gloss paint EVERYWHERE, display case on one wall filled with issues of photo, zoom, SAS novels and Bruce 0ss 117 novels. Very cool." ;
    schema:about place:83256 .

review:83256_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Carte peu fournie et service atroce et hyper loooonnng!" ;
    schema:about place:83256 .

review:83256_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Très sympa sauf le service !!" ;
    schema:about place:83256 .

review:83256_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Great shooting in the Green Room with Airway+TheSponk" ;
    schema:about place:83256 .

review:83256_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Loving the \"Parra\" room... the art is amazing. Staff super kind." ;
    schema:about place:83256 .

review:83256_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Les meilleures tables sont dans le jardin du fond." ;
    schema:about place:83256 .

review:83256_r14 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Toujours aussi bien...verrière du fond un peu bruyante..." ;
    schema:about place:83256 .

review:83256_r15 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "J'aime : le poulet & ses légumes rotis, et aussi la salade de fruits : yummy!" ;
    schema:about place:83256 .

review:83256_r16 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Aussi magique que le nom qu'il porte le bar de cet hôtel et sa terrasse sont tout simplement majestueux les nuits d'étés" ;
    schema:about place:83256 .

review:83256_r17 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Ils sont desagréable et se la pétent grave. Les chambres sont sweet. C'est vrai..." ;
    schema:about place:83256 .

review:83256_r18 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Best french toasts in town... Great terrasse for brunchs. Staff is nice, prices are reasonnable" ;
    schema:about place:83256 .

review:83256_r19 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Accueil & service à revoir... Dommage car le cadre est sympa !" ;
    schema:about place:83256 .

review:83256_r20 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Si les serveuses etaient aussi sympa que le lieu est beau, ce serait parfait! Malheureusement, elles gachent tout!" ;
    schema:about place:83256 .

review:83256_r21 a schema:Review ;
