review:91341_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The new place to be" ;
    schema:about place:91341 .

review:91341_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "**** : Probablement LE spot de cet été 2013. Petit frère du Rosa Bonheur sur les quais de Seine, asseyez-vous avec une bouteille de rosé en regardant passer les péniches et en admirant le Grand Palais" ;
    schema:about place:91341 .

review:91341_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Parfait quand il fait beau! Incontournable" ;
    schema:about place:91341 .

review:91341_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le spot de l'été. Une blanche, quelques tapas et l'apres midi au bord de la Seine. Prix un peu élevés mais la vue le justifie." ;
    schema:about place:91341 .

review:91341_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Awesome spot to grab a drink and apetizers in the summer!" ;
    schema:about place:91341 .

review:91341_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Sympa l'idée mais il faut aimer la foule et faire la queue!" ;
    schema:about place:91341 .

review:91341_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Accueil tres sympathique / lieu tres agreable" ;
    schema:about place:91341 .

review:91341_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le Rosa Bonheur et son esprit guinguette s'exporte sur les Berges !" ;
    schema:about place:91341 .

review:91341_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le rosé est meilleur..., mais fait toujours aussi mal! #place2be anyway" ;
    schema:about place:91341 .

review:91341_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un peu bondé mais cadre agréable" ;
    schema:about place:91341 .

review:91341_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Que du bonheur: de la tapenade, du rosé, coucher soleil au dessus du Pont Alexandre III et le Grand Palais, des jolies filles et des hipsters ... Voila voila" ;
    schema:about place:91341 .

review:91341_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Beaucoup de monde donc très sympa le samedi soir seul bémol pas beaucoup de musique et ferme plutôt tôt. 4€ le Ricard et 9€ hard (cher car sans le goût de l'alcool)" ;
    schema:about place:91341 .

review:91341_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Les poufs au fond sont parfaits mais faites des commandes groupées ou vous passerez la soirée a aller chercher des verres." ;
    schema:about place:91341 .

review:91341_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Trop de monde. Victime de son succès." ;
    schema:about place:91341 .

review:91341_r14 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Heaven on the Seine" ;
    schema:about place:91341 .

review:91341_r15 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Commencer votre soirée festive ici !" ;
    schema:about place:91341 .

review:91341_r16 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Perfect spot! Ambiance décontractée, vue époustouflante, prix raisonnables, jeux de société for free. The place to be on summer 2013. Service au bar par contre." ;
    schema:about place:91341 .

review:91341_r17 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Real nice. Le verre à 3,50€, la bouteille de rosé à 21€. Environnement sympa, ultra chill." ;
    schema:about place:91341 .

review:91341_r18 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "La queue pour les boissons est à droite ! La queue de gauche (jouer lente) n'est que pour la bouffe ! :-)" ;
    schema:about place:91341 .

review:91341_r19 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Très cool pour un apéro entre potes mais venez tôt pour choper une table et du rosé!" ;
    schema:about place:91341 .

review:91341_r20 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Endroit très cool, la bouteille de rosé a 21€. Par contre trop de queue pour manger ce qui est dommage ! Population très sympa et vue magique !" ;
    schema:about place:91341 .

review:91341_r21 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "on retrouve l'esprit de Rosa bonheur... Rose, charcuteries, plateaux de fromage... la vue sur le Grand Palais est la cerise sur le gâteau" ;
    schema:about place:91341 .

review:91341_r22 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Très sympa ! On y accède par le pont Alexandre 3. Je vous conseille le hot dog sauce curry mangue :) super pour un apéro au soleil en sortant du boulot. Allez y tôt pour pas ne attendre trop longtemps" ;
    schema:about place:91341 .

review:91341_r23 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Nice, cozy,  let's hope it does not get too hipster this winter  ;)" ;
    schema:about place:91341 .

review:91341_r24 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le Rosa Bonheur et son ambiance guinguette s'exporte sur les Berges de Seine pour notre plus grand plaisir." ;
    schema:about place:91341 .

review:91341_r25 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Plein de tables mais encore plus de monde, donc un peu difficile de s'en procurer d'une place parfois. Sur le trottoir a côté c'est presque aussi bon que au 'bar'!!" ;
    schema:about place:91341 .

review:91341_r26 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "En attendant la péniche qui arivera à la fin de l’année, découvrez la terrasse ‘En attendant Rosa’ sur les nouvelles berges de Seine !" ;
    schema:about place:91341 .

review:91341_r27 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Canapé pour se lover, hot dog pour se sustenter, rosé pour se désaltérer : parfait !" ;
    schema:about place:91341 .

