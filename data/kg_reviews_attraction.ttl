review:84720_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Don't book in advance and wait twenty minutes outside to buy your tickets. If possible in winter." ;
    schema:about place:84720 .

review:84720_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "These cineplexes face each other across a canal in the once working class 19th arrondissement. A tiny boat shuttles you from one theatre to another. Both have cafes and restaurants. Click for more." ;
    schema:about place:84720 .

review:84720_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Des caisses automatiques à l'intérieur toujours désertes !" ;
    schema:about place:84720 .

