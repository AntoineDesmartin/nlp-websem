review:83973_r24 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Go on a weeknight to avoid the fickle bouncer (Oh, Paris). Have a perfect sazerac and enjoy the Twin Peaks-with-taxidermy ambiance. For more local tips, follow us on 4sq or check out www.renhotels.com" ;
    schema:about place:83973 .

review:83973_r25 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Part of the Experimental Cocktail Club family." ;
    schema:about place:83973 .

review:83973_r26 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le nikka, excellent." ;
    schema:about place:83973 .

review:83973_r27 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Morning Spritz..." ;
    schema:about place:83973 .

review:83973_r28 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Drinks are nice, but after receiving the first drink the service got slow (on a saturday night)" ;
    schema:about place:83973 .

review:83973_r29 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "cocktail place" ;
    schema:about place:83973 .

review:83973_r30 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "A essayer le Morning Glory Sprits! Juste délicieux : goût champagne agrumes! Et si vous avez envié d'un verre bien chargé, demandez un Carabineros!" ;
    schema:about place:83973 .

review:83973_r31 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Delicious & creative cocktails" ;
    schema:about place:83973 .

review:83973_r32 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "A speakeasy-style lounge popular with a chic Parisian crowd" ;
    schema:about place:83973 .

review:83973_r33 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Secret spot with truly the best cocktails in Paris. Great interior, really cosy and perfect service." ;
    schema:about place:83973 .

review:83973_r34 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Excellent Manhattan. The place opens at 20h." ;
    schema:about place:83973 .

review:83973_r35 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "cosy speakeasy hidden in an abandoned street,perfect for a date.  It's easy to miss, so make sure you got the address. Strong & experimental cocktails, some come in tiki-mugs. TIKI MUGS! Yay!" ;
    schema:about place:83973 .

review:83973_r36 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Fantastic speakeasy. Great drinks, great atmosphere and bartenders. I will definitely be coming back to this secret bar." ;
    schema:about place:83973 .

review:83973_r37 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "This is BarChick's favourite of the ECC bars, and no Paris trip is complete without it. Check out our review http://barchick.com/find-a-bar/paris/curio-parlor" ;
    schema:about place:83973 .

review:83973_r38 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Une belle carte de cocktails, varié et original. Entre 13/14 euros b" ;
    schema:about place:83973 .

review:83973_r39 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Straight out of Brooklyn (taxidermy included), but grab a velvet banquette and order an expertly made Aviation, or any of the delicious specialty cocktails of the house. You'll be glad you did." ;
    schema:about place:83973 .

review:83973_r40 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "De très loin le meilleur bar à cocktails de paris. A la fois inventif et old fashion, avec un choix d'alcools de qualité servis avec autant de sourire que de passion." ;
    schema:about place:83973 .

