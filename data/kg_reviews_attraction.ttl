review:83523_r112 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Das Centre Pompidou besitzt eine hervorragende Sammlung der Kunst des 20. Jh. Wer das Museum besucht, bekommt zudem den wunderbaren Panoramablick über die Stadt vom Dach des Centres gratis dazu." ;
    schema:about place:83523 .

review:83523_r113 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "one of my favourite places in Paris.. enjoyed my time 100%.." ;
    schema:about place:83523 .

review:83523_r114 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "N'oubliez pas les festivals, séances de cinéma, pièces de théâtre et conférences qui ont lieu en plus des fabuleuses expos !" ;
