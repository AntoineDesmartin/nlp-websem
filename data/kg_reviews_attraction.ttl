review:83523_r217 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Ateliers, concerts, spectacles, ateliers culinaires animés par des chefs et rencontres avec des artistes contemporains mexicains. Du 1er au 3 novembre à partir de 11h. Gratuit sans réservation." ;
    schema:about place:83523 .

