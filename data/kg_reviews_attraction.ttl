review:83650_r24 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Demandez à accéder au bar à l'etage, classe, cosy et lounge. Sympa pour sortir Madame après le ciné. Bon choix de cocktails." ;
    schema:about place:83650 .

review:83650_r25 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The best spot in Bercy Village for a business lunch or diner! Food is quite good, service is nice and you can have the pleasure to select your own wine bottle directly in the cellar!" ;
    schema:about place:83650 .

review:83650_r26 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Nice, but expensive" ;
    schema:about place:83650 .

review:83650_r27 a schema:Review ;
    schema:author "Anonymous" ;
