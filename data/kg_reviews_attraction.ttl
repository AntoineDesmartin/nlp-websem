review:85349_r57 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Fondez de plaisir au Bar la Vue Pour pâques, notre Chef Barman vous a concocté un cocktail divin : « le KKO » : surprenant, envoûtant et surtout très gourmand !" ;
    schema:about place:85349 .

review:85349_r58 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "perfect view of arc de triomph and tour eifel and elegant atmosphere" ;
    schema:about place:85349 .

review:85349_r59 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "We looooove : the delicious cocktails whipped up by a  mixology maestro. How to really impress you latest conquest! An excellent club \"before the club\". Starting at 18€ for a cocktail." ;
    schema:about place:85349 .

review:85349_r60 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le soleil est là !Venez profiter d’une vue sur un Paris ensoleillé à partir de 17h Copyright : Télérama" ;
