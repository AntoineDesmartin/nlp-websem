review:83718_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "One of my favorite concert halls in Paris ! Beautifully decorated, full of history...Whether you're sitting in the balcony or standing in the orchestra, you've got a great view of the stage." ;
