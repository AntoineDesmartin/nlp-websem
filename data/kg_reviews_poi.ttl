    schema:reviewBody "Absurdamente lindo. Num dia de sol tire mtas fotos :)" ;
    schema:about place:85348 .

review:85348_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Great views after you went off musee de louvre!" ;
    schema:about place:85348 .

review:85348_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Depois do Louvre, parada obrigatória." ;
    schema:about place:85348 .

review:85348_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Looks like a small version of the \"Brandenburger Tor\" in Berlin. Probably due to the horses and chariot at the top." ;
    schema:about place:85348 .

review:85348_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Es realmente imponente. Lo mejor es llegar a pie atravesando toda la Avenue de Champs-Elysees (desde el Hotel des Invalides); el Arco del Triunfo se va divisando de a poco hasta descubrir su magnitud." ;
    schema:about place:85348 .

