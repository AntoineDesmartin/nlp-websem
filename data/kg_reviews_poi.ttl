review:83798_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "“Amélie”:Aquí se encuentran Amélie (Audrey Tautou) y Nino (Mathieu Kassovitz) varias veces y se dejan mensajes en las paredes porque todavía no se conocen en ese juego que creó ella para encontrarse" ;
    schema:about place:83798 .

