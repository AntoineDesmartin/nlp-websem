review:83785_r15 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "One of the most iconic locales in Paris, this avenue immortalized a newspaper-hawking Jean Seberg in Jean-Luc Godard's French new-wave landmark, BREATHLESS." ;
    schema:about place:83785 .

