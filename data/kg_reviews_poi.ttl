    schema:reviewBody "This is one of the worst Railteam lounges I've seen. Poorly maintained, dirty toilets, surly staff. Read the 'Livre d'or' book by the door to read amusing & devastating critiques of the place." ;
    schema:about place:86382 .

review:86382_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Closed in weekends? Why? As if there are no travellers then?" ;
    schema:about place:86382 .

review:86382_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Allez pisser ailleurs :-)" ;
    schema:about place:86382 .

review:86382_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "café: 50 centimes; wifi gratuit.. si vous ne disposez pas de carte GV plus, votre ticket Thalys 1ère marchera." ;
    schema:about place:86382 .

review:86382_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "One of the shittiest lounges around. Hands down. No workable Internet, overcrowded and rude staff. Go across the road to McDonalds, it's better." ;
    schema:about place:86382 .

