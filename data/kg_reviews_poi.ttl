review:83488_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Worth the price of admission if only to see Foucault's Pendulum.  The rest of the space is actually quite interesting.  Worth it!" ;
    schema:about place:83488 .

review:83488_r2 a schema:Review ;
