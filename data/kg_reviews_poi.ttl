review:83483_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The place I stand almost every day, prosecuting or defending cases for my clients" ;
    schema:about place:83483 .

review:83483_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "C'est le cœur du système judiciaire français. Reconstruit sous Louis XVI (notamment la façade), il fût le siège du Tribunal révolutionnaire de 1793 à 1795." ;
    schema:about place:83483 .

review:83483_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Ne pas laisser trainer les pièces de monnaie. Choisissez bien vos chaussures et votre ceinture... Détecteurs de métaux à l'entrée." ;
    schema:about place:83483 .

review:83483_r3 a schema:Review ;
