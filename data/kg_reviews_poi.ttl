review:85110_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Be mentally prepared to be frustrated! Welcome to purgatory!" ;
    schema:about place:85110 .

review:85110_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Predict waiting one hour or two before your appointment ! :-/" ;
    schema:about place:85110 .

review:85110_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Wait wait wait... then wait some more. After that you wait again." ;
    schema:about place:85110 .

review:85110_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Ouf! J'ai eu mon ticket 43 à 12:45. Le numéro affiché était le 33. Il est 14:15, le numéro affiché est 34.  Je dormirais ici, je crois." ;
    schema:about place:85110 .

review:85110_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Clairement la couleur est annoncée : patience, attente et tout le reste ! Ca pu l'administration à plein nez !" ;
    schema:about place:85110 .

review:85110_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Apprêtez-vous a faire la queue pour avoir un ticket, pour ensuite faire la queue..." ;
    schema:about place:85110 .

review:85110_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Mais non. Il faut un peu de patience mais après tout c'est efficace. Il y a pire ailleurs. Beaucoup pire." ;
    schema:about place:85110 .

review:85110_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Bien charger son épargnions avant de venir ici. L'attente risque de s'avérer longue." ;
    schema:about place:85110 .

review:85110_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "C'est chiant d'être étranger." ;
    schema:about place:85110 .

review:85110_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Là où le temps s'arrête..." ;
    schema:about place:85110 .

review:85110_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Ici on a le temps de se demander ce que signifient les lettres D P A ... qui sont dans les numeros de ticket. Prevoir un tres long bouquin." ;
    schema:about place:85110 .

review:85110_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "On prend peur au 2e étage, celui des permis de conduire, mais les relevés intégraux de point s'obtiennent en fait au 3e, en 2 min montre en main. Ouf !" ;
    schema:about place:85110 .

review:85110_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Vous voulez attendre des heures et vous faire tripoter de droite a gauche pour des papiers sans utilité ? C'est ici." ;
    schema:about place:85110 .

review:85110_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Photocopieuses, photomatons et coin café disponible. Prévoir d'acheter les timbres fiscaux avant de venir." ;
    schema:about place:85110 .

review:85110_r14 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Soyez très patient ! Compter minimum 3h d'attente." ;
    schema:about place:85110 .

review:85110_r15 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Faites vos demandes par courrier. L'attente au retrait sera moins longue" ;
    schema:about place:85110 .

review:85110_r16 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Y'a rien a dire c'est super chiant d'attendre... Dans la salle d'attente de l'auto-ecole ils font passer les fichiers bleus apres les roses" ;
    schema:about place:85110 .

review:85110_r17 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Ici on apprend à être patient et a avoir un sang froid. Tenez vous bons, vous finirez par avoir vos papiers" ;
    schema:about place:85110 .

review:85110_r18 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Énorme progrès depuis l'an dernier... Mais toujours pénible." ;
    schema:about place:85110 .

review:85110_r19 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Ô toi qui entre ici, abandonne toute espérance." ;
    schema:about place:85110 .

review:85110_r20 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Nouveaute: attendre au moins 1 heure pour recuperer son titre de sejour! De mal en pire!" ;
    schema:about place:85110 .

review:85110_r21 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Bon courage !!" ;
    schema:about place:85110 .

review:85110_r22 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Pour les permis : venir en avance car c'est un par un et c'est tendu ! Prévoir la matinée complète ! Un pur scandale" ;
    schema:about place:85110 .

review:85110_r23 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Et la préfecture inventa \"l'attente de principe\" même s'il n'y a personne avant vous, vous attendrez 1h, comme ça, pour le plaisir." ;
    schema:about place:85110 .

review:85110_r24 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un parcours du combattant, formation méditation recommandé pour survivre a la patience sur les lieux..." ;
    schema:about place:85110 .

review:85110_r25 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Téléchargez un bon petit jeu du style Candy Crush pour vous armer de patience.... Il en faudra !" ;
    schema:about place:85110 .

review:85110_r26 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Cet endroit rend dépressif. Numéros d'attentes sans aucun sens. Y aller en juillet aout. Contrairement à la convocation je vous conseil de venir avant l'heure. Histoire de leur mettre une quenelle." ;
    schema:about place:85110 .

review:85110_r27 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Patience patience patience" ;
    schema:about place:85110 .

review:85110_r28 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Ne vous installez pas a côté de la climatisation,90% de chances d'avoir une angine. Eteignez-la (le bouton se trouve sous le couvercle). Le cafe a 40 centimes. Attente très longue,prévoyez 5h. Courage" ;
    schema:about place:85110 .

