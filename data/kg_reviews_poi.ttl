review:83507_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The British Embassy in Paris is located at 35, rue du Faubourg St Honoré, 75363 Paris Cedex 08 Paris. Tel: (33) 1 44 51 31 00" ;
