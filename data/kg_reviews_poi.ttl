    schema:about place:85086 .

review:85086_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "这站经常会有不错的弦乐乐团作现场表演，我就刚好碰到十几个人的乐团演奏阿尔贝尼兹(Albeniz) 的伊比利亚(Iberia)." ;
    schema:about place:85086 .

review:85086_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "L'odeur peut être très spéciale! Surtout après un week" ;
    schema:about place:85086 .

review:85086_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Il y a un passage secret pour aller de la 14 à la 1 direction La Défense. Visez le quai direction Château de Vincennes et descendez dans le 3e escalier. Au bout du couloir faites un gauche-gauche !" ;
    schema:about place:85086 .

review:85086_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "its useless to ask some persons in the information booth, if you have your metro map, just try to understand it" ;
    schema:about place:85086 .

review:85086_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "des cinémas, et des boutiques de shopping sont juste à coté, prenez le temps de dévaliser" ;
    schema:about place:85086 .

review:85086_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Il faut d'abord se perdre pour trouver les raccourcis. N'hésiter pas à emprunter les \"sens interdits\"." ;
    schema:about place:85086 .

review:85086_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The place is underconstruction. Many direction sign has been lost. (=_=\") Stay really focus on your pocket map and frequency ask the local to prevent get lost (@..@\")" ;
    schema:about place:85086 .

review:85086_r11 a schema:Review ;
