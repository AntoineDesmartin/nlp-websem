review:84675_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Pablo, uno de nuestros viajeros, aconseja guiarte por un mapa en la ciudad porque es más fácil que entender el francés. ¿Estás de acuerdo? Cuéntanos en Aprendí." ;
    schema:about place:84675 .

review:84675_r14 a schema:Review ;
