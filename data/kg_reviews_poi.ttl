review:85348_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Regardez vers l'Ouest et vous verrez les monuments de l'Axe Historique : l'Obélisque de la Concorde, l'Arc de Triomphe et la Grande Arche de la Défense." ;
    schema:about place:85348 .

review:85348_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Included in the museum pass for free/fast track entry" ;
    schema:about place:85348 .

review:85348_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Édifié en 1809, il rend hommage à la Grande Armée de Napoléon Bonaparte, lors de la victoire à Austerlitz. Ce monument est dans l'Axe Historique comme son petit frère de l'Étoile." ;
    schema:about place:85348 .

review:85348_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "not a great picnic spot" ;
    schema:about place:85348 .

review:85348_r4 a schema:Review ;
