review:83392_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Cours de Tango avec Gisela et Rodrigo le mardi soir" ;
    schema:about place:83392 .

review:83392_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Lors soirée ovs entrée a gauche mais si vous allez a droite vous payez le même prix... Avec une Conso offerte !" ;
    schema:about place:83392 .

review:83392_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Le bateau Concorde Atlantique est une des salles les plus réservées par les organisateurs: 2 salles +1 terrasse, forcément ca donne envie, surtout l'été. Bien que ce bateau soit un des endroits les pl" ;
    schema:about place:83392 .

review:83392_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Each sunday from 4PM to 10PM there's a cool salsa & forro (brazilian dance) party for 10€ with free soft drinks. Check it out!" ;
    schema:about place:83392 .

review:83392_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Entrée gratuite avant 2am si sur guest-list. Ambiance pas prise de tête. sound mix electro, pop, 80's, généraliste. Great dance floor and settings. Mainstream. Great place to meet and mingle." ;
    schema:about place:83392 .

review:83392_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Il faut absolument aller aux soirées MBB en été !!" ;
    schema:about place:83392 .

review:83392_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Accueil par des videurs profondément crétins et une clientèle uniquement masculine, un conseil fuyez !" ;
    schema:about place:83392 .

review:83392_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Rock the boat!!! Great fun" ;
    schema:about place:83392 .

review:83392_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Tous les Jeudis, retrouvez la soirée CAMPUS de 21h à 05h! GRATUIT POUR TOUS avant minuit avec pass / carte étudiante / réservation - infos/resas: 0675775498" ;
    schema:about place:83392 .

review:83392_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Tous les jeudis, c'est CAMPUS! La soirée étudiante de 21h à 05h, gratuit pour tous avant Minuit! Infos: 06.75.77.54.98" ;
    schema:about place:83392 .

review:83392_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Dj à mettre à la poubelle, le bateau n'a vraiment rien de particulier, et le personnel manque d'amabilité ." ;
    schema:about place:83392 .

review:83392_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Bien que j'y aie passé une bonne soirée entre amis, l'accueil était vraiment pourri (aucune organisation) et  le dj nul." ;
    schema:about place:83392 .

review:83392_r12 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Très cool en été avec des soirées électro" ;
    schema:about place:83392 .

review:83392_r13 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Videurs insupportables et irrespectueux, toilettes pétées, une très mauvaise adresse. Je déconseille fortement." ;
    schema:about place:83392 .

review:83392_r14 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Plusieurs amis dont une qui organisait la soirée n'ont pas été admis parce qu'ils n'avaient pas leurs cartes alors que c'est une soirée privée et que tout le monde a payé. Pas de remboursement." ;
    schema:about place:83392 .

review:83392_r15 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Clairement des voleurs." ;
    schema:about place:83392 .

review:83392_r16 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Cocobeach le dimanche, gratuit de 15h à 20h, 10€ après; electro house techno jusque 5-6h du mat' au club !" ;
    schema:about place:83392 .

review:83392_r17 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "FRANCK ROGER / CÉLINE / GUIDO / STEPHAN / TIBO'Z / ERIC LABBE : c'est gratuit et c'est ce jeudi 8 août 2013 au bateau Concorde Atlantique !SHAKE YOUR BOUNTY ! La mutinerie la plus funky de l'été !" ;
    schema:about place:83392 .

