review:83457_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The Madwoman of Chaillot (French title: La Folle de Chaillot) is a play, a poetic satire, by French dramatist Jean Giraudoux, written in 1943 and first performed in 1945, after his death. The play has" ;
    schema:about place:83457 .

review:83457_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Belle vue pour observer la tour Eiffel !" ;
    schema:about place:83457 .

review:83457_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Attends dame Fressine pour defile Paul&Joe" ;
    schema:about place:83457 .

review:83457_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "nice view :)" ;
    schema:about place:83457 .

review:83457_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Spectacular view of the Eiffel Tour. Too bad the Trocadero Fountains were drained for the winter." ;
    schema:about place:83457 .

review:83457_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "한국인 여행자에게 : 8월 기준으로 오후 8시 반쯤에 오시면 노을지는 에펠탑의 아름다운 모습을 감상하실수 있습니다. 흑형들이 파는 에펠탑 열쇠고리는 1유로에 최소5개니까 흥정 잘하시고요, 에펠탑을 바라보고 다리를 건너자마라 오른쪽에 있는 작은 공원에 들어가셔서 에펠탑의 야경을 보시면 정말 환상입니다! 그곳에서 정각마다 반짝이는 에펠탑을 꼭 구경하세요!" ;
    schema:about place:83457 .

review:83457_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Une des plus belle vue de la capitale" ;
    schema:about place:83457 .

review:83457_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Es el mejor lugar para ver la Torre Eiffel" ;
    schema:about place:83457 .

