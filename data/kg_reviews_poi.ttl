    schema:author "Anonymous" ;
    schema:reviewBody "Pour éviter le rush, prendre le tram avant 8h et après 18h30." ;
    schema:about place:85333 .

review:85333_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Toujours un grand moment à l'approche de cette station... Beaucoup de monde, passez-y très tôt le matin ou tard le soir, en dehors de ça, vous avez de grandes chances de vous faire piétiner..." ;
    schema:about place:85333 .

review:85333_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Annonce plus rock pour la pte d' Orléans..." ;
    schema:about place:85333 .

