    schema:about place:83791 .

review:83791_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Vous fréquentez la ligne J de Transilien au départ de la gare Saint-Lazare ? Découvrez le fil Twitter d'information voyageur!" ;
    schema:about place:83791 .

review:83791_r11 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Quelques trains de la Ligne J sont habillés de peintures impressionnistes :)" ;
