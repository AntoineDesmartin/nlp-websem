    schema:about place:85086 .

review:85086_r17 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Try not to get lost. C'est un dédale urbain de stations métro de couloirs et de couloirs à n'en pas finir." ;
