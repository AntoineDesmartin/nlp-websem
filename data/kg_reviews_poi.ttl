review:84390_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Awesome, so jealous! Have fun girls" ;
    schema:about place:84390 .

review:84390_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "The Mona Lisa is surprisingly disappointing. Check out the huge Napoleon painting in the French section instead. Spellbinding." ;
