review:83785_r34 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "It's time for a walk on the most beautiful Avenue of the world. Everything is open late on Avenue des Champs Elysées and even on sunday (that isn't so easy to find in Paris)." ;
    schema:about place:83785 .

