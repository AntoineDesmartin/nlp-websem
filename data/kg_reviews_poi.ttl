review:83791_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Afin de préparer votre voyage et de partir l'esprit tranquille, Gares360 vous permet de vous familiariser avec la gare Saint-Lazare." ;
    schema:about place:83791 .

review:83791_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "2e gare d'Europe, avec près de 650 000 voyageurs par jour et un train toutes les 28 secondes. La gare a maintenant une galerie commerciale moderne et une nouvelle verrière impressionante" ;
    schema:about place:83791 .

