review:83798_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Cette gare accueille les TGV et ICE, en provenance de l'Est de la France, Luxembourg, Allemagne et Suisse." ;
    schema:about place:83798 .

review:83798_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "La plus belle gare de Paris, et la plus agréable." ;
    schema:about place:83798 .

review:83798_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "certainement l'une des plus belles gares de Paris. Refaite à neuf avec de beaux magasins: Occitane, Mango, Virgin.." ;
    schema:about place:83798 .

review:83798_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "L'une des gares parisienne qui permet de partir a la decouverte du patrimoine briard. 25mn de train et decouvrez l'ancienne abbaye Saint-Pierre de Lagny-sur-Marne !" ;
    schema:about place:83798 .

review:83798_r4 a schema:Review ;
    schema:author "Anonymous" ;
