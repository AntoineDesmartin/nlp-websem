review:83785_r36 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Sure, it may be something of a tourist trap, but you can’t shop in Paris without hitting the Champs-Élysées. Definitely check out the Louis Vuitton flagship–its window displays are incredible." ;
    schema:about place:83785 .

