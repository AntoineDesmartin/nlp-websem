review:83570_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "the Deyrolle shop could only exist in Paris. This 155+ year old taxidermy shop is straight out of a fairy tale where family pets and wild animals don't actually die, but live in suspended animation" ;
    schema:about place:83570 .

review:83570_r1 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Una tienda tan extraña como bonita. ¡Seguro que te sorprenderá!" ;
    schema:about place:83570 .

review:83570_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Un magasin impressionnant qui vend des animaux empaillés." ;
    schema:about place:83570 .

review:83570_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Hay.. What's your name?" ;
    schema:about place:83570 .

review:83570_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "They gave a fantastic collection of stuffed wild animals, go upstairs to see them" ;
    schema:about place:83570 .

review:83570_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Taxidermy not your thing? Deyrolle is equally well known for their botanical illustrations upstairs." ;
    schema:about place:83570 .

review:83570_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Another must-see Parisian staple. Filled with taxidermy and garden supplies in the delicately sophisticated 6th arrondissement." ;
    schema:about place:83570 .

review:83570_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Upstairs is Absolutely a wonderland! A must-do in Paris!" ;
