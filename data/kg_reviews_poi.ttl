review:83470_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "La plus célèbre bibliothèque de France, composée des 4 tours réalisées par l’architecte Dominique Perraut.#expo La France silencieuse de Raymond Depardon MétroLignes 6 (Quai de la gare), 14 et RER C" ;
    schema:about place:83470 .

review:83470_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Profitez du calme ambiant en vous asseyant sur les sieges confortables. Espositions fermées les lundi sauf celle des globes de Louix XIV gallerie Ouest." ;
    schema:about place:83470 .

review:83470_r5 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Face au parc de Bercy et avec vue sur la Seine (qui coule au milieu bien sur)" ;
    schema:about place:83470 .

review:83470_r6 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Grimper un soir de printemps au coucher se soleil et faire le tour en pensant aux pharaons ..." ;
    schema:about place:83470 .

review:83470_r7 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "le week end certains rappeurs envahissent  la bibliotheque pr tourner leur clip... assez drole!" ;
    schema:about place:83470 .

review:83470_r8 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Archi blindée le weekend (faire la queue 1h avant l'ouverture!), ferme tôt (20h), restauration hors de prix..." ;
    schema:about place:83470 .

review:83470_r9 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "K106 : pas de soleil, pas d'Internet, conditions méditatives optimales si les bibliothécaires n'étaient pas si bavards." ;
    schema:about place:83470 .

review:83470_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Depuis ibis porte de bercy prendre le bus 24 jusqu à cour Saint émillon puis métro 14 jusqu'à @actubnf" ;
    schema:about place:83470 .

