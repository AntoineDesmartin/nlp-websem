review:85333_r0 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Crêpes salées ou sucrées à emporter dans la cabane verte près de l'arrêt de tram. Pas cher, très bon, excellent accueil." ;
    schema:about place:85333 .

