    schema:reviewBody "Free admission to the museum first Sunday of each month." ;
    schema:about place:84390 .

review:84390_r2 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Get the audio guide and do the \"Masterpieces Tour.\"  Highly, highly recommend this.  It walks you directly to the most famous pieces in the museum and discusses the artwork, all in 45 minutes.  It is" ;
    schema:about place:84390 .

review:84390_r3 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Come in the winter, no waiting in line" ;
    schema:about place:84390 .

review:84390_r4 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "If you are lucky enough, you can see ducks in the water next to the pyramids." ;
    schema:about place:84390 .

