review:84675_r10 a schema:Review ;
    schema:author "Anonymous" ;
    schema:reviewBody "Pour sortir par la rue Saint-Lazare ou la rue Caumartin en arrivant des lignes 13, 9 ou 3, allez sur le quai de la ligne 12 puis suivez la sortie." ;
