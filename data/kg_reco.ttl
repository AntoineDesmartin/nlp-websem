ns2:Tourist a owl:Class .

ns2:POI a owl:Class ;
    rdfs:subClassOf ns2:Place .

ns2:Review a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ns2:Place ;
            owl:onProperty ns2:aboutPlace ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ns2:Place ;
            owl:onProperty ns2:aboutPlace ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ns2:Tourist ;
            owl:onProperty ns2:authoredBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty ns2:rating ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onClass ns2:Tourist ;
            owl:onProperty ns2:authoredBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
