ns4:paris-1st-arrondissement-q726781-824feafdb4 a ns2:Attraction,
        ns2:Place ;
    rdfs:comment "[Jardin des Tuileries] Houses \"The Water Lilies\" (or \"Nymphéas\") - a 360 degree depiction of Monet's flower garden at Giverny. Also, impressionist and post-Impressionist paintings by Cézanne, Matisse, Modigliani, Picasso, Renoir, Rousseau, Soutine, Sisley and others." ;
    ns2:lat 48.863833 ;
    ns2:lng 2.32225 ;
    ns2:locatedIn ns3:Paris ;
    ns2:name "[[Paris/1st arrondissement#Q726781" ;
    ns2:placeId "wv:aeae4c4fdb32" .

