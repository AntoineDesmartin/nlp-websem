@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns5:url a rdf:Property .

rdf:type a rdf:Property .

rdfs:comment a rdf:Property .

rdfs:domain a rdf:Property .

rdfs:range a rdf:Property .

rdfs:seeAlso a rdf:Property .

rdfs:subClassOf a rdf:Property .

owl:disjointWith a rdf:Property .

owl:inverseOf a rdf:Property .

owl:onClass a rdf:Property .

owl:onProperty a rdf:Property .

owl:qualifiedCardinality a rdf:Property .

owl:sameAs a rdf:Property .

owl:someValuesFrom a rdf:Property .

ns2: a owl:Ontology .

ns2:Itinerary a owl:Class .

ns2:ItineraryStep a owl:Class .

ns2:address a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:domain ns2:Place ;
    rdfs:range xsd:string .

ns2:cityName a rdf:Property .

ns2:hasTopic a owl:ObjectProperty ;
    rdfs:domain ns2:Place ;
    rdfs:range skos:Concept .

ns2:inferenceReason a rdf:Property .

ns2:likesPlace a owl:ObjectProperty ;
    rdfs:domain ns2:Tourist ;
    rdfs:range ns2:Place .

ns2:numReviews a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:domain ns2:Place ;
    rdfs:range xsd:integer .

ns2:placeId a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:domain ns2:Place ;
    rdfs:range xsd:string .

ns2:polarity a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:domain ns2:Place ;
    rdfs:range xsd:decimal .

ns2:prefersTopic a owl:ObjectProperty ;
    rdfs:domain ns2:Tourist ;
    rdfs:range skos:Concept .

ns2:rawSubCategory a rdf:Property .

ns2:reviewDate a owl:DatatypeProperty ;
    rdfs:domain ns2:Review ;
    rdfs:range xsd:date .

ns2:reviewText a owl:DatatypeProperty ;
    rdfs:domain ns2:Review ;
    rdfs:range xsd:string .

ns2:hasPlace a rdf:Property,
        owl:ObjectProperty ;
    rdfs:domain ns2:City ;
    rdfs:range ns2:Place .

ns2:hasReview a owl:ObjectProperty ;
    rdfs:domain ns2:Place ;
    rdfs:range ns2:Review .

ns2:wroteReview a owl:ObjectProperty ;
    rdfs:domain ns2:Tourist ;
    rdfs:range ns2:Review .

