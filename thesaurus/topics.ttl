  skos:prefLabel "Government Building"@en, "Bâtiment gouvernemental"@fr ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:PublicService .

tg:CityHall a skos:Concept ;
  skos:prefLabel "City Hall"@en, "Mairie"@fr ;
  skos:altLabel "Town Hall"@en, "Hôtel de ville"@fr ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:GovernmentBuilding .

tg:Embassy a skos:Concept ;
  skos:prefLabel "Embassy"@en, "Ambassade"@fr ;
  skos:altLabel "Consulate"@en, "Consulat"@fr ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:GovernmentBuilding .

tg:PoliceStation a skos:Concept ;
  skos:prefLabel "Police Station"@en, "Commissariat"@fr ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:PublicService .

tg:Library a skos:Concept ;
  skos:prefLabel "Library"@en, "Bibliothèque"@fr ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:PublicService ;
  skos:related tg:BookStore .

tg:MedicalCenter a skos:Concept ;
  skos:prefLabel "Medical Center"@en, "Centre médical"@fr ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:PublicService .

tg:Hospital a skos:Concept ;
  skos:prefLabel "Hospital"@en, "Hôpital"@fr ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:MedicalCenter .

tg:Office a skos:Concept ;
  skos:prefLabel "Office"@en, "Bureau"@fr ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:PublicService .

tg:MeetingRoom a skos:Concept ;
  skos:prefLabel "Meeting Room"@en, "Salle de réunion"@fr ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:Office ;
  skos:related tg:ConventionCenter .

#####################
# Sports & Recreation#
#####################

tg:Sports a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:topConceptOf tg:TourismTopics ;
  skos:prefLabel "Sports & Recreation"@en, "Sports & Loisirs"@fr ;
  skos:altLabel "Athletic Activities"@en ;
  skos:definition "Sports venues, facilities, and athletic activities"@en ;
  skos:narrower tg:Stadium, tg:GymFitness, tg:GolfCourse, tg:BowlingAlley, tg:SkatePark .

tg:Stadium a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Stadium"@en, "Stade"@fr ;
  skos:broader tg:Sports ;
  skos:narrower tg:BasketballStadium, tg:TrackStadium, tg:Racetrack .

tg:BasketballStadium a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Basketball Stadium"@en, "Stade de Basketball"@fr ;
  skos:broader tg:Stadium .

tg:TrackStadium a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Track Stadium"@en, "Stade d'Athlétisme"@fr ;
  skos:broader tg:Stadium .

tg:Racetrack a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Racetrack"@en, "Circuit de Course"@fr ;
  skos:broader tg:Stadium .

tg:GymFitness a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Gym & Fitness"@en, "Gym & Fitness"@fr ;
  skos:broader tg:Sports ;
  skos:narrower tg:SwimmingPool, tg:TennisCourt .

tg:SwimmingPool a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Swimming Pool"@en, "Piscine"@fr ;
  skos:broader tg:GymFitness .

tg:TennisCourt a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Tennis Court"@en, "Court de Tennis"@fr ;
  skos:broader tg:GymFitness .

tg:GolfCourse a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Golf Course"@en, "Terrain de Golf"@fr ;
  skos:broader tg:Sports .

tg:BowlingAlley a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Bowling Alley"@en, "Bowling"@fr ;
  skos:broader tg:Sports .

tg:SkatePark a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Skate Park"@en, "Skate Park"@fr ;
  skos:broader tg:Sports .

#####################
# Cross-cutting     #\n#####################

tg:FamilyFriendly a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Family Friendly"@en, "Adapté aux Familles"@fr ;
  skos:related tg:Park, tg:Museum .

tg:RomanticSpot a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Romantic"@en, "Romantique"@fr ;
  skos:related tg:FineDining, tg:RiverSeine .

tg:Accessible a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Accessible"@en, "Accessible"@fr ;
  skos:definition "Wheelchair accessible places"@en .

tg:Historic a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Historic"@en, "Historique"@fr ;
  skos:related tg:Monument, tg:Museum .

tg:Photography a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Photography"@en, "Photographie"@fr ;
  skos:related tg:Monument, tg:Park .

#####################
# SKOS-XL Labels    #
#####################

# Labels complexes pour Culture
tg:CultureEnLabel a xl:Label ;
  xl:literalForm "Culture"@en ;
  rdfs:comment "Primary English label for cultural activities"@en .

tg:CultureFrAltLabel a xl:Label ;
  xl:literalForm "Patrimoine Culturel"@fr ;
  rdfs:comment "Alternative French label emphasizing heritage"@fr ;
  tg:acronymOf tg:CultureEnLabel .

# Labels complexes pour Food
tg:FoodEnLabel a xl:Label ;
  xl:literalForm "Food & Dining"@en ;
  rdfs:comment "Primary English label for culinary experiences"@en .

tg:FoodFrAltLabel a xl:Label ;
  xl:literalForm "Gastronomie"@fr ;
  rdfs:comment "French label highlighting gastronomic aspect"@fr .

# Labels complexes pour Entertainment
tg:EntertainmentEnLabel a xl:Label ;
  xl:literalForm "Entertainment"@en ;
  rdfs:comment "Primary label for entertainment activities"@en .

# Labels complexes pour Nature
tg:NatureEnLabel a xl:Label ;
  xl:literalForm "Nature & Outdoors"@en ;
  rdfs:comment "Label for natural and outdoor spaces"@en .

# Labels complexes pour Shopping
tg:ShoppingEnLabel a xl:Label ;
  xl:literalForm "Shopping"@en ;
  rdfs:comment "Commercial and retail activities label"@en .

# Labels complexes pour Accommodation
tg:AccommodationEnLabel a xl:Label ;
  xl:literalForm "Accommodation"@en ;
  rdfs:comment "Lodging and hotel services label"@en .

#####################
# Propriété personnalisée pour acronymes (SKOS-XL extension)
#####################

tg:acronymOf a rdf:Property ;
  rdfs:subPropertyOf xl:labelRelation ;
  rdfs:label "acronym of"@en ;
  rdfs:label "acronyme de"@fr ;
  rdfs:comment "Indicates that a label is an acronym of another label"@en .

#####################
# Mapping Relations #
#####################

# Alignements avec Schema.org
tg:Museum skos:exactMatch <http://schema.org/Museum> ;
  skos:scopeNote "Mapping exact avec Schema.org pour interopérabilité"@fr .

tg:Restaurant skos:exactMatch <http://schema.org/Restaurant> .

tg:Park skos:exactMatch <http://schema.org/Park> .

tg:Hotel skos:exactMatch <http://schema.org/Hotel> .

# Alignements avec DBpedia
tg:Culture skos:closeMatch <http://dbpedia.org/resource/Culture> ;
  skos:scopeNote "Similarité forte mais pas équivalence exacte"@fr .

tg:Monument skos:closeMatch <http://dbpedia.org/resource/Monument> .

# Mapping hiérarchiques entre schémas
tg:ArtMuseum skos:broadMatch <http://dbpedia.org/resource/Museum> ;
  skos:narrowMatch <http://dbpedia.org/resource/Art_museum> .

tg:FrenchCuisine skos:narrowMatch <http://dbpedia.org/resource/French_cuisine> .

# Mapping associatifs
tg:RomanticSpot skos:relatedMatch <http://schema.org/TouristAttraction> .

tg:FamilyFriendly skos:relatedMatch <http://schema.org/childFriendly> .

#####################
# Collections       #
#####################

# Collection simple
tg:TopRatedPlaces a skos:Collection ;
  skos:prefLabel "Top Rated Places"@en, "Lieux les Mieux Notés"@fr ;
  skos:definition "Collection of highly-rated tourist destinations"@en ;
  skos:member tg:Museum ;
  skos:member tg:FineDining ;
  skos:member tg:Monument ;
  skos:member tg:Park ;
  skos:scopeNote "Places avec notation moyenne > 4.5/5"@fr .

tg:IndoorActivities a skos:Collection ;
  skos:prefLabel "Indoor Activities"@en, "Activités Intérieures"@fr ;
  skos:definition "Tourist activities suitable for bad weather"@en ;
  skos:member tg:Museum ;
  skos:member tg:Cinema ;
  skos:member tg:Theater ;
  skos:member tg:Shopping ;
  skos:scopeNote "Activités praticables par temps de pluie"@fr .

#####################
# Ordered Collections#
#####################

# Collection ordonnée par priorité touristique
tg:MustSeeParis a skos:OrderedCollection ;
  skos:prefLabel "Must-See Paris Attractions"@en, "Incontournables de Paris"@fr ;
  skos:definition "Ordered list of essential Parisian attractions"@en ;
  skos:memberList ( 
    tg:Monument 
    tg:Museum 
    tg:FrenchCuisine 
    tg:Park 
    tg:Shopping 
  ) ;
  skos:scopeNote "Ordre basé sur popularité et importance culturelle"@fr ;
  skos:editorialNote "Liste validée par l'office du tourisme de Paris"@fr .

# Collection ordonnée par catégorie de prix
tg:BudgetTourism a skos:OrderedCollection ;
  skos:prefLabel "Budget Tourism Options"@en, "Tourisme Économique"@fr ;
  skos:definition "Ordered activities from cheapest to moderate price"@en ;
  skos:memberList (
    tg:Park
    tg:PublicSquare
    tg:StreetFood
    tg:BudgetHotel
    tg:Market
  ) ;
  skos:scopeNote "Activités classées par coût croissant"@fr .

# Collection ordonnée par expérience culinaire
tg:CulinaryJourney a skos:OrderedCollection ;
  skos:prefLabel "Culinary Journey"@en, "Parcours Gastronomique"@fr ;
  skos:definition "Ordered progression through Paris culinary scene"@en ;
  skos:memberList (
    tg:StreetFood
    tg:BistroFood
    tg:FrenchCuisine
    tg:FineDining
    tg:MichelinStar
  ) ;
  skos:scopeNote "Progression du street food à la haute gastronomie"@fr ;
  skos:historyNote "Créé en 2026 pour promouvoir la diversité gastronomique parisienne"@fr .

#####################
# Notations Étendues#
#####################

# Définition du datatype personnalisé
tg:TopicCode a rdfs:Datatype ;
  rdfs:label "Topic Code"@en ;
  rdfs:comment "Internal topic identification code"@en .

# Concepts avec notations multiples
tg:MuseumArtMuseum 
  skos:notation "MSM-ART-001"^^xsd:string ;
  skos:notation "A12"^^tg:TopicCode ;
  skos:notation "700.1"^^tg:DeweyCode .

tg:DeweyCode a rdfs:Datatype ;
  rdfs:label "Dewey Decimal Code"@en ;
  rdfs:comment "Classification décimale Dewey pour catégorisation"@fr .

#####################
# Propriétés de Label Étendues
#####################

tg:labelSource a rdf:Property ;
  rdfs:subPropertyOf xl:labelRelation ;
  rdfs:label "label source"@en ;
  rdfs:comment "Indicates the source or origin of a label"@en .

tg:CultureEnLabel tg:labelSource <https://www.larousse.fr/> ;
  dct:created "2026-01-15"^^xsd:date ;
  dct:creator "TourGuide Editorial Team"@en .

#####################
# Concepts Transversaux Enrichis
#####################

tg:Accessible 
  skos:altLabel "Wheelchair Accessible"@en ;
  skos:altLabel "PMR"@fr ;
  skos:hiddenLabel "handicap"@fr ;
  skos:hiddenLabel "accessibility"@en ;
  skos:notation "ACC-001"^^tg:TopicCode ;
  skos:scopeNote "Accessibilité physique pour personnes à mobilité réduite"@fr ;
  skos:example "Louvre (ascenseurs), Musée d'Orsay (rampes)"@fr .

tg:Historic
  skos:altLabel "Historical"@en ;
  skos:altLabel "Historique"@fr ;
  skos:altLabel "Patrimoine"@fr ;
  skos:hiddenLabel "histoire"@fr ;
  skos:notation "HIST-001"^^tg:TopicCode ;
  skos:definition "Sites with significant historical importance"@en ;
  skos:scopeNote "Importance historique avérée, datant de plus de 50 ans"@fr ;
  skos:historyNote "Critère temporel ajusté en 2026: > 50 ans"@fr ;
  skos:broaderTransitive tg:Culture .

#####################
# Relations Symétriques et Transitives
#####################

# Démonstration: skos:related est symétrique
# Si tg:Culture skos:related tg:Entertainment,
# alors tg:Entertainment skos:related tg:Culture (implicite)

# Démonstration: skos:broaderTransitive est transitive
# tg:Cathedral skos:broader tg:Church
# tg:Church skos:broader tg:ReligiousHeritage
# tg:ReligiousHeritage skos:broader tg:Culture
# => tg:Cathedral skos:broaderTransitive tg:Culture

#####################
# FIN DU THESAURUS  #
#####################
