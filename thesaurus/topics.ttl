@prefix tg:   <https://example.org/tourguide#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xl:   <http://www.w3.org/2008/05/skos-xl#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#####################
# Concept Scheme    #
#####################

tg:TourismTopics a skos:ConceptScheme ;
  skos:prefLabel "Paris Tourism Topics"@en, "Thèmes Touristiques Paris"@fr ;
  skos:altLabel "Thésaurus du Tourisme Parisien"@fr ;
  skos:altLabel "Paris Tour Taxonomy"@en ;
  dct:title "Comprehensive taxonomy of tourism topics in Paris"@en ;
  dct:description "SKOS thesaurus enrichi démontrant tous les concepts SKOS avancés"@fr ;
  dct:creator "TourGuide Project"@en ;
  dct:created "2026-01-15"^^xsd:date ;
  dct:modified "2026-01-16"^^xsd:date ;
  skos:hasTopConcept tg:Culture ;
  skos:hasTopConcept tg:Food ;
  skos:hasTopConcept tg:Entertainment ;
  skos:hasTopConcept tg:Nature ;
  skos:hasTopConcept tg:Shopping ;
  skos:hasTopConcept tg:Sports ;
  skos:hasTopConcept tg:Accommodation ;
  skos:hasTopConcept tg:Transport ;
  skos:hasTopConcept tg:PublicService ;
  skos:scopeNote "Thésaurus spécifique au tourisme parisien, couvrant attractions, gastronomie, hébergement, transport et services publics"@fr ;
  skos:historyNote "Créé en 2026 pour le projet TourGuide NLP-WebSem"@fr ;
  skos:editorialNote "Validé par l'équipe TourGuide - Version enrichie SKOS"@fr .

#####################
# Top-Level Concepts#
#####################

tg:Culture a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:topConceptOf tg:TourismTopics ;
  skos:prefLabel "Culture"@en, "Culture"@fr ;
  skos:altLabel "Patrimoine Culturel"@fr ;
  skos:altLabel "Cultural Heritage"@en ;
  skos:altLabel "Cultura"@es ;
  skos:hiddenLabel "cultura"@es ;
  skos:hiddenLabel "patrimoine"@fr ;
  skos:notation "TG-CULT-001"^^xsd:string ;
  skos:notation "C01"^^tg:TopicCode ;
  skos:definition "Cultural activities and heritage including museums, monuments, and artistic venues"@en ;
  skos:definition "Activités culturelles et patrimoine incluant musées, monuments et lieux artistiques"@fr ;
  skos:scopeNote "Concerne uniquement les activités culturelles touristiques, pas l'anthropologie"@fr ;
  skos:historyNote "Concept créé initialement comme 'Arts & Culture', renommé en 'Culture' pour simplification"@fr ;
  skos:changeNote "2026-01-15: Séparation du concept Theater en sous-concept distinct"@fr ;
  skos:editorialNote "Validé par le comité éditorial TourGuide - Concept racine majeur"@fr ;
  skos:example "Le Louvre, Notre-Dame, Opéra Garnier"@fr ;
  skos:example "The Louvre, Notre-Dame Cathedral, Garnier Opera"@en ;
  skos:narrower tg:Museum ;
  skos:narrower tg:Monument ;
  skos:narrower tg:Architecture ;
  skos:narrower tg:ReligiousHeritage ;
  skos:narrower tg:ModernArt ;
  skos:narrower tg:ClassicalArt ;
  skos:narrower tg:Theater ;
  skos:narrowerTransitive tg:Museum, tg:ArtMuseum, tg:HistoricalMuseum, tg:ScienceMuseum ;
  skos:narrowerTransitive tg:ReligiousHeritage, tg:Church, tg:Cathedral ;
  skos:related tg:Entertainment ;
  skos:related tg:Historic ;
  xl:prefLabel tg:CultureEnLabel ;
  xl:altLabel tg:CultureFrAltLabel .

tg:Food a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:topConceptOf tg:TourismTopics ;
  skos:prefLabel "Food & Dining"@en, "Gastronomie"@fr ;
  skos:altLabel "Culinary"@en ;
  skos:altLabel "Cuisine"@fr ;
  skos:altLabel "Restauration"@fr ;
  skos:hiddenLabel "food"@en ;
  skos:hiddenLabel "dining"@en ;
  skos:hiddenLabel "gastronomie"@fr ;
  skos:notation "TG-FOOD-001"^^xsd:string ;
  skos:notation "F01"^^tg:TopicCode ;
  skos:definition "Culinary experiences and dining establishments"@en ;
  skos:definition "Expériences culinaires et établissements de restauration"@fr ;
  skos:scopeNote "Inclut uniquement les restaurants et expériences gastronomiques, pas la production alimentaire"@fr ;
  skos:historyNote "Étendu de 'Restaurants' à 'Gastronomie' en 2026 pour couvrir street food et marchés"@fr ;
  skos:editorialNote "Concept enrichi avec sous-catégories végétariennes et internationales"@fr ;
  skos:example "Le Jules Verne, L'Ami Jean, Street food marchés"@fr ;
  skos:narrower tg:FrenchCuisine ;
  skos:narrower tg:FineDining ;
  skos:narrower tg:BistroFood ;
  skos:narrower tg:InternationalCuisine ;
  skos:narrowerTransitive tg:FineDining, tg:MichelinStar ;
  skos:narrowerTransitive tg:InternationalCuisine, tg:ItalianFood, tg:AsianFood ;
  skos:narrowerTransitive tg:Vegetarian, tg:Vegan ;
  skos:related tg:Culture ;
  skos:related tg:RomanticSpot ;
  xl:prefLabel tg:FoodEnLabel ;
  xl:altLabel tg:FoodFrAltLabel .

tg:Entertainment a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:topConceptOf tg:TourismTopics ;
  skos:prefLabel "Entertainment"@en, "Divertissement"@fr ;
  skos:altLabel "Leisure"@en ;
  skos:altLabel "Loisirs"@fr ;
  skos:altLabel "Entertainment Activities"@en ;
  skos:hiddenLabel "divertissement"@fr ;
  skos:hiddenLabel "leisure"@en ;
  skos:notation "TG-ENT-001"^^xsd:string ;
  skos:notation "E01"^^tg:TopicCode ;
  skos:definition "Entertainment and leisure activities including nightlife, shows, and venues"@en ;
  skos:scopeNote "Couvre spectacles, vie nocturne et activités récréatives pour touristes"@fr ;
  skos:historyNote "Anciennement fusionné avec Culture, séparé en 2026"@fr ;
  skos:editorialNote "Ajout des concepts Cabaret et MusicVenue en 2026"@fr ;
  skos:example "Moulin Rouge, cinémas d'art, clubs de jazz"@fr ;
  skos:narrower tg:Nightlife ;
  skos:narrower tg:Cinema ;
  skos:narrower tg:MusicVenue ;
  skos:narrower tg:CabaretShow ;
  skos:narrowerTransitive tg:Nightlife, tg:Cinema, tg:MusicVenue, tg:CabaretShow ;
  skos:related tg:Culture ;
  skos:related tg:RomanticSpot ;
  xl:prefLabel tg:EntertainmentEnLabel .

tg:Nature a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:topConceptOf tg:TourismTopics ;
  skos:prefLabel "Nature & Outdoors"@en, "Nature & Plein Air"@fr ;
  skos:altLabel "Outdoor Activities"@en ;
  skos:altLabel "Espaces Verts"@fr ;
  skos:altLabel "Green Spaces"@en ;
  skos:hiddenLabel "nature"@en ;
  skos:hiddenLabel "outdoors"@en ;
  skos:notation "TG-NAT-001"^^xsd:string ;
  skos:notation "N01"^^tg:TopicCode ;
  skos:definition "Natural spaces and outdoor activities including parks, gardens, and rivers"@en ;
  skos:scopeNote "Espaces naturels urbains et semi-urbains accessibles aux touristes"@fr ;
  skos:historyNote "Extension du concept pour inclure places publiques en 2026"@fr ;
  skos:example "Jardin du Luxembourg, Parc des Buttes-Chaumont, Seine riverside"@fr ;
  skos:narrower tg:Park ;
  skos:narrower tg:PublicSquare ;
  skos:narrower tg:RiverSeine ;
  skos:narrowerTransitive tg:Park, tg:Garden, tg:BotanicalGarden ;
  skos:related tg:FamilyFriendly ;
  skos:related tg:Photography ;
  xl:prefLabel tg:NatureEnLabel .

tg:Shopping a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:topConceptOf tg:TourismTopics ;
  skos:prefLabel "Shopping"@en, "Shopping"@fr ;
  skos:altLabel "Retail"@en ;
  skos:altLabel "Commerce"@fr ;
  skos:altLabel "Boutiques"@fr ;
  skos:hiddenLabel "shopping"@en ;
  skos:notation "TG-SHOP-001"^^xsd:string ;
  skos:notation "S01"^^tg:TopicCode ;
  skos:definition "Shopping and commercial activities including boutiques, markets, and luxury stores"@en ;
  skos:scopeNote "Commerce de détail touristique, inclut marchés et boutiques spécialisées"@fr ;
  skos:historyNote "Ajout des marchés aux puces en 2026"@fr ;
  skos:example "Champs-Élysées, Marais boutiques, Marché aux Puces de Saint-Ouen"@fr ;
  skos:narrower tg:LuxuryShopping ;
  skos:narrower tg:FashionBoutique ;
  skos:narrower tg:BookStore ;
  skos:narrower tg:Market ;
  skos:narrowerTransitive tg:Market, tg:FleaMarket ;
  skos:related tg:Culture ;
  xl:prefLabel tg:ShoppingEnLabel .

tg:Accommodation a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:topConceptOf tg:TourismTopics ;
  skos:prefLabel "Accommodation"@en, "Hébergement"@fr ;
  skos:altLabel "Lodging"@en ;
  skos:altLabel "Hotels"@en ;
  skos:altLabel "Hôtels"@fr ;
  skos:hiddenLabel "accommodation"@en ;
  skos:hiddenLabel "hebergement"@fr ;
  skos:notation "TG-ACC-001"^^xsd:string ;
  skos:notation "A01"^^tg:TopicCode ;
  skos:definition "Places to stay including hotels, hostels, and lodging facilities"@en ;
  skos:scopeNote "Hébergement touristique uniquement, pas résidentiel"@fr ;
  skos:historyNote "Étendu pour inclure auberges de jeunesse en 2026"@fr ;
  skos:example "Ritz Paris, Ibis Budget, Generator Hostel"@fr ;
  skos:narrower tg:LuxuryHotel ;
  skos:narrower tg:BudgetHotel ;
  skos:narrower tg:Hostel ;
  skos:narrowerTransitive tg:LuxuryHotel, tg:BudgetHotel, tg:Hostel ;
  xl:prefLabel tg:AccommodationEnLabel .

#####################
# Culture Hierarchy #
#####################

tg:Museum a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:Culture ;
  skos:broaderTransitive tg:Culture ;
  skos:prefLabel "Museum"@en, "Musée"@fr ;
  skos:altLabel "Musée"@fr, "Museo"@es ;
  skos:altLabel "Cultural Institution"@en ;
  skos:hiddenLabel "musee"@fr ;
  skos:hiddenLabel "museum"@en ;
  skos:notation "TG-MUS-001"^^xsd:string ;
  skos:notation "C02"^^tg:TopicCode ;
  skos:definition "Institution housing collections of artifacts, artworks, and historical objects"@en ;
  skos:definition "Institution abritant des collections d'artefacts, œuvres d'art et objets historiques"@fr ;
  skos:scopeNote "Inclut uniquement musées publics et privés ouverts aux touristes"@fr ;
  skos:historyNote "Catégorie étendue en 2026 pour inclure musées scientifiques"@fr ;
  skos:example "Louvre, Musée d'Orsay, Centre Pompidou"@fr ;
  skos:narrower tg:ArtMuseum ;
  skos:narrower tg:HistoricalMuseum ;
  skos:narrower tg:ScienceMuseum ;
  skos:narrowerTransitive tg:ArtMuseum, tg:HistoricalMuseum, tg:ScienceMuseum .

tg:ArtMuseum a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:Museum ;
  skos:broaderTransitive tg:Museum, tg:Culture ;
  skos:prefLabel "Art Museum"@en, "Musée d'Art"@fr ;
  skos:altLabel "Gallery"@en ;
  skos:altLabel "Galerie d'Art"@fr ;
  skos:hiddenLabel "art gallery"@en ;
  skos:notation "TG-MUS-ART-001"^^xsd:string ;
  skos:definition "Museum specializing in visual arts and artistic works"@en ;
  skos:scopeNote "Art classique, moderne et contemporain"@fr ;
  skos:example "Louvre, Musée d'Orsay, Musée Rodin"@fr ;
  skos:related tg:ModernArt, tg:ClassicalArt .

tg:HistoricalMuseum a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:Museum ;
  skos:prefLabel "History Museum"@en, "Musée d'Histoire"@fr .

tg:ScienceMuseum a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:Museum ;
  skos:prefLabel "Science Museum"@en, "Musée de Science"@fr .

tg:Monument a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:Culture ;
  skos:broaderTransitive tg:Culture ;
  skos:prefLabel "Monument"@en, "Monument"@fr ;
  skos:altLabel "Landmark"@en ;
  skos:altLabel "Historical Monument"@en ;
  skos:altLabel "Monument Historique"@fr ;
  skos:hiddenLabel "monument"@en ;
  skos:notation "TG-MON-001"^^xsd:string ;
  skos:definition "Historic or architectural landmark of cultural significance"@en ;
  skos:definition "Lieu historique ou architectural d'importance culturelle"@fr ;
  skos:scopeNote "Monuments classés ou reconnus patrimoine UNESCO"@fr ;
  skos:historyNote "Critères élargis en 2026 pour inclure architecture moderne"@fr ;
  skos:example "Tour Eiffel, Arc de Triomphe, Notre-Dame"@fr ;
  skos:related tg:Architecture ;
  skos:related tg:Historic ;
  skos:related tg:Photography .

tg:Architecture a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:Culture ;
  skos:prefLabel "Architecture"@en, "Architecture"@fr ;
  skos:related tg:Monument .

tg:ReligiousHeritage a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:Culture ;
  skos:prefLabel "Religious Heritage"@en, "Patrimoine Religieux"@fr .

tg:Church a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:ReligiousHeritage ;
  skos:broaderTransitive tg:ReligiousHeritage, tg:Culture ;
  skos:prefLabel "Church"@en, "Église"@fr ;
  skos:altLabel "Chapel"@en ;
  skos:altLabel "Chapelle"@fr ;
  skos:hiddenLabel "eglise"@fr ;
  skos:hiddenLabel "church"@en ;
  skos:notation "TG-REL-CHU-001"^^xsd:string ;
  skos:definition "Christian place of worship with architectural and historical value"@en ;
  skos:scopeNote "Églises ouvertes aux visiteurs touristiques"@fr ;
  skos:example "Saint-Sulpice, Saint-Étienne-du-Mont, Sainte-Chapelle"@fr ;
  skos:narrower tg:Cathedral ;
  skos:narrowerTransitive tg:Cathedral .

tg:Cathedral a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:Church ;
  skos:broaderTransitive tg:Church, tg:ReligiousHeritage, tg:Culture ;
  skos:prefLabel "Cathedral"@en, "Cathédrale"@fr ;
  skos:altLabel "Basilica"@en ;
  skos:altLabel "Basilique"@fr ;
  skos:hiddenLabel "cathedrale"@fr ;
  skos:hiddenLabel "cathedral"@en ;
  skos:notation "TG-REL-CAT-001"^^xsd:string ;
  skos:definition "Principal church of a diocese, often with significant architectural value"@en ;
  skos:definition "Principale église d'un diocèse, souvent d'importance architecturale majeure"@fr ;
  skos:scopeNote "Cathédrales gothiques et romanes principalement"@fr ;
  skos:historyNote "Catégorie étendue pour inclure basiliques en 2026"@fr ;
  skos:example "Notre-Dame de Paris, Sacré-Cœur"@fr ;
  skos:related tg:Monument ;
  skos:related tg:Historic ;
  skos:related tg:Photography .

tg:ModernArt a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:Culture ;
  skos:prefLabel "Modern Art"@en, "Art Moderne"@fr .

tg:ClassicalArt a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:Culture ;
  skos:prefLabel "Classical Art"@en, "Art Classique"@fr .

tg:Theater a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:Culture ;
  skos:prefLabel "Theater"@en, "Théâtre"@fr .

# Nouveaux concepts culturels identifiés
tg:ArtGallery a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Art Gallery"@en, "Galerie d'Art"@fr ;
  skos:broader tg:Culture ;
  skos:related tg:ModernArt, tg:ClassicalArt .

tg:PerformingArtsVenue a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Performing Arts Venue"@en, "Lieu de Spectacle"@fr ;
  skos:broader tg:Culture ;
  skos:narrower tg:Theater, tg:ConcertHall .

tg:ConcertHall a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Concert Hall"@en, "Salle de Concert"@fr ;
  skos:broader tg:PerformingArtsVenue ;
  skos:related tg:MusicVenue .

tg:EventSpace a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Event Space"@en, "Espace Événementiel"@fr ;
  skos:broader tg:Entertainment ;
  skos:narrower tg:ConventionCenter, tg:Auditorium .

tg:ConventionCenter a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Convention Center"@en, "Centre de Congrès"@fr ;
  skos:broader tg:EventSpace .

tg:Auditorium a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Auditorium"@en, "Auditorium"@fr ;
  skos:broader tg:EventSpace .

tg:MovieTheater a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Movie Theater"@en, "Cinéma"@fr ;
  skos:altLabel "Multiplex"@en, "Cinéma Multiplexe"@fr ;
  skos:broader tg:Cinema .

tg:PublicArt a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Public Art"@en, "Art Public"@fr ;
  skos:broader tg:Culture ;
  skos:related tg:SculptureGarden, tg:Monument .

tg:ReligiousSite a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Religious Site"@en, "Site Religieux"@fr ;
  skos:broader tg:ReligiousHeritage ;
  skos:narrower tg:Mosque, tg:Synagogue, tg:Temple .

tg:Mosque a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Mosque"@en, "Mosquée"@fr ;
  skos:broader tg:ReligiousSite .

tg:Synagogue a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Synagogue"@en, "Synagogue"@fr ;
  skos:broader tg:ReligiousSite .

tg:Temple a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Temple"@en, "Temple"@fr ;
  skos:broader tg:ReligiousSite .

tg:Cemetery a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Cemetery"@en, "Cimetière"@fr ;
  skos:broader tg:Historic ;
  skos:related tg:Culture ;
  skos:example "Père Lachaise, Montparnasse"@fr .

tg:DanceStudio a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Dance Studio"@en, "École de Danse"@fr ;
  skos:broader tg:Culture .

#####################
# Food Hierarchy    #
#####################

tg:FrenchCuisine a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:Food ;
  skos:prefLabel "French Cuisine"@en, "Cuisine Française"@fr ;
  skos:definition "Traditional French culinary heritage"@en .

tg:FineDining a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:Food ;
  skos:prefLabel "Fine Dining"@en, "Haute Gastronomie"@fr ;
  skos:related tg:MichelinStar .

tg:MichelinStar a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:FineDining ;
  skos:prefLabel "Michelin Star"@en, "Étoile Michelin"@fr .

tg:BistroFood a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:Food ;
  skos:prefLabel "Bistro"@en, "Bistrot"@fr .

tg:CafeRestaurant a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:Food ;
  skos:prefLabel "Cafe"@en, "Café"@fr .

tg:FastFood a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Fast Food"@en, "Restauration Rapide"@fr ;
  skos:altLabel "Quick Service Restaurant"@en ;
  skos:broader tg:Food ;
  skos:narrower tg:BurgerJoint, tg:FoodTruck ;
  skos:definition "Quick-service restaurant with counter service"@en ;
  skos:notation "TG-FAST-001"^^xsd:string .

tg:BurgerJoint a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Burger Joint"@en, "Burger"@fr ;
  skos:broader tg:FastFood ;
  skos:definition "Restaurant specializing in hamburgers"@en .

tg:FoodTruck a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Food Truck"@en, "Camion-Restaurant"@fr ;
  skos:broader tg:FastFood ;
  skos:definition "Mobile food service vehicle"@en .

tg:CoffeeConcept a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Coffee Shop"@en, "Café"@fr ;
  skos:broader tg:Food ;
  skos:definition "Establishment specializing in coffee beverages"@en .

tg:Bakery a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Bakery"@en, "Boulangerie"@fr ;
  skos:broader tg:Food ;
  skos:definition "Shop selling bread and pastries"@en .

tg:SandwichPlace a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Sandwich Place"@en, "Sandwicherie"@fr ;
  skos:broader tg:FastFood ;
  skos:definition "Restaurant specializing in sandwiches"@en .

tg:Diner a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:prefLabel "Diner"@en, "Restaurant Américain"@fr ;
  skos:broader tg:Food ;
  skos:definition "Casual American-style restaurant"@en .

tg:StreetFood a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:Food ;
  skos:prefLabel "Street Food"@en, "Cuisine de Rue"@fr .

tg:InternationalCuisine a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:Food ;
  skos:prefLabel "International Cuisine"@en, "Cuisine Internationale"@fr .

tg:ItalianFood a skos:Concept ;
  skos:inScheme tg:TourismTopics ;
  skos:broader tg:InternationalCuisine ;
  skos:prefLabel "Italian"@en, "Italienne"@fr .

